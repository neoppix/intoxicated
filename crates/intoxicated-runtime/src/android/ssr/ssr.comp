#if defined(RT) && !defined(UPSAMPLE)

// How much of a block's last result is kept when its pixel is where it was.
const float HISTORY = 0.6;

void main() {
    camera_from_fit();
    ivec2 b = ivec2(gl_GlobalInvocationID.xy);
    uvec2 hs = half_size();
    if (any(greaterThanEqual(uvec2(b), hs))) {
        return;
    }
    vec4 r = vec4(0.0);
    uint from = leader(b);
    float d = 0.0;
    if (from != NO_PIXEL) {
        ivec2 p = ivec2(from & 0xffffu, from >> 16);
        d = depth_at(p);
        vec3 P = view_pos(vec2(p) + 0.5, d);
        vec3 N = surface_at(p, P).n;
        float wet = N == vec3(0.0) ? 0.0 : wetness(N);
        if (wet > 0.0) {
            r = reflection_rt(p, P, N, wet);
        }
    }
    uint i = uint(b.y) * hs.x + uint(b.x);
    uvec4 last = blocks[i];
    float last_d = uintBitsToFloat(last.w);
    if (from != NO_PIXEL && last.z == from && abs(last_d - d) <= 0.001 * d) {
        vec4 h = vec4(unpackHalf2x16(last.x), unpackHalf2x16(last.y));
        if (!any(isnan(h)) && !any(isinf(h))) {
            r = mix(r, h, HISTORY);
        }
    }
    blocks[i] = uvec4(packHalf2x16(r.rg), packHalf2x16(r.ba), from, floatBitsToUint(d));
}

#else

void main() {
#ifdef UPSAMPLE
    camera_from_fit();
#endif
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(uvec2(p), pc.size))) {
        return;
    }
    vec4 r = vec4(0.0);
    float d = depth_at(p);
    if (d > 0.0) {
        vec3 P = view_pos(vec2(p) + 0.5, d);
        vec3 N = surface_at(p, P).n;
        float wet = N == vec3(0.0) ? 0.0 : wetness(N);
        if (wet > 0.0) {
#ifdef UPSAMPLE
            // The rays of the blocks around that left from this pixel's
            // plane, by a tent over three pixels of distance.
            uvec2 hs = half_size();
            ivec2 b0 = p / 2;
            vec4 sum = vec4(0.0);
            float weights = 0.0;
            for (int j = -1; j <= 1; ++j) {
                for (int i = -1; i <= 1; ++i) {
                    ivec2 b = b0 + ivec2(i, j);
                    if (any(greaterThanEqual(uvec2(b), hs))) {
                        continue;
                    }
                    uvec4 e = blocks[uint(b.y) * hs.x + uint(b.x)];
                    if (e.z == NO_PIXEL) {
                        continue;
                    }
                    ivec2 q = ivec2(e.z & 0xffffu, e.z >> 16);
                    vec3 Q = view_pos(vec2(q) + 0.5, depth_at(q));
                    float off_plane = abs(dot(N, Q - P)) / P.z;
                    float k = (1.0 - smoothstep(0.004, 0.02, off_plane)) * max(1.0 - length(vec2(q - p)) / 3.0, 0.0);
                    if (k > 0.0) {
                        sum += k * vec4(unpackHalf2x16(e.x), unpackHalf2x16(e.y));
                        weights += k;
                    }
                }
            }
            if (weights > 1e-3) {
                r = sum / weights;
            }
#else
            r = reflection(p, P, N, wet);
#endif
        }
    }
    imageStore(trace_img, p, r);
}

