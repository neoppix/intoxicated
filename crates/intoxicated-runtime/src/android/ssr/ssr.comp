// Screen-space reflections on the engine's resolved scene colour (see
// `ssr.rs`), the second and third of three dispatches: `depth.comp` has
// copied the scene depth into `depth_copy`. One invocation per pixel in
// both.
//
// The trace (this file as it is) marches the reflected ray of every wet
// pixel and writes what it found to `trace_img`: the reflected colour
// premultiplied by how strongly it shows (Fresnel, wetness and how sure the
// hit is), so a miss is 0 and a doubtful hit fades instead of cutting out.
//
// The compose (this file with COMPOSE defined) blurs that over nine taps of
// the pixel's own surface, which turns the hard edges, the stair steps and
// the grain of single rays into a soft reflection, blends it into the scene
// colour and writes the pixel, with a reflection blended in or unchanged,
// packed bit for bit in the engine's colour format into a 32-bit image of
// ours that is then copied over the engine's.
//
// Every look is a parameter in the push constant block below, set from the
// INTOXICATED_SSR_* variables and devctl `ssr set` while the game runs;
// nothing about how the reflections look is a constant here, only how the
// edges of a hit fade.
//
// Built by build.rs with the system's glslc when there is one, and
// otherwise taken from the files beside this one, the numbers glslc prints
// wrapped in `&[` and `]`:
//
//     glslc -O --target-env=vulkan1.0 -mfmt=num ssr.comp -o -
//         -> ssr.spv.rs
//     glslc -O --target-env=vulkan1.0 -mfmt=num -DCOMPOSE ssr.comp -o -
//         -> compose.spv.rs
//     glslc -O --target-env=vulkan1.0 -mfmt=num -DRT ssr.comp -o -
//         -> rt_trace.spv.rs
//     glslc -O --target-env=vulkan1.0 -mfmt=num -DRT -DUPSAMPLE ssr.comp -o -
//         -> rt_upsample.spv.rs
//
// A test compiles this file again and compares, whenever glslc is there.
//
// Depth is reversed-Z with the far plane at infinity: depth = near / z, the
// sky is 0. Positions are kept in units of the near plane (z = 1 / depth),
// which is all that is needed: the near plane cancels out of every direction
// and of every projection, and the thickness test and the ray length are
// relative. Inverse depth is affine in screen space, so along a reflected
// ray drawn on the screen it is interpolated linearly, and a ray towards
// infinity ends at its vanishing point with inverse depth 0. For the same
// reason a plane has no second difference of depth across a pixel, which
// is how an edge is told from a surface.

#version 450
#ifdef RT
#extension GL_EXT_nonuniform_qualifier : require
#endif

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D color_tex;
layout(binding = 2, r32f) uniform readonly image2D depth_copy;
#ifdef GIAPPLY
layout(binding = 3, r32ui) uniform uimage2D result_img;
// The upsampled indirect light per pixel, this frame's and the last one's
// in turn (by the frame's parity): red and green, blue and frames as
// halves, the view distance (studs).
layout(std430, set = 1, binding = 25) buffer GiPxA { uvec4 gi_px_a[]; };
layout(std430, set = 1, binding = 26) buffer GiPxB { uvec4 gi_px_b[]; };
// The reflections as the compose read them, then what the glow pass leaves
// for the bloom (see GIAPPLY).
layout(binding = 4, rgba16f) uniform image2D glow_img;
#endif
#ifdef COMPOSE
layout(binding = 3, r32ui) uniform writeonly uimage2D out_img;
layout(binding = 5) uniform sampler2D trace_tex;
#elif !defined(RTEMPORAL) && !defined(RBLUR) && !defined(GIAPPLY)
layout(binding = 4, rgba16f) uniform writeonly image2D trace_img;
#endif

// std430, as push constants are laid out; `ssr::Params` mirrors it.
layout(push_constant) uniform Params {
    uvec2 size;
    // tan of half the horizontal and of half the vertical field of view.
    vec2 tan_half;
    // Wet surfaces are multiplied by tint.rgb (and by 1 - darken).
    vec4 tint;
    // How much of the reflection is blended in, 0 to 1.
    float intensity;
    // Bit 0: only surfaces that face up are wet. Bits 8 to 11: how the
    // engine's format packs a pixel (see `pack`).
    uint flags;
    // Steps along the ray before the binary search.
    uint steps;
    // How far behind the drawn surface a ray may be and still hit it, as a
    // fraction of that surface's distance; hits fade out over the second
    // half of it.
    float thickness;
    // 0: a reflection only as soft as the compose blur; up to 1: blurred,
    // more the further the ray went.
    float roughness;
    // 0: the same strength at every angle, like a mirror; 1: strong only at
    // grazing angles (Schlick, reflectance 0.04 head on).
    float fresnel;
    // The view-space normal's y (towards the top of the screen) at which a
    // surface counts as facing up, faded in over 0.15 either side.
    float up_threshold;
    // How far a ray goes, in multiples of the surface's distance from the
    // camera; 0 to infinity (and the sky).
    float max_distance;
    // Reflections fade out towards the screen edges over this fraction of
    // the smaller side.
    float edge_fade;
    // Wet surfaces are this much darker, 0 to 1.
    float darken;
    // 0: the reflection has the colours of what it reflects; 1: their
    // brightness in the hue of the surface it lies on (water stays blue).
    float keep_colour;
} pc;

const int REFINE_STEPS = 6;
const float UP_SOFTNESS = 0.15;
// A second difference of depth, relative to the depth, above which a pixel
// is on an edge rather than on a surface: hits fade out from LO to HI.
const float EDGE_LO = 0.01;
const float EDGE_HI = 0.05;
// Surfaces seen this close to edge on (the cosine of the view angle) fade
// out: near the horizon one pixel spans a long stretch of the surface and
// its normal, from depth, is no longer to be trusted. Meant for the streaks
// along a sea's horizon, which is INFERRED: Timebomb Duels has no sea.
const float GRAZING_LO = 0.02;
const float GRAZING_HI = 0.08;

float depth_at(ivec2 p) {
    return imageLoad(depth_copy, clamp(p, ivec2(0), ivec2(pc.size) - 1)).r;
}

// View space: x right, y up, z away from the camera.
#ifdef RT
// The camera as `rt/build.comp`'s FIT measured it this frame (set at the
// start of main): tan of the half fields of view, the near plane, the
// world's up in view space; the fov knob and view-space y when it could not.
vec2 g_tan;
float g_near;
vec3 g_up;
bool g_fit;
#define TAN_HALF g_tan
#else
#define TAN_HALF pc.tan_half
#endif

vec3 view_pos(vec2 pixel, float d) {
    vec2 ndc = pixel / vec2(pc.size) * 2.0 - 1.0;
    return vec3(ndc.x * TAN_HALF.x, -ndc.y * TAN_HALF.y, 1.0) / d;
}

// What depth says about one pixel: its normal (zero when a whole axis is
// sky) and how far it is from lying on a plane with its four neighbours.
struct Surface {
    vec3 n;
    float edge;
};

// The normal from the depth of the four neighbours, each axis from the side
// whose depth is closer to this pixel's, so an edge does not bend it; the
// edge measure from the second difference of depth along each axis.
Surface surface_at(ivec2 p, vec3 P) {
    vec2 c = vec2(p) + 0.5;
    float dc = 1.0 / P.z;
    float dl = depth_at(p + ivec2(-1, 0));
    float dr = depth_at(p + ivec2(1, 0));
    float du = depth_at(p + ivec2(0, -1));
    float dd = depth_at(p + ivec2(0, 1));
    float edge = max(abs(dl + dr - 2.0 * dc), abs(du + dd - 2.0 * dc)) / dc;
    if ((dl <= 0.0 && dr <= 0.0) || (du <= 0.0 && dd <= 0.0)) {
        return Surface(vec3(0.0), edge);
    }
    vec3 dx, dy;
    if (dl <= 0.0 || (dr > 0.0 && abs(1.0 / dr - P.z) < abs(1.0 / dl - P.z))) {
        dx = view_pos(c + vec2(1.0, 0.0), dr) - P;
    } else {
        dx = P - view_pos(c - vec2(1.0, 0.0), dl);
    }
    if (du <= 0.0 || (dd > 0.0 && abs(1.0 / dd - P.z) < abs(1.0 / du - P.z))) {
        dy = view_pos(c + vec2(0.0, 1.0), dd) - P;
    } else {
        dy = P - view_pos(c - vec2(0.0, 1.0), du);
    }
    vec3 n = cross(dx, dy);
    float l = length(n);
    if (l <= 0.0) {
        return Surface(vec3(0.0), edge);
    }
    n /= l;
    // Towards the camera.
    return Surface(dot(n, P) > 0.0 ? -n : n, edge);
}

// The normal for the reflection: the depth's, evened out over a ring of
// eight neighbours three pixels away whose surface lies on this one's and
// turns less than 35 degrees from it, so a round surface built of flat
// triangles reflects smoothly while an edge between two faces stays sharp.
vec3 smoothed(ivec2 p, vec3 P, vec3 N) {
    const ivec2 ring[8] = ivec2[8](ivec2(3, 0), ivec2(2, 2), ivec2(0, 3), ivec2(-2, 2),
                                   ivec2(-3, 0), ivec2(-2, -2), ivec2(0, -3), ivec2(2, -2));
    vec3 sum = N;
    for (int i = 0; i < 8; ++i) {
        ivec2 q = p + ring[i];
        float dq = depth_at(q);
        if (dq <= 0.0) {
            continue;
        }
        vec3 Q = view_pos(vec2(q) + 0.5, dq);
        vec3 n = surface_at(q, Q).n;
        if (dot(n, N) > 0.82 && abs(dot(N, Q - P)) < 0.03 * P.z) {
            sum += n;
        }
    }
    return normalize(sum);
}

// How wet the surface is: 1 everywhere, or by how much it faces up.
float wetness(vec3 N) {
    if ((pc.flags & 1u) == 0u) {
        return 1.0;
    }
#ifdef RT
    float up = dot(N, g_up);
#else
    float up = N.y;
#endif
    return smoothstep(pc.up_threshold - UP_SOFTNESS, pc.up_threshold + UP_SOFTNESS, up);
}

#ifdef COMPOSE

// The engine's colour format, bit for bit, as a 32-bit word; a pixel read
// and written back unchanged keeps every bit.
uint pack(vec4 c) {
    c = clamp(c, 0.0, 1.0);
    uint mode = (pc.flags >> 8) & 0xfu;
    if (mode == 2u) {
        return packUnorm4x8(c);          // R8G8B8A8_UNORM
    }
    if (mode == 3u) {
        return packUnorm4x8(c.bgra);     // B8G8R8A8_UNORM
    }
    uvec4 q = uvec4(round(c * vec4(1023.0, 1023.0, 1023.0, 3.0)));
    if (mode == 1u) {
        q = q.bgra;                       // A2R10G10B10_UNORM_PACK32
    }
    return q.r | (q.g << 10) | (q.b << 20) | (q.a << 30); // A2B10G10R10
}

float luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// The trace around pixel `p` (view position P, normal N), over a 3 by 3
// tent of taps spaced 1 to 2.5 pixels apart with roughness, each between
// four texels. A tap counts only as far as its depth lies on this pixel's
// plane, so nothing of a neighbouring object is blurred in. The sum of the
// premultiplied colours and of the strengths, both over the weights.
vec4 gathered(ivec2 p, vec3 P, vec3 N) {
    vec2 inv = 1.0 / vec2(pc.size);
    vec2 c = vec2(p) + 0.5;
    float spacing = 1.0 + 1.5 * pc.roughness;
    float plane = dot(N, P);
    vec4 sum = vec4(0.0);
    float weights = 0.0;
    for (int j = -1; j <= 1; ++j) {
        for (int i = -1; i <= 1; ++i) {
            vec2 at = c + spacing * vec2(i, j);
            float k = (i == 0 ? 2.0 : 1.0) * (j == 0 ? 2.0 : 1.0);
            if (i != 0 || j != 0) {
                // Where this pixel's plane is along the tap's view ray, and
                // where the drawn surface is.
                vec3 ray = view_pos(at, 1.0);
                float along = dot(N, ray);
                float d = depth_at(ivec2(at));
                if (d <= 0.0 || along >= 0.0) {
                    continue;
                }
                float z = 1.0 / d;
                float expected = plane / along;
                k *= 1.0 - smoothstep(0.01, 0.03, abs(z - expected) / expected);
            }
            sum += k * textureLod(trace_tex, at * inv, 0.0);
            weights += k;
        }
    }
    return sum / max(weights, 1e-6);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(uvec2(p), pc.size))) {
        return;
    }
    vec4 base = texelFetch(color_tex, p, 0);
    float d = depth_at(p);
    if (d > 0.0) {
        vec3 P = view_pos(vec2(p) + 0.5, d);
        vec3 N = surface_at(p, P).n;
        float wet = N == vec3(0.0) ? 0.0 : wetness(N);
        // Traced (flags bit 1): the trace has measured the real camera and
        // weighed in the wetness by the world's up; this pass has neither,
        // so any surface may show the trace, and is wet by how strongly it
        // reflects.
        bool traced = (pc.flags & 2u) != 0u;
        vec4 r = vec4(0.0);
        if (traced && N != vec3(0.0)) {
            r = gathered(p, P, N);
            wet = clamp(r.a / max(pc.intensity, 1e-3), 0.0, 1.0);
            // A debug view of the trace's (flags bits 6 and 7) shows as it is.
            if (((pc.flags >> 6) & 3u) != 0u && r.a > 0.5) {
                imageStore(out_img, p, uvec4(pack(vec4(r.rgb / r.a, base.a)), 0u, 0u, 0u));
                return;
            }
        }
        if (wet > 0.0) {
            vec3 own = base.rgb;
            base.rgb *= mix(vec3(1.0), pc.tint.rgb * (1.0 - pc.darken), wet);
            if (!traced) {
                r = gathered(p, P, N);
            }
            if (r.a > 1.0 / 1024.0) {
                vec3 c = r.rgb / r.a;
                vec3 hue = own / max(luma(own), 0.02);
                c = mix(c, luma(c) * hue, pc.keep_colour);
                base.rgb = mix(base.rgb, c, clamp(r.a, 0.0, 1.0));
            }
        }
    }
    imageStore(out_img, p, uvec4(pack(base), 0u, 0u, 0u));
}

#else

// Where a view-space point, or a direction (its point at infinity), lands.
vec2 to_pixel(vec3 v) {
    vec2 ndc = vec2(v.x / (v.z * TAN_HALF.x), -v.y / (v.z * TAN_HALF.y));
    return (ndc * 0.5 + 0.5) * vec2(pc.size);
}

// Which of the four pixels of its 2 by 2 block `p` is, numbered so that
// neighbours differ most: the march's start offset (an eighth, three, five
// or seven eighths of a step) and the angle of the blur taps. The compose's
// 3 by 3 blur always covers all four, so the pattern averages out instead of
// showing as grain, as a different offset for every pixel did.
int cell(ivec2 p) {
    return (p.x & 1) * 2 + ((p.x ^ p.y) & 1);
}

// The scene colour around `at`: one tap, or four on a disc that grows with
// roughness and with how far the ray went, turned by the pixel's cell.
vec3 reflected_color(vec2 at, float pixels, int cell) {
    vec2 inv = 1.0 / vec2(pc.size);
    if (pc.roughness <= 0.0) {
        return textureLod(color_tex, at * inv, 0.0).rgb;
    }
    float radius = min(pc.roughness * (1.0 + 0.06 * pixels), 32.0);
    vec3 c = vec3(0.0);
    for (int i = 0; i < 4; ++i) {
        float a = 0.3926991 * float(cell) + 1.5707963 * float(i);
        float r = radius * (i % 2 == 0 ? 0.5 : 1.0);
        c += textureLod(color_tex, (at + r * vec2(cos(a), sin(a))) * inv, 0.0).rgb;
    }
    return 0.25 * c;
}

// The reflection at pixel `p` (view position P, normal N): its colour
// premultiplied by how much of it to blend in, and that amount.
vec4 reflection(ivec2 p, vec3 P, vec3 N, float wet) {
    vec3 V = normalize(P);
    float cos_v = clamp(dot(-V, N), 0.0, 1.0);
    float schlick = 0.04 + 0.96 * pow(1.0 - cos_v, 5.0);
    float w = pc.intensity * mix(1.0, schlick, pc.fresnel) * wet * smoothstep(GRAZING_LO, GRAZING_HI, cos_v);
    if (w < 1.0 / 1024.0) {
        return vec4(0.0);
    }
    vec3 R = reflect(V, N);
    vec2 s0 = vec2(p) + 0.5;

    // The ray on the screen: to its vanishing point (inverse depth 0) when
    // it goes on for ever, else to where it ends: max_distance, or most of
    // the way to the camera plane for a ray that comes back towards it.
    bool endless = R.z > 1e-4 && pc.max_distance <= 0.0;
    vec2 s1;
    float k0 = 1.0 / P.z, k1;
    if (endless) {
        s1 = to_pixel(R);
        k1 = 0.0;
    } else {
        float len = pc.max_distance > 0.0 ? pc.max_distance * length(P) : 1e4 * P.z;
        if (R.z < -1e-4) {
            len = min(len, 0.9 * P.z / -R.z);
        }
        vec3 E = P + R * len;
        s1 = to_pixel(E);
        k1 = 1.0 / E.z;
    }
    vec2 delta = s1 - s0;
    // Clipped to the screen.
    vec2 lo = vec2(0.5), hi = vec2(pc.size) - 0.5;
    float t_max = 1.0;
    if (delta.x > 0.0) t_max = min(t_max, (hi.x - s0.x) / delta.x);
    if (delta.x < 0.0) t_max = min(t_max, (lo.x - s0.x) / delta.x);
    if (delta.y > 0.0) t_max = min(t_max, (hi.y - s0.y) / delta.y);
    if (delta.y < 0.0) t_max = min(t_max, (lo.y - s0.y) / delta.y);
    if (t_max <= 0.0 || length(delta) * t_max < 3.0) {
        return vec4(0.0);
    }

    // Steps that start two pixels out, so the surface does not hit itself,
    // and grow with the square of their number, so the part of the ray near
    // the surface (contact reflections, the most visible) is sampled finely
    // and the far part coarsely; then a binary search of the step that went
    // behind the drawn depth, the same for every pixel. A crossing more than
    // `thickness` behind it passed behind something, and the march goes on,
    // as it does past the back of a surface. A hit counts in part: less the
    // further behind the surface it is and the closer to an edge of it.
    int k = cell(p);
    float t_start = 2.0 / length(delta);
    float span = t_max - t_start;
    float t_prev = t_start;
    float t_hit = -1.0;
    float sure = 0.0;
    float offset = (float(k) + 0.5) * 0.25;
    for (uint i = 0u; i < pc.steps; ++i) {
        float u = (float(i) + offset) / float(pc.steps);
        float t = t_start + span * u * u;
        float k_ray = mix(k0, k1, t);
        if (depth_at(ivec2(s0 + delta * t)) > k_ray) {
            float a = t_prev, b = t;
            for (int j = 0; j < REFINE_STEPS; ++j) {
                float m = 0.5 * (a + b);
                if (depth_at(ivec2(s0 + delta * m)) > mix(k0, k1, m)) {
                    b = m;
                } else {
                    a = m;
                }
            }
            float kr = mix(k0, k1, b);
            ivec2 q = ivec2(s0 + delta * b);
            float ks = depth_at(q);
            float behind = ks / kr - 1.0;
            if (kr > 0.0 && behind < pc.thickness) {
                // A ray can only meet the front of a surface: one it reaches
                // from behind (water far below a ray that climbs over it, on
                // the screen) is not a hit.
                Surface s = surface_at(q, view_pos(vec2(q) + 0.5, ks));
                if (dot(s.n, R) <= 0.0) {
                    t_hit = b;
                    sure = (1.0 - smoothstep(0.5 * pc.thickness, pc.thickness, behind))
                        * (1.0 - smoothstep(EDGE_LO, EDGE_HI, s.edge));
                    break;
                }
            }
        }
        t_prev = t;
    }

    vec2 at;
    if (t_hit >= 0.0) {
        at = s0 + delta * t_hit;
        // A ray that ends somewhere fades out over the last 40% of it.
        if (!endless) {
            sure *= 1.0 - smoothstep(0.6, 1.0, t_hit);
        }
    } else if (endless && t_max >= 1.0 && depth_at(ivec2(s1)) <= 0.0) {
        // Nothing in the way and the vanishing point is on the screen, in
        // the sky: the reflection is the sky there.
        at = s1;
        sure = 1.0;
    } else {
        return vec4(0.0);
    }

    vec2 margin = min(at, vec2(pc.size) - at) / max(pc.edge_fade * float(min(pc.size.x, pc.size.y)), 1e-3);
    float edge = smoothstep(0.0, 1.0, clamp(min(margin.x, margin.y), 0.0, 1.0));
    float facing = smoothstep(-0.25, 0.05, R.z);
    w = clamp(w * sure * edge * facing, 0.0, 1.0);
    vec3 c = reflected_color(at, length(at - s0), k);
    return vec4(c * w, w);
}

#ifdef RT

// The ray-traced variant (`-DRT`, `rt/trace.rs`): the same surfaces, the
// same strength and the same output as the march above, but the reflected
// ray is traced against the scene's captured triangles (`rt/build.comp`)
// instead of the depth buffer, so it finds what is off screen or hidden
// too: the front of the character seen from behind, the far side of a
// pillar, what the ray meets coming back towards the camera.
//
// Two dispatches. The trace (`-DRT`): one ray per 2 by 2 block of pixels,
// from the block's first pixel that is not sky, into `blocks`. The
// upsample (`-DRT -DUPSAMPLE`): every pixel takes the rays of the 3 by 3
// blocks around it that left from its own surface (their starting point on
// its plane), weighted by how near they are, into `trace_img`, which the
// compose then reads as it reads the march's.
//
// The colour of a hit: the scene colour where the hit is what the screen
// shows there; otherwise (off screen, or behind what the screen shows) the
// colour the hit triangle's vertex shader passed on, the engine's base
// colour of the part without its textures, times the exposure: how much
// brighter the screen is than the bare colours of hits it shows, measured
// over recent frames (see `rt/build.comp`).
//
// The surface is found in the depth buffer and its normal in view space,
// with the projection FIT measured (see `rt/build.comp`); the ray is traced
// in world space, against this frame's triangles and the cached static ones
// that are out of view, so the walls behind the camera are still there when
// it looks down. Each block's result is kept for the next frame and blended
// in again while its pixel stays at the same depth, which steadies it.
//
// The screen colour is taken from a copy of the scene made after its first
// pass (the opaque world), before anything transparent, the interface drawn
// in the world or a billboard is drawn over it (flags bit 2; `ssr.rs`),
// which write no depth and so would pass the depth test. Without such a copy
// this frame, every hit takes its captured colour.

layout(binding = 6) uniform sampler2D opaque_tex;
layout(std430, set = 1, binding = 2) readonly buffer Sorted { uvec2 sorted[]; };
layout(std430, set = 1, binding = 3) readonly buffer Nodes { vec4 nodes[]; };
layout(std430, set = 1, binding = 6) buffer Globals {
    uint leaves;
    uint fit_samples;
    uint fit_ok;
    uint cached;
    vec4 camera;
    vec4 world_up;
    uint lit_screen;
    uint lit_colour;
    float exposure;
    uint frame;
    vec4 cam_pos;
    vec4 right;
    vec4 up;
    vec4 forward;
    uint gen;
    uint dropped;
    uint full;
    uint inserted;
    vec4 last_cam;
    uint cut;
    uint fit_failures;
    uint sky_r;
    uint sky_g;
    uint sky_b;
    uint sky_n;
    vec4 sky;
    uint full_rate;
    // The camera the frame before (FIT copies it before measuring).
    vec4 prev_pos;
    vec4 prev_right;
    vec4 prev_up;
    vec4 prev_forward;
    vec4 prev_camera;
    uint emitters_n;
    // The pixels a side of a block: the reflections' and the indirect
    // light's (`trace.rs`: by the output's width and the time budget).
    uint rscale;
    uint gscale;
    // The indirect light's blocks the frame before (its history's grid).
    uint prev_gscale;
    // How strongly the indirect light's bounces show (`trace.rs` GI_GAIN).
    float gi_gain;
    // Captured triangles (one in 16 counted) whose move is known, and that
    // moved (`rt/build.comp` INSERT, for `rt stats`).
    uint motion_known;
    uint motion_moving;
    // How strongly Neon lights the GI (`trace.rs` NEON_GAIN).
    float neon_gain;
    uint stale_fits;
};
// Each listed triangle's move since the last frame, in studs (w 1 where
// known; `rt/build.comp` INSERT), and per reflection block the move of the
// triangle under its ray's pixel (as halves: x, y; z, known).
layout(std430, set = 1, binding = 23) readonly buffer TriMotion { vec4 tri_motion[]; };
layout(std430, set = 1, binding = 24) buffer BlockMotion { uvec2 block_motion[]; };
// This frame's listed triangles that give off light (`rt/build.comp`).
layout(std430, set = 1, binding = 17) readonly buffer Emitters { uint emitters[]; };
const uint MAX_EMITTERS = 16384u;
// Diffuse indirect light (`INTOXICATED_RT_GI`), per 2 by 2 block, this
// frame's and the last one's in turn (by the frame's parity): two uvec4 a
// block: the light (red and green, blue and frames accumulated, as halves),
// the leader's world position (x, y); its z, its normal packed, 0, 0.
layout(std430, set = 1, binding = 13) buffer GiA { uvec4 gi_a[]; };
layout(std430, set = 1, binding = 14) buffer GiB { uvec4 gi_b[]; };
// The filtered indirect light per block, in turn between the filter's
// passes: red and green, blue and variance, as halves.
layout(std430, set = 1, binding = 15) buffer GiFa { uvec2 gi_fa[]; };
layout(std430, set = 1, binding = 16) buffer GiFb { uvec2 gi_fb[]; };
// The reflections' history per pixel, this frame's and the last one's in
// turn (by the frame's parity): the colour and strength as halves, the
// surface's depth (studs), the hit distance and the frames kept as halves.
layout(std430, set = 1, binding = 18) buffer ReflA { uvec4 refl_a[]; };
layout(std430, set = 1, binding = 19) buffer ReflB { uvec4 refl_b[]; };
// The environment: what the screen showed in each direction where it showed
// sky, kept over frames, octahedral around world up, `ENV_SIZE` squared:
// (red and green, blue and weight as halves, the cache's generation it
// belongs to, 0). A teleport (a new generation) forgets it.
layout(std430, set = 1, binding = 12) buffer Env { uvec4 env[]; };
const uint ENV_SIZE = 256u;

vec2 env_coord(vec3 d) {
    d /= abs(d.x) + abs(d.y) + abs(d.z);
    vec2 e = d.y >= 0.0 ? d.xz : (1.0 - abs(d.zx)) * vec2(d.x >= 0.0 ? 1.0 : -1.0, d.z >= 0.0 ? 1.0 : -1.0);
    return clamp((e * 0.5 + 0.5) * float(ENV_SIZE), vec2(0.0), vec2(float(ENV_SIZE) - 1.0));
}

uint env_texel(vec3 d) {
    uvec2 t = uvec2(env_coord(d));
    return t.y * ENV_SIZE + t.x;
}

// The sky in world direction `d`, as the screen showed it there: a 5 by 5
// Gaussian over the map around it (wider with roughness), counting only
// directions seen as sky, its strength how much of that footprint was seen,
// so the edge of what was seen fades out instead of showing the map's
// texels; nothing (alpha 0) where none of it was: a direction the screen
// never showed sky in may well have a ceiling the game has not drawn.
vec4 environment(vec3 d) {
    // Flags bit 5: the environment is off.
    if ((pc.flags & 32u) != 0u) {
        return vec4(0.0);
    }
    vec2 c = env_coord(d);
    float step_ = 1.0 + 3.0 * pc.roughness;
    vec3 sum = vec3(0.0);
    float seen = 0.0, total = 0.0;
    for (int j = -2; j <= 2; ++j) {
        for (int i = -2; i <= 2; ++i) {
            float k = exp(-0.5 * float(i * i + j * j));
            total += k;
            ivec2 t = ivec2(clamp(c + step_ * vec2(i, j), vec2(0.0), vec2(float(ENV_SIZE) - 1.0)));
            uvec4 e = env[uint(t.y) * ENV_SIZE + uint(t.x)];
            vec2 bw = unpackHalf2x16(e.y);
            if (e.z == gen && bw.y >= 1.0) {
                float w = k * min(bw.y / 4.0, 1.0);
                sum += w * vec3(unpackHalf2x16(e.x), bw.x);
                seen += w;
            }
        }
    }
    if (seen <= 0.0) {
        return vec4(0.0);
    }
    return vec4(sum / seen, smoothstep(0.0, 0.6, seen / total));
}

// Six vec4 a triangle (see `rt/build.comp`).
layout(std430, set = 1, binding = 8) readonly buffer Tris { vec4 tris[]; };
// This frame's base colour textures, and from a texture's serial to its
// place among them: 1024 entries (serial, place + 1), by serial.
layout(set = 2, binding = 0) uniform sampler2D textures[256];
// The engine's per-frame uniform block, as its lit shaders read it (std140;
// see FINDINGS): in vec4s, 15 the sun's colour, 16 the direction its light
// travels, 17 the colour of the light from the other side, 20 (y) the
// exposure, 32 and 33 the ambient, 34 to 45 the ambient by direction (+x,
// -x, +y, -y, +z, -z twice). Flags bit 12 when it is bound.
layout(set = 2, binding = 1, std140) uniform Frame { vec4 frame_block[61]; };
layout(std430, set = 1, binding = 11) readonly buffer TexMap { uvec2 tex_map[]; };
const uint TRI_VEC4 = 6u;
// Per block: the premultiplied colour and strength as four halves, the
// pixel the ray left from (x | y << 16, or ~0 for none).
layout(std430, set = 1, binding = 7) buffer Blocks { uvec4 blocks[]; };

const int STACK = 48;
const uint NO_PIXEL = 0xffffffffu;

void camera_from_fit() {
    g_fit = fit_ok != 0u;
    g_tan = g_fit ? camera.xy : pc.tan_half;
    g_near = camera.z;
    g_up = g_fit ? world_up.xyz : vec3(0.0, 1.0, 0.0);
}

// The pixels a side of this pass's blocks: the indirect light's for its
// passes, the reflections' for the others.
uint grid_scale() {
#if defined(GI) || defined(GIFILTER) || defined(GIAPPLY)
    return clamp(gscale, 1u, 16u);
#else
    return clamp(rscale, 1u, 16u);
#endif
}

// The grid of blocks (named for the 2 by 2 it once always was).
uvec2 half_size() {
    uint s = grid_scale();
    return (pc.size + s - 1u) / s;
}

// View space (near-plane units) to world space (studs), and back.
vec3 world_dir(vec3 d) {
    return d.x * right.xyz + d.y * up.xyz + d.z * forward.xyz;
}

vec3 to_world(vec3 P) {
    return cam_pos.xyz + world_dir(P) * g_near;
}

vec3 to_view_space(vec3 W) {
    vec3 r = W - cam_pos.xyz;
    return vec3(dot(r, right.xyz), dot(r, up.xyz), dot(r, forward.xyz)) / g_near;
}

vec3 tri_world(uint v) {
    return tris[TRI_VEC4 * (v / 3u) + v % 3u].xyz;
}

// The scene colour of the opaque world around `at`, as `reflected_color`
// takes it from the finished scene.
vec3 opaque_color(vec2 at, float pixels, int cell) {
    vec2 inv = 1.0 / vec2(pc.size);
    if (pc.roughness <= 0.0) {
        return textureLod(opaque_tex, at * inv, 0.0).rgb;
    }
    float radius = min(pc.roughness * (1.0 + 0.06 * pixels), 32.0);
    vec3 c = vec3(0.0);
    for (int i = 0; i < 4; ++i) {
        float a = 0.3926991 * float(cell) + 1.5707963 * float(i);
        float r = radius * (i % 2 == 0 ? 0.5 : 1.0);
        c += textureLod(opaque_tex, (at + r * vec2(cos(a), sin(a))) * inv, 0.0).rgb;
    }
    return 0.25 * c;
}

// Moller-Trumbore, both faces: t (or -1) and the barycentrics of B and C.
float hit_triangle(vec3 O, vec3 D, uint tri, float t_min, out vec2 uv) {
    vec3 A = tri_world(3u * tri), B = tri_world(3u * tri + 1u), C = tri_world(3u * tri + 2u);
    vec3 e1 = B - A, e2 = C - A;
    vec3 q = cross(D, e2);
    float det = dot(e1, q);
    uv = vec2(0.0);
    if (abs(det) < 1e-20) {
        return -1.0;
    }
    float inv = 1.0 / det;
    vec3 s = O - A;
    float u = dot(s, q) * inv;
    if (u < 0.0 || u > 1.0) {
        return -1.0;
    }
    vec3 r = cross(s, e1);
    float v = dot(D, r) * inv;
    if (v < 0.0 || u + v > 1.0) {
        return -1.0;
    }
    uv = vec2(u, v);
    float t = dot(e2, r) * inv;
    return t > t_min ? t : -1.0;
}

// Entry distance into a box, or a value above `best` for a miss.
float hit_box(vec3 O, vec3 inv_d, vec3 lo, vec3 hi, float best) {
    vec3 a = (lo - O) * inv_d, b = (hi - O) * inv_d;
    vec3 near = min(a, b), far = max(a, b);
    float t0 = max(max(near.x, near.y), max(near.z, 0.0));
    float t1 = min(min(far.x, far.y), far.z);
    return t0 <= t1 && t0 < best ? t0 : 3.4e38;
}

// The nearest hit along O + t D for t in (t_min, t_max): t, the triangle
// and the barycentrics there, or t = -1.
float trace_ray(vec3 O, vec3 D, float t_min, float t_max, out uint tri_hit, out vec2 uv_hit) {
    tri_hit = 0u;
    uv_hit = vec2(0.0);
    uint m = leaves;
    float best = t_max;
    bool found = false;
    vec2 uv;
    if (m == 0u) {
        return -1.0;
    }
    if (m == 1u) {
        tri_hit = sorted[0].y;
        float t = hit_triangle(O, D, tri_hit, t_min, uv_hit);
        return t > 0.0 && t < best ? t : -1.0;
    }
    vec3 inv_d = 1.0 / mix(D, vec3(1e-30), equal(D, vec3(0.0)));
    int stack[STACK];
    int sp = 0;
    int node = 0;
    for (int guard = 0; guard < 4096; ++guard) {
        vec4 l0 = nodes[4 * node], l1 = nodes[4 * node + 1];
        vec4 r0 = nodes[4 * node + 2], r1 = nodes[4 * node + 3];
        int left = floatBitsToInt(l0.w), right = floatBitsToInt(r0.w);
        float tl = hit_box(O, inv_d, l0.xyz, l1.xyz, best);
        float tr = hit_box(O, inv_d, r0.xyz, r1.xyz, best);
        int next_node = -1;
        // Leaves are tested at once; nodes are visited nearer first.
        if (tl < best && left < 0) {
            uint tri = sorted[~left].y;
            float t = hit_triangle(O, D, tri, t_min, uv);
            if (t > 0.0 && t < best) {
                best = t;
                tri_hit = tri;
                uv_hit = uv;
                found = true;
            }
            tl = 3.4e38;
        }
        if (tr < best && right < 0) {
            uint tri = sorted[~right].y;
            float t = hit_triangle(O, D, tri, t_min, uv);
            if (t > 0.0 && t < best) {
                best = t;
                tri_hit = tri;
                uv_hit = uv;
                found = true;
            }
            tr = 3.4e38;
        }
        bool go_l = tl < best, go_r = tr < best;
        if (go_l && go_r) {
            int far_node = tl <= tr ? right : left;
            next_node = tl <= tr ? left : right;
            if (sp < STACK) {
                stack[sp++] = far_node;
            }
        } else if (go_l) {
            next_node = left;
        } else if (go_r) {
            next_node = right;
        }
        if (next_node < 0) {
            if (sp == 0) {
                break;
            }
            next_node = stack[--sp];
        }
        node = next_node;
    }
    return found ? best : -1.0;
}

// The place of texture `serial` among this frame's, or -1.
int texture_place(uint serial) {
    for (uint i = 0u; i < 4u; ++i) {
        uvec2 e = tex_map[(serial + i) & 1023u];
        if (e.x == serial) {
            return int(e.y) - 1;
        }
        if (e.x == 0u) {
            break;
        }
    }
    return -1;
}

// The hit triangle's own colour at the hit, as the engine's fragment shader
// makes its base colour: the colour its vertex shader passed on,
// interpolated, times its texture where it has one this frame (all three
// channels, or a grey detail texture's one twice over). The engine's
// fragment shaders take it as gamma-encoded (they square it, light in
// linear and take the square root at the end), so as it is, it is the
// part's colour under a light of 1. `t` is the ray's length, in studs, for
// the texture's level of detail.
vec3 hit_colour(uint tri, vec2 uv, float t) {
    uint at = TRI_VEC4 * tri;
    vec3 ca = unpackUnorm4x8(floatBitsToUint(tris[at].w)).rgb;
    vec3 cb = unpackUnorm4x8(floatBitsToUint(tris[at + 1u].w)).rgb;
    vec3 cc = unpackUnorm4x8(floatBitsToUint(tris[at + 2u].w)).rgb;
    vec3 bary = vec3(1.0 - uv.x - uv.y, uv.x, uv.y);
    vec3 c = ca * bary.x + cb * bary.y + cc * bary.z;
    vec4 t01 = tris[at + 3u], t2 = tris[at + 4u];
    uint code = floatBitsToUint(t2.z);
    uint mode = code >> 30;
    if (mode == 1u || mode == 2u) {
        int place = texture_place(code & 0x3fffffffu);
        vec2 st = t01.xy * bary.x + t01.zw * bary.y + t2.xy * bary.z;
        if (place >= 0 && !any(isnan(st)) && !any(isinf(st))) {
            float lod = clamp(log2(max(t, 1.0)) - 1.0, 0.0, 8.0);
            vec4 tex = textureLod(textures[nonuniformEXT(place)], st, lod);
            c *= mode == 1u ? tex.rgb : vec3(2.0 * tex.x);
        }
    }
    return any(isnan(c)) ? vec3(0.5) : clamp(c, 0.0, 1.0);
}

const float NORMAL_REACH = 48.0;
// Pixels a frame that may trace their own ray (see the upsample).
const uint FULL_RATE_MAX = 65536u;

// The pixel's own triangle's normal, from the normals the engine's vertex
// shader gave its corners, at the point a ray from the camera meets it:
// smooth where the engine shades smoothly. N (the depth's) where the ray
// meets no triangle at the depth's distance, the triangle carries no
// normals, or they turn more than 60 degrees from N.
// The texture mode (`capture::MODE_*`) of the triangle `rt_normal` found
// under the pixel, 0 where it found none: 3 is terrain, which is rough
// (grass, sand, rock) and reflects nothing.
uint g_own_mode = 0u;
// Whether the pixel's surface is captured geometry: false where the ray
// from the camera finds no triangle at its depth within NORMAL_REACH (the
// engine's decoration grass, particles: things that sway or change every
// frame); true beyond it, where it is not looked for.
bool g_own_found = true;
// The move since the last frame of the triangle `rt_normal` found (w 1
// where known; 0 where it found none or its move is not known).
vec4 g_own_motion = vec4(0.0);

vec3 rt_normal(vec3 P, vec3 N) {
    g_own_mode = 0u;
    g_own_found = true;
    g_own_motion = vec4(0.0);
    float dist = length(P) * g_near;
    // Further away a triangle covers a few pixels and the evened-out normal
    // is as good, for no ray.
    if (dist > NORMAL_REACH) {
        return N;
    }
    vec3 D = normalize(world_dir(P));
    uint tri;
    vec2 uv;
    // Only around the depth's distance: a captured triangle nearer than the
    // pixel is not what it shows (zoomed into first person the camera is
    // inside the character's own head, which the engine hides but the
    // capture still has), and stopping there made every pixel within
    // NORMAL_REACH look uncaptured, so the GI left them all dark.
    float t = trace_ray(cam_pos.xyz, D, max(0.5 * g_near, 0.95 * dist), dist * 1.03, tri, uv);
    if (t < 0.0 || abs(t - dist) > 0.015 * dist) {
        g_own_found = false;
        return N;
    }
    g_own_mode = floatBitsToUint(tris[TRI_VEC4 * tri + 4u].z) >> 30;
    g_own_motion = tri_motion[tri];
    if (any(isnan(g_own_motion)) || any(isinf(g_own_motion))) {
        g_own_motion = vec4(0.0);
    }
    uvec4 packed = floatBitsToUint(tris[TRI_VEC4 * tri + 5u]);
    if ((packed.w & 1u) == 0u) {
        return N;
    }
    vec3 n = unpackSnorm4x8(packed.x).xyz * (1.0 - uv.x - uv.y) + unpackSnorm4x8(packed.y).xyz * uv.x
        + unpackSnorm4x8(packed.z).xyz * uv.y;
    if (dot(n, n) < 1e-6) {
        return N;
    }
    n = normalize(vec3(dot(n, right.xyz), dot(n, up.xyz), dot(n, forward.xyz)));
    n = dot(n, P) > 0.0 ? -n : n;
    return dot(n, N) > 0.5 ? n : N;
}

// The hit triangle's normal in the world at the hit, facing the ray's
// start: its vertex normals interpolated where it has them, else its own.
vec3 hit_normal(uint tri, vec2 uv, vec3 dir) {
    uvec4 packed = floatBitsToUint(tris[TRI_VEC4 * tri + 5u]);
    vec3 n;
    if ((packed.w & 1u) != 0u) {
        n = unpackSnorm4x8(packed.x).xyz * (1.0 - uv.x - uv.y) + unpackSnorm4x8(packed.y).xyz * uv.x
            + unpackSnorm4x8(packed.z).xyz * uv.y;
    } else {
        vec3 A = tri_world(3u * tri), B = tri_world(3u * tri + 1u), C = tri_world(3u * tri + 2u);
        n = cross(B - A, C - A);
    }
    n = dot(n, n) > 1e-12 ? normalize(n) : -dir;
    return dot(n, dir) > 0.0 ? -n : n;
}

// The engine's ambient light for a world normal (see `Frame`).
vec3 engine_ambient(vec3 n) {
    vec3 pos = n * n * vec3(greaterThanEqual(n, vec3(0.0)));
    vec3 neg = n * n - pos;
    vec3 ambient = frame_block[32].xyz + frame_block[33].xyz;
    for (int i = 0; i < 3; ++i) {
        ambient += (frame_block[40 + 2 * i].xyz + frame_block[34 + 2 * i].xyz) * pos[i]
            + (frame_block[41 + 2 * i].xyz + frame_block[35 + 2 * i].xyz) * neg[i];
    }
    return ambient;
}

uint hash(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

// The light a traced triangle gives off at a point of colour `c` (as
// gamma-encoded as the engine's shaders take it), linear before the
// exposure, as the engine's Neon shader makes it: scale * pow(c * gain,
// power), packed with its triangle (`spirv::Emission::packed`); 0 for one
// that gives off none.
vec3 emission_of(uint tri, vec3 c) {
    uint e = floatBitsToUint(tris[TRI_VEC4 * tri + 4u].w);
    if ((e >> 24) == 0u) {
        return vec3(0.0);
    }
    vec3 k = unpackUnorm4x8(e).xyz * vec3(4.0, 8.0, 16.0);
    return k.z * pow(max(c * k.x, vec3(0.0)), vec3(k.y));
}

bool emits(uint tri) {
    return (floatBitsToUint(tris[TRI_VEC4 * tri + 4u].w) >> 24) != 0u;
}

// The light the listed Neon triangles give a point X with normal n (world),
// in the GI's units (the cosine-weighted average of the light coming in):
// eight of them picked at random, one of those by what it would give
// (resampled importance sampling), not checked for whether it is in view
// (see the end). 0 where there are none.
// Neon as a light: a quarter of its drawn brightness, falling off faster
// than the square of the distance beyond NEON_NEAR studs, so a panel lights
// the wall and floor beside it strongly while a street of lit windows does
// not wash everything out.
const float NEON_LIGHT = 0.25;
const float NEON_NEAR = 12.0;
// The indirect light is held to GI_MOST times the engine's ambient plus
// GI_MOST_ADD (a stray sample cannot wash a wall out; a Neon glow stays).
const float GI_MOST = 8.0;
const float GI_MOST_ADD = 4.0;
// Neon's exact light in the GI is taken `neon_gain` times its engine
// brightness (`trace.rs` NEON_GAIN, devctl `rt neon-gain`).

// The indirect light `gi` held with a soft knee: what it brings above the
// ambient `amb` rolls off towards GI_MOST times the ambient plus
// GI_MOST_ADD instead of cutting at it, so a strong glow stays a glow and
// stops short of white.
vec3 gi_held(vec3 gi, vec3 amb) {
    vec3 top = GI_MOST * amb + vec3(GI_MOST_ADD) - amb;
    vec3 extra = max(gi - amb, vec3(0.0));
    return min(gi, amb) + extra / (vec3(1.0) + extra / max(top, vec3(1e-3)));
}

vec3 emitter_light(vec3 X, vec3 n, uint seed) {
    uint count = min(emitters_n, MAX_EMITTERS);
    if (count == 0u) {
        return vec3(0.0);
    }
    const int M = 8;
    float wsum = 0.0, chosen_p = 0.0;
    vec3 chosen_f = vec3(0.0), chosen_y = vec3(0.0);
    uint pick = hash(seed ^ 0x5bd1e995u);
    for (int c = 0; c < M; ++c) {
        uint h = hash(seed + uint(c) * 0x9e3779b9u);
        uint tri = emitters[h % count];
        uint h2 = hash(h);
        float r1 = float(h2 & 0xffffu) / 65536.0, r2 = float(h2 >> 16) / 65536.0;
        float s1 = sqrt(r1);
        vec3 bary = vec3(1.0 - s1, s1 * (1.0 - r2), s1 * r2);
        vec3 A = tri_world(3u * tri), B = tri_world(3u * tri + 1u), C = tri_world(3u * tri + 2u);
        vec3 Y = A * bary.x + B * bary.y + C * bary.z;
        vec3 e = cross(B - A, C - A);
        float area2 = length(e);
        vec3 d = Y - X;
        float d2 = dot(d, d);
        if (area2 < 1e-8 || d2 < 1e-6) {
            continue;
        }
        vec3 dir = d * inversesqrt(d2);
        float cos_x = dot(n, dir);
        float cos_y = abs(dot(e / area2, dir));
        if (cos_x <= 0.0) {
            continue;
        }
        uint at = TRI_VEC4 * tri;
        vec3 col = unpackUnorm4x8(floatBitsToUint(tris[at].w)).rgb * bary.x
            + unpackUnorm4x8(floatBitsToUint(tris[at + 1u].w)).rgb * bary.y
            + unpackUnorm4x8(floatBitsToUint(tris[at + 2u].w)).rgb * bary.z;
        // Over pi, from the uniform point's density, 1 / (count * area);
        // the distance kept from going below two studs. NEON_LIGHT: the
        // engine draws Neon far brighter than the screen can show (13 times
        // white for a white part), and lights nothing with it; taken at
        // full strength as a light it would flood a street of lit windows.
        vec3 f = NEON_LIGHT * emission_of(tri, col) * cos_x * cos_y * (0.5 * area2) * float(count) / (3.14159265 * max(d2, 1.0))
            / (1.0 + d2 / (NEON_NEAR * NEON_NEAR));
        float p_hat = dot(f, vec3(0.2126, 0.7152, 0.0722));
        if (!(p_hat > 0.0) || isinf(p_hat)) {
            continue;
        }
        wsum += p_hat;
        if (float(hash(pick + uint(c)) & 0xffffu) / 65536.0 * wsum < p_hat) {
            chosen_f = f;
            chosen_p = p_hat;
            chosen_y = Y;
        }
    }
    if (chosen_p <= 0.0) {
        return vec3(0.0);
    }
    // No ray for whether it is in sight: this lights reflected hits the
    // screen does not show, where the GI has no light to give, and a ray
    // here cost the reflections at 3440x1440 0.7 to 2 ms (Jailbreak's
    // city, measured); a Neon part behind a wall so lights it in the
    // reflections, within NEON_NEAR studs or so.
    return min(chosen_f / chosen_p * (wsum / float(M)), vec3(4.0));
}

// Per screen tile of LIGHT_TILE pixels a side, the Neon triangles that light
// it most (`-DRT -DLIGHTS`): LIGHTS_PER_TILE entries of two words, the
// triangle's index with bit 31 set where a ray from the tile's middle
// reaches it (or ~0 for none) and a hash of where its middle is (to know it
// again the next frame); this frame's half and the last one's in turn (by
// the frame's parity).
layout(std430, set = 1, binding = 20) buffer Tiles { uvec2 tiles[]; };
const int LIGHT_TILE = 16;
const int LIGHTS_PER_TILE = 8;
const uint NO_LIGHT = 0xffffffffu;

uvec2 light_tiles() {
    return (pc.size + uint(LIGHT_TILE) - 1u) / uint(LIGHT_TILE);
}

// Where this frame's (or, `last`, the last frame's) half of `tiles` starts.
uint tiles_half(bool last) {
    uvec2 lt = light_tiles();
    return (((frame & 1u) != 0u) != last ? 1u : 0u) * lt.x * lt.y * uint(LIGHTS_PER_TILE);
}

// The Neon triangle's colour at its middle.
vec3 emitter_colour(uint tri) {
    uint at = TRI_VEC4 * tri;
    return (unpackUnorm4x8(floatBitsToUint(tris[at].w)).rgb + unpackUnorm4x8(floatBitsToUint(tris[at + 1u].w)).rgb
        + unpackUnorm4x8(floatBitsToUint(tris[at + 2u].w)).rgb) / 3.0;
}

// The light a Neon triangle gives a point X with normal n, exactly, in the
// GI's units (the cosine-weighted average of the light coming in): its
// radiance, at the engine's full Neon brightness, times its form factor
// (Lambert's polygon formula: the sum over its edges of the angle each
// spans times the normal's share of that edge's plane, over 2 pi). Smooth,
// no samples, no noise.
vec3 polygon_light(uint tri, vec3 X, vec3 n) {
    vec3 v[3];
    for (uint k = 0u; k < 3u; ++k) {
        vec3 d = tri_world(3u * tri + k) - X;
        float l = length(d);
        if (l < 1e-4) {
            return vec3(0.0);
        }
        v[k] = d / l;
    }
    float sum = 0.0;
    for (int k = 0; k < 3; ++k) {
        vec3 a = v[k], b = v[(k + 1) % 3];
        vec3 c = cross(a, b);
        float lc = length(c);
        if (lc < 1e-6) {
            continue;
        }
        sum += acos(clamp(dot(a, b), -1.0, 1.0)) * dot(n, c / lc);
    }
    // The winding decides the sign; a triangle behind the surface (both
    // signs cancel only partly) is left out where it lies below it.
    float ff = abs(sum) / 6.2831853;
    vec3 mid = (tri_world(3u * tri) + tri_world(3u * tri + 1u) + tri_world(3u * tri + 2u)) / 3.0;
    if (dot(mid - X, n) <= 0.0) {
        return vec3(0.0);
    }
    return emission_of(tri, emitter_colour(tri)) * min(ff, 1.0);
}

// All the Neon light the tile around pixel `at` lists, at X with normal n.
vec3 tile_light(uvec2 at, vec3 X, vec3 n) {
    uvec2 lt = light_tiles();
    uvec2 t = min(at / uint(LIGHT_TILE), lt - 1u);
    uint base = tiles_half(false) + (t.y * lt.x + t.x) * uint(LIGHTS_PER_TILE);
    vec3 sum = vec3(0.0);
    for (int k = 0; k < LIGHTS_PER_TILE; ++k) {
        uint e = tiles[base + uint(k)].x;
        if (e == NO_LIGHT) {
            break;
        }
        if ((e >> 31) != 0u) {
            sum += polygon_light(e & 0x7fffffffu, X, n);
        }
    }
    return sum;
}

// The filtered indirect light at pixel `at` (GIFILTER's last pass, on the
// indirect light's grid), or -1 in x where there is none this frame (flags
// bit 14: GI ran first).
vec3 gi_at(uvec2 at) {
    if ((pc.flags & 16384u) == 0u) {
        return vec3(-1.0);
    }
    uint s = clamp(gscale, 1u, 16u);
    uvec2 gs = (pc.size + s - 1u) / s;
    uvec2 hb = min(at / s, gs - 1u);
    uvec2 f = gi_fa[hb.y * gs.x + hb.x];
    if (f == uvec2(0u)) {
        return vec3(-1.0);
    }
    vec3 L = vec3(unpackHalf2x16(f.x), unpackHalf2x16(f.y).x);
    return any(isnan(L)) || any(isinf(L)) ? vec3(-1.0) : L;
}

// The cache of static triangles (`rt/build.comp`): the light each one was
// seen to give off (GI's `S_EMIT`), terrain's colour (`learn_colour`).
layout(std430, set = 1, binding = 9) buffer Slots { uint slots[]; };
const uint SLOT_WORDS = 32u;
const uint S_COL = 17u;

// A surface of colour `c` (gamma-encoded, as the engine's shaders take it)
// at world point `Hw` with normal `n`, lit as the engine's shaders light it,
// in linear before the exposure: the colour squared times ambient, the sun
// where a ray towards it is free, and the light from the other side.
// How far a ray towards the sun looks for what shades a hit (studs), and
// how far a reflection ray goes before it takes the sky: past them the
// cache holds nothing (it traces within 512 studs) and the long rays cost
// most at 3440x1440.
const float SHADOW_REACH = 512.0;
const float REFLECT_REACH = 1024.0;

vec3 lit_linear(vec3 c, vec3 n, vec3 Hw) {
    vec3 to_sun = -frame_block[16].xyz;
    float sun = max(dot(n, to_sun), 0.0);
    if (sun > 0.0) {
        uint st;
        vec2 su;
        if (trace_ray(Hw + n * 0.05, normalize(to_sun), 0.01, SHADOW_REACH, st, su) > 0.0) {
            sun = 0.0;
        }
    }
    vec3 light = engine_ambient(n) + frame_block[15].xyz * sun + frame_block[17].xyz * max(-dot(n, to_sun), 0.0);
    return c * c * light;
}

// A cached terrain triangle's slot (+1), or 0: terrain passes on no colour
// (`capture::MODE_TERRAIN`), so it takes the colour the screen shows it in.
uint terrain_slot(uint tri) {
    if ((floatBitsToUint(tris[TRI_VEC4 * tri + 4u].z) >> 30) != 3u) {
        return 0u;
    }
    return floatBitsToUint(tris[TRI_VEC4 * tri + 5u].w) >> 1;
}

// Where the screen shows a terrain triangle's point (normal n, world Hw) in
// `screen` (gamma-encoded, through the exposure): its base colour, as the
// light the engine's sun and ambient give there explains it, blended into
// its slot's colour (all three corners alike), so reflections and the GI
// show terrain in its colours, in view or not.
void learn_colour(uint slot, vec3 screen, vec3 n, vec3 Hw) {
    float exposure_ = max(frame_block[20].y, 1e-3);
    vec3 light = lit_linear(vec3(1.0), n, Hw);
    vec3 c = sqrt(clamp(screen * screen / exposure_ / max(light, vec3(0.02)), 0.0, 1.0));
    uint at = (slot - 1u) * SLOT_WORDS + S_COL;
    vec3 old = unpackUnorm4x8(slots[at]).rgb;
    uint v = packUnorm4x8(vec4(mix(old, c, 0.1), 1.0));
    slots[at] = v;
    slots[at + 1u] = v;
    slots[at + 2u] = v;
}

// The last reflection ray's hit distance (studs; far for none).
float g_hit_t = 60000.0;

vec4 reflection_rt(ivec2 p, vec3 P, vec3 N, float wet) {
    g_hit_t = 60000.0;
    vec3 V = normalize(P);
    float cos_v = clamp(dot(-V, N), 0.0, 1.0);
    float schlick = 0.04 + 0.96 * pow(1.0 - cos_v, 5.0);
    float w = pc.intensity * mix(1.0, schlick, pc.fresnel) * wet * smoothstep(GRAZING_LO, GRAZING_HI, cos_v);
    if ((w < 1.0 / 1024.0 && ((pc.flags >> 6) & 3u) != 3u) || !g_fit) {
        return vec4(0.0);
    }
    bool category = ((pc.flags >> 6) & 3u) == 3u;
    if (category) {
        w = 1.0;
    }
    vec3 R = reflect(V, N);
    bool opaque = (pc.flags & 4u) != 0u;
    // Off the surface a little, so the ray does not find the triangle the
    // pixel lies on; the depth it came from is only so precise. In world
    // space, studs.
    vec3 O = to_world(P + N * (0.002 * P.z));
    vec3 Rw = normalize(world_dir(R));
    float scale = g_near;
    float t_max = pc.max_distance > 0.0 ? min(pc.max_distance * length(P) * scale, REFLECT_REACH) : REFLECT_REACH;
    uint tri;
    vec2 uv;
    float t = trace_ray(O, Rw, 0.002 * P.z * scale, t_max, tri, uv);
    g_hit_t = t > 0.0 ? t : 60000.0;
    int k = cell(p);
    if (category) {
        // Flags bits 6 and 7 at 3: what the ray hit, by kind: yellow a Neon
        // part, green terrain, white a part that stays in place (cached),
        // grey one that moves (characters, vehicles), dark blue nothing.
        if (t < 0.0) {
            return vec4(0.05, 0.05, 0.3, 1.0);
        }
        bool cached_ = (floatBitsToUint(tris[TRI_VEC4 * tri + 5u].w) >> 1) != 0u;
        vec3 kind = emits(tri) ? vec3(1.0, 0.9, 0.0)
            : (floatBitsToUint(tris[TRI_VEC4 * tri + 4u].z) >> 30) == 3u ? vec3(0.1, 0.8, 0.1)
            : cached_ ? vec3(0.9) : vec3(0.45);
        return vec4(kind, 1.0);
    }
    if (t < 0.0) {
        // Nothing in the way: the sky, where its vanishing point is on the
        // screen and the screen shows sky there.
        // Nothing in the way: the sky in that direction, where the screen
        // shows it now (the ray's vanishing point on the screen, through an
        // opening), else as the screen showed it before.
        if (opaque && R.z > 1e-4) {
            vec2 s1 = to_pixel(R);
            if (all(greaterThanEqual(s1, vec2(0.5))) && all(lessThan(s1, vec2(pc.size) - 0.5)) && depth_at(ivec2(s1)) <= 0.0) {
                return vec4(opaque_color(s1, length(s1 - vec2(p)), k) * w, w);
            }
        }
        vec4 env = environment(Rw);
        return vec4(env.rgb * w * env.a, w * env.a);
    }
    vec3 H = to_view_space(O + Rw * t);
    vec3 own = hit_colour(tri, uv, t);
    // The screen's colour of the hit, where the screen shows it, and how
    // sure that is: fading out over the last 4% of the screen towards its
    // edges and as the depth there moves away from the hit's, so the two
    // colours meet without a seam.
    vec3 screen = vec3(0.0);
    float on_screen = 0.0;
    vec2 at = vec2(-1.0);
    if (opaque && H.z > 1e-3) {
        at = to_pixel(H);
        if (all(greaterThanEqual(at, vec2(0.5))) && all(lessThan(at, vec2(pc.size) - 0.5))) {
            float ds = depth_at(ivec2(at));
            float zs = ds > 0.0 ? 1.0 / ds : 3.0e38;
            float gap = abs(H.z - zs) / H.z;
            vec2 margin = min(at, vec2(pc.size) - at) / (0.04 * float(min(pc.size.x, pc.size.y)));
            on_screen = (1.0 - smoothstep(0.01, 0.03, gap)) * smoothstep(0.0, 1.0, clamp(min(margin.x, margin.y), 0.0, 1.0));
            if (on_screen > 0.0) {
                screen = opaque_color(at, length(at - vec2(p)), k);
            }
        }
    }
    if (on_screen > 0.99) {
        uint ts = terrain_slot(tri);
        if (ts != 0u && ((uint(p.x * 7 + p.y * 13) + frame) & 31u) == 0u) {
            learn_colour(ts, textureLod(opaque_tex, at / vec2(pc.size), 0.0).rgb, hit_normal(tri, uv, Rw), O + Rw * t);
        }
        // A sample of what the engine's light makes of the bare colour.
        if ((((p.x >> 1) ^ (p.y >> 1)) & 7) == 0) {
            const vec3 L = vec3(0.2126, 0.7152, 0.0722);
            atomicAdd(lit_screen, uint(dot(clamp(screen, 0.0, 1.0), L) * 256.0));
            atomicAdd(lit_colour, uint(dot(own, L) * 256.0));
        }
    }
    // The indirect light where the hit is, where the screen shows it: the
    // GI's (flags bit 14, computed before the reflections), so a wall a
    // Neon part lights shows so in them too.
    vec3 Hw = O + Rw * t;
    vec3 gi = vec3(-1.0);
    if (on_screen > 0.5) {
        gi = gi_at(uvec2(at));
    }
    if (emits(tri)) {
        // A Neon part: the light it gives off, as the engine draws it, and
        // kept above white (the trace image holds halves): even a few
        // percent of reflection at a steep angle shows it glowing, where a
        // white of 1 would leave it dull grey. Held to 16 before the
        // exposure's square root.
        own = sqrt(clamp(emission_of(tri, own) * frame_block[20].y, 0.0, 16.0));
    } else if ((pc.flags & 12288u) == 12288u) {
        // Lit (flags bit 13, with the engine's light bound, bit 12; bits 8
        // to 11 are the colour format's): the hit's
        // colour lit as the engine's shaders light it, in linear (the
        // colour squared), with the sun where a ray towards it is free, and
        // back through the engine's exposure and square root; with the
        // indirect light in place of the engine's ambient where the GI
        // has it, else the Neon parts' light added.
        vec3 n = hit_normal(tri, uv, Rw);
        vec3 lin = lit_linear(own, n, Hw);
        vec3 albedo = own * own;
        // Only with the indirect light on (flags bit 14): without it the
        // reflections show what the engine's light alone makes, as the
        // screen does.
        vec3 amb = engine_ambient(n);
        if (gi.x >= 0.0) {
            lin = max(lin + albedo * (gi_held(gi, amb) - amb), 0.5 * lin);
        } else if ((pc.flags & 16384u) != 0u) {
            lin += albedo * min(emitter_light(Hw + n * 0.02, n, hash(uint(p.x) * 7919u + uint(p.y) * 104729u + frame * 31u)), GI_MOST * amb + vec3(GI_MOST_ADD));
        }
        own = sqrt(clamp(lin * frame_block[20].y, 0.0, 1.0));
    } else {
        own *= exposure > 0.0 ? exposure : 1.0;
    }
    // Flags bit 3: the screen's colour wherever it shows the hit (the first
    // way, kept to compare); bit 4: a quarter of it; neither: the hit's own
    // colour only, so a reflection shows the side of a thing it faces.
    float screen_share = (pc.flags & 8u) != 0u ? 1.0 : (pc.flags & 16u) != 0u ? 0.25 : 0.0;
    if (screen_share > 0.0 && gi.x >= 0.0 && (pc.flags & 4096u) != 0u) {
        // The screen's colour with the GI's light, as the apply gives it.
        float exposure_ = max(frame_block[20].y, 1e-3);
        vec3 n = hit_normal(tri, uv, Rw);
        vec3 lin = screen * screen / exposure_;
        vec3 ambient = engine_ambient(n);
        vec3 to_sun = -frame_block[16].xyz;
        vec3 light = ambient + frame_block[15].xyz * max(dot(n, to_sun), 0.0) + frame_block[17].xyz * max(-dot(n, to_sun), 0.0);
        lin = max(lin + lin / max(light, vec3(0.02)) * (gi_held(gi, ambient) - ambient), 0.5 * lin);
        screen = sqrt(clamp(lin * exposure_, 0.0, 1.0));
    }
    vec3 c = mix(own, screen, screen_share * on_screen);
    float sure = 1.0;
    // A ray that ends somewhere fades out over the last 40% of it.
    if (pc.max_distance > 0.0) {
        sure *= 1.0 - smoothstep(0.6, 1.0, t / t_max);
    }
    w = clamp(w * sure, 0.0, 1.0);
    return vec4(c * w, w);
}

// Which normal a pixel's ray left with: 0 the depth's, 1 the depth's evened
// out over its neighbours, 2 its triangle's vertex normals. Set by
// `surface_normal`.
float g_source;

// The normal a reflecting pixel's ray leaves with: its triangle's vertex
// normals where found, else the depth's evened out (see `smoothed`).
vec3 surface_normal(ivec2 p, vec3 P, vec3 N) {
    vec3 s = smoothed(p, P, N);
    vec3 n = rt_normal(P, s);
    g_source = n != s ? 2.0 : (dot(s, N) < 0.9999 ? 1.0 : 0.0);
    return n;
}

// Flags bits 6 and 7: a debug view in place of the reflection: 1 the normal
// (x, y, z as red, green, blue), 2 where it came from (red the depth's,
// yellow evened out, green the vertex normals).
vec4 debug_view(vec3 n) {
    uint view = (pc.flags >> 6) & 3u;
    if (view == 1u) {
        return vec4(n * 0.5 + 0.5, 1.0);
    }
    return vec4(g_source > 1.5 ? vec3(0.0, 1.0, 0.0) : g_source > 0.5 ? vec3(1.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0), 1.0);
}

// The pixel of block `b` (s by s pixels) its ray leaves from: the first of
// its middle, then its corners, that is on the screen and not sky.
uint leader(ivec2 b) {
    int s = int(grid_scale());
    int m = s / 2, e = s - 1;
#if !defined(GI) && !defined(GIFILTER) && !defined(GIAPPLY)
    // The reflections' rays leave from a different pixel of the block each
    // frame (a Halton walk over it), so their history (RTEMPORAL) covers
    // the whole block and edges come out smooth.
    if ((pc.flags & 65536u) != 0u) {
        uint k = frame % uint(s * s);
        uint hx = 0u, hy = 0u;
        // Bit-reversed order over the block's cells.
        uint r = bitfieldReverse(k) >> (32u - uint(max(findMSB(uint(s * s - 1)) + 1, 1)));
        r = r < uint(s * s) ? r : k;
        hx = r % uint(s);
        hy = r / uint(s);
        ivec2 q = s * b + ivec2(hx, hy);
        if (all(lessThan(uvec2(q), pc.size)) && depth_at(q) > 0.0) {
            return uint(q.x) | (uint(q.y) << 16);
        }
    }
#endif
#if defined(GI)
    // The indirect light's points move over their block from frame to
    // frame too (an R2 sequence), so its history and the per-pixel one of
    // the apply average a block edge out instead of showing it as a step.
    if (s > 1) {
        vec2 r2 = fract(vec2(0.5) + float(frame % 4096u) * vec2(0.7548777, 0.5698403));
        ivec2 q = s * b + min(ivec2(r2 * float(s)), ivec2(e));
        if (all(lessThan(uvec2(q), pc.size)) && depth_at(q) > 0.0) {
            return uint(q.x) | (uint(q.y) << 16);
        }
    }
#endif
    ivec2 order[5] = ivec2[5](ivec2(m, m), ivec2(0, 0), ivec2(e, e), ivec2(e, 0), ivec2(0, e));
    for (int i = 0; i < 5; ++i) {
        ivec2 q = s * b + order[i];
        if (all(lessThan(uvec2(q), pc.size)) && depth_at(q) > 0.0) {
            return uint(q.x) | (uint(q.y) << 16);
        }
    }
    return NO_PIXEL;
}

#endif

#if defined(RT) && defined(ENVMAP)

// The environment pass (`-DRT -DENVMAP`): a quarter of the pixels each
// frame, in turn; where the opaque copy shows sky, its colour into the
// environment at that world direction, blended over what was there.
void main() {
    camera_from_fit();
    if (!g_fit || (pc.flags & 4u) == 0u || (pc.flags & 32u) != 0u) {
        return;
    }
    ivec2 p = 2 * ivec2(gl_GlobalInvocationID.xy) + ivec2(frame & 1u, (frame >> 1) & 1u);
    if (any(greaterThanEqual(uvec2(p), pc.size)) || depth_at(p) > 0.0) {
        return;
    }
    vec3 c = texelFetch(opaque_tex, p, 0).rgb;
    vec3 d = normalize(world_dir(view_pos(vec2(p) + 0.5, 1.0)));
    uint t = env_texel(d);
    uvec4 e = env[t];
    vec2 bw = unpackHalf2x16(e.y);
    float w = e.z == gen ? bw.y : 0.0;
    vec3 now = w > 0.0 ? mix(vec3(unpackHalf2x16(e.x), bw.x), c, 0.1) : c;
    env[t] = uvec4(packHalf2x16(now.rg), packHalf2x16(vec2(now.b, min(w + 1.0, 1000.0))), gen, 0u);
    if (((p.x ^ p.y) & 15) == 0) {
        atomicAdd(sky_r, uint(clamp(c.r, 0.0, 1.0) * 256.0));
        atomicAdd(sky_g, uint(clamp(c.g, 0.0, 1.0) * 256.0));
        atomicAdd(sky_b, uint(clamp(c.b, 0.0, 1.0) * 256.0));
        atomicAdd(sky_n, 1u);
    }
}

#elif defined(RT) && defined(GI)

const uint S_EMIT = 31u;
// Light a cached triangle gives off beyond what the engine's sun and
// ambient light on it explain, kept as a quarter in 8 bits a channel.
const float EMIT_SCALE = 4.0;

// The GI pass (`-DRT -DGI`), per block of the indirect light's grid (from
// its leader pixel), every other frame in a checkerboard (otherwise it keeps
// what it had): a hybrid of screen space and the traced scene.
//
// Screen space first, with a visibility bitmask (after Therrien, Levesque
// and Gilet, "Screen Space Indirect Lighting with Visibility Bitmask",
// 2023): SS_SLICES slices around the view direction, each marched
// SS_STEPS samples out on both sides along the screen; each sample's
// surface is taken as a slab SS_THICKNESS deep behind what depth shows, and
// the angles its front and back span over the pixel's horizon mark the
// sectors of the slice it hides, out of 32 (spaced evenly in the sine of the
// angle from the normal, so each sector counts the same towards the cosine
// weighted light). A sample's screen colour (the opaque copy, back to linear
// through the exposure) lights the sectors it is first to hide. So nearby
// walls, floors and lit panels light the pixel from the screen, with their
// textures and the engine's own lights, and what is behind them stays
// hidden.
//
// What no sample hid (the ray left the screen, or went past everything)
// continues through the traced scene: one ray, its direction in a sector
// left open (a slice picked by how much it left open and its weight), its
// hit lit as the engine lights it (the screen's colour where the screen
// shows it) or the sky, weighted by the share left open. Neon light comes
// in exactly from the tile's lights (`tile_light`), not from either.
//
// Then accumulated over frames at the same place in the world (the leader's
// point found in the last frame's view on that frame's grid, which may be
// coarser or finer: the history carries over a change of the grid), into
// this frame's buffer.
const int SS_SLICES = 2;
const int SS_STEPS = 6;
// How far the march reaches (studs), and how deep a surface is taken to be
// (studs, plus 2% of its distance).
const float SS_RADIUS = 12.0;
const float SS_THICKNESS = 0.75;
const float PI = 3.14159265;

// The sectors from a to b (0 to 1).
uint sectors(float a, float b) {
    uint i0 = uint(clamp(floor(a * 32.0), 0.0, 32.0));
    uint i1 = uint(clamp(ceil(b * 32.0), 0.0, 32.0));
    if (i1 <= i0) {
        return 0u;
    }
    uint n = i1 - i0;
    return n >= 32u ? 0xffffffffu : ((1u << n) - 1u) << i0;
}

// A direction's place in a slice (V towards the camera, `ortho` along the
// screen direction, `gamma` the projected normal's angle from V): the sine
// of its angle from the normal, mapped to 0 to 1.
float sector_of(vec3 w, vec3 V, vec3 ortho, float gamma) {
    float a = atan(dot(w, ortho), dot(w, V)) - gamma;
    return 0.5 + 0.5 * sin(clamp(a, -0.5 * PI, 0.5 * PI));
}

void main() {
    camera_from_fit();
    ivec2 b = ivec2(gl_GlobalInvocationID.xy);
    uvec2 hs = half_size();
    if (any(greaterThanEqual(uvec2(b), hs)) || !g_fit) {
        return;
    }
    uint i = uint(b.y) * hs.x + uint(b.x);
    bool odd = (frame & 1u) != 0u;
    uint from = leader(b);
    if (from == NO_PIXEL) {
        if (odd) { gi_b[2u * i] = uvec4(0u); } else { gi_a[2u * i] = uvec4(0u); }
        return;
    }
    ivec2 p = ivec2(from & 0xffffu, from >> 16);
    vec3 P = view_pos(vec2(p) + 0.5, depth_at(p));
    vec3 N = surface_at(p, P).n;
    if (N == vec3(0.0)) {
        if (odd) { gi_b[2u * i] = uvec4(0u); } else { gi_a[2u * i] = uvec4(0u); }
        return;
    }
    vec3 nv = surface_normal(p, P, N);
    if (!g_own_found) {
        // Not captured (the engine's swaying decoration grass): no
        // indirect light there, which would change with every frame.
        if (odd) { gi_b[2u * i] = uvec4(0u); } else { gi_a[2u * i] = uvec4(0u); }
        return;
    }
    vec3 n = normalize(world_dir(nv));
    vec3 X = to_world(P);
    float dist = length(P) * g_near;
    // The last frame's light at this point, on the last frame's grid:
    // where the point was then (moved back by its triangle's move where
    // known: a character, a car), a short history while it moves.
    vec3 Xp = X - (g_own_motion.w > 0.0 ? g_own_motion.xyz : vec3(0.0));
    bool moving = g_own_motion.w > 0.0 && dot(g_own_motion.xyz, g_own_motion.xyz) > 1e-4;
    vec3 r = Xp - prev_pos.xyz;
    vec3 v = vec3(dot(r, prev_right.xyz), dot(r, prev_up.xyz), dot(r, prev_forward.xyz));
    float frames = 0.0;
    vec3 old = vec3(0.0);
    vec2 moments_old = vec2(0.0);
    if (prev_camera.w > 0.0 && v.z > 0.0) {
        uint ps = clamp(prev_gscale, 1u, 16u);
        uvec2 phs = (pc.size + ps - 1u) / ps;
        vec2 ndc = vec2(v.x / (v.z * prev_camera.x), -v.y / (v.z * prev_camera.y));
        ivec2 q = ivec2(floor((ndc * 0.5 + 0.5) * vec2(pc.size))) / int(ps);
        if (all(greaterThanEqual(q, ivec2(0))) && all(lessThan(uvec2(q), phs))) {
            uint j = uint(q.y) * phs.x + uint(q.x);
            uvec4 e0 = odd ? gi_a[2u * j] : gi_b[2u * j];
            uvec4 e1 = odd ? gi_a[2u * j + 1u] : gi_b[2u * j + 1u];
            vec3 Y = uintBitsToFloat(uvec3(e0.zw, e1.x));
            vec3 m = unpackSnorm4x8(e1.y).xyz;
            vec2 bn = unpackHalf2x16(e0.y);
            vec3 o = vec3(unpackHalf2x16(e0.x), bn.x);
            vec2 mo = unpackHalf2x16(e1.z);
            // The same point within its block's reach on that grid.
            // The same surface within a block and a half on either grid (the
            // points move over their block), on the point's plane.
            float pix_ = dist * 2.0 * g_tan.y / float(pc.size.y);
            float reach_ = 0.02 * dist + 0.05 + 1.5 * float(max(ps, grid_scale())) * pix_;
            float plane_ = abs(dot(n, Xp - Y));
            if (bn.y > 0.0 && distance(Xp, Y) < reach_ && plane_ < 0.01 * dist + 0.05 && dot(m, n) > 0.9
                && !any(isnan(o)) && !any(isinf(o)) && !any(isnan(mo)) && !any(isinf(mo))) {
                frames = moving ? min(bn.y, 4.0) : bn.y;
                old = o;
                moments_old = mo;
            }
        }
    }
    vec3 acc = old;
    vec2 moments = moments_old;
    if (frames < 1.0 || ((uint(b.x + b.y) + frame) & 1u) == 0u) {
    float exposure_ = max(frame_block[20].y, 1e-3);
    uint h = hash(i * 9781u + frame * 6271u);
    float jitter = float(h & 0xffffu) / 65536.0;
    float rot = float(h >> 16) / 65536.0;
    // The march in view space (near-plane units).
    vec3 V = -normalize(P);
    float radius_px = clamp(SS_RADIUS / max(dist, 1e-3) / g_tan.y * 0.5 * float(pc.size.y), 6.0, 0.35 * float(pc.size.y));
    float thick = (SS_THICKNESS + 0.02 * dist) / g_near;
    vec2 inv = 1.0 / vec2(pc.size);
    vec3 screen_sum = vec3(0.0);
    float weight_sum = 0.0;
    float open_w[SS_SLICES];
    uint open_bits[SS_SLICES];
    float gammas[SS_SLICES];
    vec3 orthos[SS_SLICES];
    float open_total = 0.0;
    for (int sl = 0; sl < SS_SLICES; ++sl) {
        open_w[sl] = 0.0;
        open_bits[sl] = 0u;
        float phi = PI * (float(sl) + rot) / float(SS_SLICES);
        vec2 d2 = vec2(cos(phi), sin(phi));
        vec3 dirv = vec3(d2.x, -d2.y, 0.0);
        vec3 ortho = dirv - dot(dirv, V) * V;
        if (dot(ortho, ortho) < 1e-8) {
            continue;
        }
        ortho = normalize(ortho);
        vec3 axis = cross(ortho, V);
        vec3 pn = nv - dot(nv, axis) * axis;
        float pl = length(pn);
        if (pl < 1e-3) {
            continue;
        }
        float gamma = atan(dot(pn, ortho), dot(pn, V));
        uint occ = 0u;
        vec3 lit = vec3(0.0);
        for (int side = 0; side < 2; ++side) {
            vec2 dir2 = side == 0 ? d2 : -d2;
            for (int k = 0; k < SS_STEPS; ++k) {
                float f = (float(k) + jitter) / float(SS_STEPS);
                vec2 at = vec2(p) + 0.5 + dir2 * (1.0 + f * f * radius_px);
                if (any(lessThan(at, vec2(0.0))) || any(greaterThanEqual(at, vec2(pc.size)))) {
                    break;
                }
                ivec2 q = ivec2(at);
                float dq = depth_at(q);
                if (dq <= 0.0) {
                    continue;
                }
                vec3 S = view_pos(vec2(q) + 0.5, dq);
                vec3 Sb = S + normalize(S) * thick;
                vec3 wf = S - P, wb = Sb - P;
                if (dot(wf, wf) < 1e-12) {
                    continue;
                }
                float uf = sector_of(normalize(wf), V, ortho, gamma);
                float ub = sector_of(normalize(wb), V, ortho, gamma);
                uint bits = sectors(min(uf, ub), max(uf, ub));
                uint fresh = bits & ~occ;
                if (fresh != 0u) {
                    vec3 c = textureLod(opaque_tex, (vec2(q) + 0.5) * inv, 0.0).rgb;
                    lit += gi_gain * c * c / exposure_ * float(bitCount(fresh));
                }
                occ |= bits;
            }
        }
        screen_sum += pl * lit / 32.0;
        weight_sum += pl;
        open_bits[sl] = ~occ;
        open_w[sl] = pl * float(bitCount(~occ)) / 32.0;
        open_total += open_w[sl];
        gammas[sl] = gamma;
        orthos[sl] = ortho;
    }
    vec3 L = weight_sum > 0.0 ? screen_sum / weight_sum : vec3(0.0);
    vec3 Xo = X + n * (0.002 * dist + 0.02);
    if (open_total > 0.0 && weight_sum > 0.0) {
        // One ray into what the screen left open: a slice by its open
        // weight, a sector among its open ones, a place within it.
        uint h2 = hash(h ^ 0x68bc21ebu);
        float pick = float(h2 & 0xffffu) / 65536.0 * open_total;
        int sl = 0;
        for (int k = 0; k < SS_SLICES - 1; ++k) {
            if (pick < open_w[k]) {
                break;
            }
            pick -= open_w[k];
            sl = k + 1;
        }
        uint bits = open_bits[sl];
        int count_ = bitCount(bits);
        int nth = int(min(uint(float(h2 >> 16) / 65536.0 * float(count_)), uint(max(count_ - 1, 0))));
        uint rest = bits;
        for (int k = 0; k < nth; ++k) {
            rest &= rest - 1u;
        }
        int sector = findLSB(rest);
        float u = (float(sector) + float(hash(h2) & 0xffffu) / 65536.0) / 32.0;
        float a = asin(clamp(2.0 * u - 1.0, -1.0, 1.0)) + gammas[sl];
        vec3 dv = cos(a) * V + sin(a) * orthos[sl];
        vec3 dir = normalize(world_dir(dv));
        if (dot(dir, n) < 0.02) {
            dir = normalize(dir + n * (0.02 - dot(dir, n)));
        }
        uint tri;
        vec2 uv;
        float t = trace_ray(Xo, dir, 0.01, 1024.0, tri, uv);
        vec3 Lr;
        if (t > 0.0 && emits(tri)) {
            // A Neon part: its light comes in through `tile_light` instead
            // (counted once).
            Lr = vec3(0.0);
        } else if (t > 0.0) {
            vec3 Hw = Xo + dir * t;
            // A cached triangle's slot (`rt/build.comp` keeps it in the
            // normal word's upper bits), for the light it gives off.
            uint slot = floatBitsToUint(tris[TRI_VEC4 * tri + 5u].w) >> 1;
            // Where the screen shows the hit, its light there, with
            // everything the engine lit it with (its lamps, a neon part's
            // glow); what that has beyond the engine's sun and ambient is
            // learnt into the triangle's slot, so it still gives off light
            // out of view.
            bool shown = false;
            vec3 H = to_view_space(Hw);
            if ((pc.flags & 4u) != 0u && H.z > 1e-3) {
                vec2 at = to_pixel(H);
                if (all(greaterThanEqual(at, vec2(0.5))) && all(lessThan(at, vec2(pc.size) - 0.5))) {
                    float ds = depth_at(ivec2(at));
                    if (ds > 0.0 && abs(H.z - 1.0 / ds) < 0.02 * H.z) {
                        vec3 c = textureLod(opaque_tex, at * inv, 0.0).rgb;
                        Lr = gi_gain * c * c / exposure_;
                        shown = true;
                        uint ts = terrain_slot(tri);
                        if (ts != 0u && ((i + frame) & 15u) == 0u) {
                            learn_colour(ts, c, hit_normal(tri, uv, dir), Hw);
                        }
                        if (slot != 0u) {
                            vec3 lit = lit_linear(hit_colour(tri, uv, t), hit_normal(tri, uv, dir), Hw);
                            uint at_ = (slot - 1u) * SLOT_WORDS + S_EMIT;
                            vec3 e = unpackUnorm4x8(slots[at_]).rgb * EMIT_SCALE;
                            vec3 extra = max(c * c / exposure_ - lit, vec3(0.0));
                            // Only a clear excess counts, else nothing.
                            vec3 target = dot(extra, vec3(1.0)) > 0.5 * dot(lit, vec3(1.0)) + 0.05 ? extra : vec3(0.0);
                            slots[at_] = packUnorm4x8(vec4(mix(e, target, 0.25) / EMIT_SCALE, 0.0));
                        }
                    }
                }
            }
            if (!shown) {
                Lr = lit_linear(hit_colour(tri, uv, t), hit_normal(tri, uv, dir), Hw);
                if (slot != 0u) {
                    Lr += unpackUnorm4x8(slots[(slot - 1u) * SLOT_WORDS + S_EMIT]).rgb * EMIT_SCALE;
                }
                Lr *= gi_gain;
            }
        } else {
            // Open sky: the engine's own ambient from that side. The sky's
            // colour on the screen is far brighter than the light the
            // engine gives with it, and taken as light it washed every
            // open place out (the city's roads, Jailbreak).
            Lr = engine_ambient(dir);
        }
        L += min(Lr, vec3(32.0)) * (open_total / weight_sum);
    }
    // The Neon parts' light, exactly, from the ones the tile lists (the
    // LIGHTS pass), in view or not.
    L += neon_gain * tile_light(uvec2(p), Xo, n);
    L = min(L, vec3(32.0));
    // Accumulated over up to 32 frames, with the first two moments of its
    // brightness for the filter's variance. A sample far outside what the
    // history's moments allow (the light changed) halves the history, so it
    // follows sooner (history clamping, by its weight).
    float l = dot(L, vec3(0.2126, 0.7152, 0.0722));
    if (frames >= 4.0) {
        float sd = sqrt(max(moments_old.y - moments_old.x * moments_old.x, 0.0));
        if (abs(l - moments_old.x) > 4.0 * sd + 0.1 * moments_old.x + 0.02) {
            frames = max(0.5 * frames, 1.0);
        }
    }
    frames = min(frames + 1.0, 32.0);
    acc = mix(old, L, 1.0 / frames);
    moments = mix(moments_old, vec2(l, l * l), 1.0 / frames);
    }
    acc = min(acc, vec3(64.0));
    uvec4 o0 = uvec4(packHalf2x16(acc.rg), packHalf2x16(vec2(acc.b, frames)), floatBitsToUint(X.xy));
    uvec4 o1 = uvec4(floatBitsToUint(X.z), packSnorm4x8(vec4(n, 0.0)), packHalf2x16(moments), 0u);
    if (odd) {
        gi_b[2u * i] = o0;
        gi_b[2u * i + 1u] = o1;
    } else {
        gi_a[2u * i] = o0;
        gi_a[2u * i + 1u] = o1;
    }
}

#elif defined(RT) && defined(LIGHTS)

// The light list pass (`-DRT -DLIGHTS`), per screen tile: from the tile's
// middle pixel's surface, Neon triangles weighed by what they give there
// (their brightness times their area times the two cosines over the squared
// distance), the LIGHTS_PER_TILE strongest kept, each with whether a ray
// from the surface reaches its middle. The GI pass then takes their light
// exactly (`tile_light`). Candidates: every listed Neon triangle up to
// LIGHT_CANDIDATES of them, else that many spread over the list from a
// place that changes every frame; and the ones the tile's surface chose the
// frame before (found through the last frame's camera), recognised by where
// their middle is and weighed LIGHT_KEEP times up, so a choice holds from
// frame to frame and a tile does not switch between two near equal lights
// (temporal reuse of the choices, as in ReSTIR, but keeping the strongest
// rather than resampling: the light is summed exactly, not estimated).
const uint LIGHT_CANDIDATES = 512u;
const float LIGHT_KEEP = 1.5;
// A kept choice's ray is cast again one frame in LIGHT_RECHECK, in turn.
const uint LIGHT_RECHECK = 4u;

uint centre_hash_at(vec3 mid) {
    uvec3 q = uvec3(ivec3(round(mid * 8.0)));
    return hash(q.x ^ hash(q.y ^ hash(q.z))) | 1u;
}

vec3 centre_of(uint tri) {
    return (tri_world(3u * tri) + tri_world(3u * tri + 1u) + tri_world(3u * tri + 2u)) / 3.0;
}

// The emitters a workgroup weighs, 64 at a time, read once for its 64
// tiles: middle and brightness (luma of its light), the normal and half
// the area, the triangle and its hash.
shared vec4 sh_mid[64];
shared vec4 sh_nrm[64];
shared uvec2 sh_id[64];

// Neon triangles farther than this (studs) are not chosen: their light is
// faint, and their long sight rays were most of this pass's time.
const float LIGHT_REACH = 128.0;

float score_of(vec4 mp, vec4 na, vec3 X, vec3 n) {
    vec3 dv = mp.xyz - X;
    float d2 = max(dot(dv, dv), 0.25);
    if (d2 > LIGHT_REACH * LIGHT_REACH) {
        return 0.0;
    }
    vec3 dir = dv * inversesqrt(d2);
    float cx = dot(n, dir);
    if (cx <= 0.0) {
        return 0.0;
    }
    return mp.w * na.w * cx * max(abs(dot(na.xyz, dir)), 0.1) / d2;
}

vec4 power_of(uint tri, out vec4 na) {
    vec3 A = tri_world(3u * tri), B = tri_world(3u * tri + 1u), C = tri_world(3u * tri + 2u);
    vec3 e = cross(B - A, C - A);
    float area2 = length(e);
    na = area2 < 1e-8 ? vec4(0.0) : vec4(e / area2, 0.5 * area2);
    return vec4((A + B + C) / 3.0, dot(emission_of(tri, emitter_colour(tri)), vec3(0.2126, 0.7152, 0.0722)));
}

uint best[LIGHTS_PER_TILE];
uint best_hash[LIGHTS_PER_TILE];
// 0: not known whether in view; 1 in view; 2 not, as the last frame found.
uint best_seen[LIGHTS_PER_TILE];
float score[LIGHTS_PER_TILE];

void consider(uint tri, uint h, uint seen, float s) {
    if (!(s > score[LIGHTS_PER_TILE - 1])) {
        return;
    }
    for (int k = 0; k < LIGHTS_PER_TILE; ++k) {
        if (best[k] == tri) {
            return;
        }
    }
    // Into the sorted list, the weakest falling off its end.
    int k = LIGHTS_PER_TILE - 1;
    while (k > 0 && score[k - 1] < s) {
        score[k] = score[k - 1];
        best[k] = best[k - 1];
        best_hash[k] = best_hash[k - 1];
        best_seen[k] = best_seen[k - 1];
        --k;
    }
    score[k] = s;
    best[k] = tri;
    best_hash[k] = h;
    best_seen[k] = seen;
}

// The second dispatch (`steps` 1), one invocation per tile and choice: the
// rays, which one invocation per tile cast too slowly one after another
// (eight long rays each, too few invocations to hide their latency: 1.5 to
// 2.8 ms in Jailbreak's city, measured). A choice whose hash word has bit 0
// clear wants its ray (new, or its turn to be checked again).
void cast_rays() {
    uvec2 lt = light_tiles();
    uvec2 t = uvec2(gl_GlobalInvocationID.x / uint(LIGHTS_PER_TILE), gl_GlobalInvocationID.y);
    uint k = gl_GlobalInvocationID.x % uint(LIGHTS_PER_TILE);
    if (any(greaterThanEqual(t, lt)) || !g_fit) {
        return;
    }
    uint at = tiles_half(false) + (t.y * lt.x + t.x) * uint(LIGHTS_PER_TILE) + k;
    uvec2 e = tiles[at];
    if (e.x == NO_LIGHT || (e.y & 1u) != 0u) {
        return;
    }
    ivec2 p = min(ivec2(t) * LIGHT_TILE + LIGHT_TILE / 2, ivec2(pc.size) - 1);
    float d = depth_at(p);
    bool seen = false;
    if (d > 0.0) {
        vec3 P = view_pos(vec2(p) + 0.5, d);
        vec3 N = surface_at(p, P).n;
        if (N != vec3(0.0)) {
            vec3 n = normalize(world_dir(N));
            vec3 X = to_world(P) + n * (0.002 * length(P) * g_near + 0.02);
            vec3 mid = centre_of(e.x & 0x7fffffffu);
            float len = distance(mid, X);
            uint st;
            vec2 su;
            seen = trace_ray(X, (mid - X) / max(len, 1e-4), 0.01, len * 0.97, st, su) < 0.0;
        }
    }
    tiles[at] = uvec2((e.x & 0x7fffffffu) | (seen ? 0x80000000u : 0u), e.y | 1u);
}

void main() {
    camera_from_fit();
    if (pc.steps == 1u) {
        cast_rays();
        return;
    }
    uvec2 t = gl_GlobalInvocationID.xy;
    uvec2 lt = light_tiles();
    bool inside = all(lessThan(t, lt));
    for (int k = 0; k < LIGHTS_PER_TILE; ++k) {
        best[k] = NO_LIGHT;
        best_hash[k] = 0u;
        best_seen[k] = 0u;
        score[k] = 0.0;
    }
    ivec2 p = min(ivec2(t) * LIGHT_TILE + LIGHT_TILE / 2, ivec2(pc.size) - 1);
    float d = inside ? depth_at(p) : 0.0;
    uint count = min(emitters_n, MAX_EMITTERS);
    vec3 X = vec3(0.0), n = vec3(0.0);
    bool lit_here = false;
    if (d > 0.0 && g_fit && count > 0u) {
        vec3 P = view_pos(vec2(p) + 0.5, d);
        vec3 N = surface_at(p, P).n;
        if (N != vec3(0.0)) {
            lit_here = true;
            n = normalize(world_dir(N));
            X = to_world(P) + n * (0.002 * length(P) * g_near + 0.02);
            // The last frame's choices for this surface point.
            vec3 r = X - prev_pos.xyz;
            vec3 v = vec3(dot(r, prev_right.xyz), dot(r, prev_up.xyz), dot(r, prev_forward.xyz));
            if (prev_camera.w > 0.0 && v.z > 0.0) {
                vec2 ndc = vec2(v.x / (v.z * prev_camera.x), -v.y / (v.z * prev_camera.y));
                ivec2 q = ivec2(floor((ndc * 0.5 + 0.5) * vec2(pc.size))) / LIGHT_TILE;
                if (all(greaterThanEqual(q, ivec2(0))) && all(lessThan(uvec2(q), lt))) {
                    uint old = tiles_half(true) + (uint(q.y) * lt.x + uint(q.x)) * uint(LIGHTS_PER_TILE);
                    for (int k = 0; k < LIGHTS_PER_TILE; ++k) {
                        uvec2 e = tiles[old + uint(k)];
                        if (e.x == NO_LIGHT) {
                            break;
                        }
                        uint tri = e.x & 0x7fffffffu;
                        if (emits(tri)) {
                            vec4 na;
                            vec4 mp = power_of(tri, na);
                            if (centre_hash_at(mp.xyz) == e.y) {
                                consider(tri, e.y, (e.x >> 31) != 0u ? 1u : 2u, LIGHT_KEEP * score_of(mp, na, X, n));
                            }
                        }
                    }
                }
            }
        }
    }
    // Every listed Neon triangle up to LIGHT_CANDIDATES, else that many
    // spread over the list from a place that changes every frame; 64 at a
    // time into shared memory, weighed by every tile of the workgroup.
    uint take = min(count, LIGHT_CANDIDATES);
    uint stride = max(count / max(take, 1u), 1u);
    uint start = count > LIGHT_CANDIDATES ? hash(frame * 7919u) % count : 0u;
    for (uint at = 0u; at < take; at += 64u) {
        uint i = at + gl_LocalInvocationIndex;
        if (i < take) {
            uint tri = emitters[(start + i * stride) % count];
            vec4 na;
            vec4 mp = power_of(tri, na);
            sh_mid[gl_LocalInvocationIndex] = mp;
            sh_nrm[gl_LocalInvocationIndex] = na;
            sh_id[gl_LocalInvocationIndex] = uvec2(tri, centre_hash_at(mp.xyz));
        }
        barrier();
        if (lit_here) {
            uint m = min(64u, take - at);
            for (uint j = 0u; j < m; ++j) {
                float s = score_of(sh_mid[j], sh_nrm[j], X, n);
                if (s > score[LIGHTS_PER_TILE - 1]) {
                    consider(sh_id[j].x, sh_id[j].y, 0u, s);
                }
            }
        }
        barrier();
    }
    if (!inside) {
        return;
    }
    uint base = tiles_half(false) + (t.y * lt.x + t.x) * uint(LIGHTS_PER_TILE);
    for (int k = 0; k < LIGHTS_PER_TILE; ++k) {
        uint e = best[k];
        uint h = best_hash[k];
        if (e != NO_LIGHT) {
            // A new choice wants its ray (`cast_rays`); a kept one keeps
            // what its ray found and wants it again in turn.
            e |= best_seen[k] == 1u ? 0x80000000u : 0u;
            if (best_seen[k] == 0u || ((uint(k) + frame + t.x + t.y) % LIGHT_RECHECK) == 0u) {
                h &= ~1u;
            }
        }
        tiles[base + uint(k)] = uvec2(e, h);
    }
}

#elif defined(RT) && defined(GIFILTER)

// The GI filter (`-DRT -DGIFILTER`), run three times after the GI pass,
// `pc.steps` 1, 2 and 4 blocks apart (an a-trous wavelet filter, as in
// SVGF): each block the 5 by 5 blocks that far apart around it, weighted by
// a B-spline, by how near they lie to its surface's plane, by how alike
// their normals are and by how alike their light is, measured against the
// noise its variance (from the moments the GI pass keeps, or the last
// pass's) leaves; the variance filtered along with the light. Step 1 reads
// the GI pass's result into `gi_fa`, 2 that into `gi_fb`, 4 that into
// `gi_fa` again, which the apply and the reflections take.
const float KERNEL[3] = float[](0.375, 0.25, 0.0625);

void light_of(uint k, bool odd, out vec3 L, out float variance) {
    if (pc.steps <= 1u) {
        uvec4 e0 = odd ? gi_b[2u * k] : gi_a[2u * k];
        uvec4 e1 = odd ? gi_b[2u * k + 1u] : gi_a[2u * k + 1u];
        vec2 bn = unpackHalf2x16(e0.y);
        L = vec3(unpackHalf2x16(e0.x), bn.x);
        vec2 m = unpackHalf2x16(e1.z);
        variance = max(m.y - m.x * m.x, 0.0);
        // Few frames of history say little about the noise: taken as
        // large as the light itself until there are four.
        if (bn.y < 4.0) {
            variance = max(variance, m.x * m.x);
        }
    } else {
        uvec2 f = pc.steps == 2u ? gi_fa[k] : gi_fb[k];
        vec2 bv = unpackHalf2x16(f.y);
        L = vec3(unpackHalf2x16(f.x), bv.x);
        variance = bv.y;
    }
    if (any(isnan(L)) || any(isinf(L)) || isnan(variance) || isinf(variance)) {
        L = vec3(0.0);
        variance = 0.0;
    }
}

void main() {
    camera_from_fit();
    ivec2 b = ivec2(gl_GlobalInvocationID.xy);
    uvec2 hs = half_size();
    if (any(greaterThanEqual(uvec2(b), hs))) {
        return;
    }
    uint i = uint(b.y) * hs.x + uint(b.x);
    bool odd = (frame & 1u) != 0u;
    uvec4 c0 = odd ? gi_b[2u * i] : gi_a[2u * i];
    uvec4 c1 = odd ? gi_b[2u * i + 1u] : gi_a[2u * i + 1u];
    uvec2 result = uvec2(0u);
    if (unpackHalf2x16(c0.y).y > 0.0 && g_fit) {
        vec3 X = uintBitsToFloat(uvec3(c0.zw, c1.x));
        vec3 n = unpackSnorm4x8(c1.y).xyz;
        float dist = max(distance(X, cam_pos.xyz), 1e-3);
        const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);
        vec3 cL;
        float cv;
        light_of(i, odd, cL, cv);
        float lc = dot(cL, LUMA);
        // Never narrower than a quarter of the light itself: with a long
        // history the noise left is small, and edge-stopping on it alone
        // kept neighbouring blocks' small differences as hard steps.
        float sigma = 4.0 * sqrt(cv) + 0.25 * lc + 0.02;
        vec3 sum = vec3(0.0);
        float sv = 0.0, ws = 0.0;
        int step_ = int(max(pc.steps, 1u));
        for (int y = -2; y <= 2; ++y) {
            for (int x = -2; x <= 2; ++x) {
                ivec2 q = b + ivec2(x, y) * step_;
                if (any(greaterThanEqual(uvec2(q), hs))) {
                    continue;
                }
                uint k = uint(q.y) * hs.x + uint(q.x);
                uvec4 e0 = odd ? gi_b[2u * k] : gi_a[2u * k];
                uvec4 e1 = odd ? gi_b[2u * k + 1u] : gi_a[2u * k + 1u];
                if (!(unpackHalf2x16(e0.y).y > 0.0)) {
                    continue;
                }
                vec3 Y = uintBitsToFloat(uvec3(e0.zw, e1.x));
                vec3 m = unpackSnorm4x8(e1.y).xyz;
                vec3 L;
                float v;
                light_of(k, odd, L, v);
                float off_plane = abs(dot(n, Y - X)) / dist;
                float w = KERNEL[abs(x)] * KERNEL[abs(y)]
                    * (1.0 - smoothstep(0.004, 0.03, off_plane))
                    * pow(max(dot(m, n), 0.0), 32.0)
                    * exp(-abs(dot(L, LUMA) - lc) / sigma);
                if (w > 0.0) {
                    sum += w * L;
                    sv += w * w * v;
                    ws += w;
                }
            }
        }
        if (ws > 1e-6) {
            vec3 o = min(sum / ws, vec3(64.0));
            result = uvec2(packHalf2x16(o.rg), packHalf2x16(vec2(o.b, min(sv / (ws * ws), 1000.0))));
        }
    }
    if (pc.steps == 2u) {
        gi_fb[i] = result;
    } else {
        gi_fa[i] = result;
    }
}

#elif defined(RT) && defined(RTEMPORAL)

// The reflections' history (`-DRT -DRTEMPORAL`), per pixel, after the
// upsample: the pixel's last result found where the reflected thing was a
// frame ago (its mirror image, the surface point moved back along the view
// ray by the hit distance, for a mirror; the surface point itself as the
// surface gets rough), kept where the surface there is the same (depth) and
// the reflected thing is as far away (hit distance), held inside the
// colours the pixels around it show now (YCoCg box) and blended with this
// frame's: up to 12 frames while the camera is still, 3 while it turns.
// The block a ray leaves from moves around its block from frame to frame,
// so the edges of what is reflected come out smooth over a few frames
// instead of in block steps. Into this frame's history buffer; the resolve
// pass copies it into the trace image the compose reads.
layout(binding = 4, rgba16f) uniform readonly image2D trace_cur;

vec3 ycocg(vec3 c) {
    return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b, 0.5 * c.r - 0.5 * c.b, -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}

void main() {
    camera_from_fit();
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(uvec2(p), pc.size))) {
        return;
    }
    uint at = uint(p.y) * pc.size.x + uint(p.x);
    bool odd = (frame & 1u) != 0u;
    vec4 cur = imageLoad(trace_cur, p);
    float d = depth_at(p);
    if (any(isnan(cur)) || any(isinf(cur))) {
        cur = vec4(0.0);
    }
    if (d <= 0.0 || !g_fit || (pc.flags & 65536u) == 0u) {
        uvec4 o = uvec4(packHalf2x16(cur.rg), packHalf2x16(cur.ba), 0u, 0u);
        if (odd) { refl_b[at] = o; } else { refl_a[at] = o; }
        return;
    }
    // The box of what the pixels around show now.
    vec3 lo = vec3(1e9), hi = vec3(-1e9);
    float alo = 1e9, ahi = -1e9;
    for (int j = -1; j <= 1; ++j) {
        for (int i = -1; i <= 1; ++i) {
            vec4 c = imageLoad(trace_cur, clamp(p + ivec2(i, j), ivec2(0), ivec2(pc.size) - 1));
            if (any(isnan(c)) || any(isinf(c))) {
                continue;
            }
            vec3 y = ycocg(c.rgb);
            lo = min(lo, y);
            hi = max(hi, y);
            alo = min(alo, c.a);
            ahi = max(ahi, c.a);
        }
    }
    vec3 P = view_pos(vec2(p) + 0.5, d);
    vec3 X = to_world(P);
    vec3 V = normalize(X - cam_pos.xyz);
    float z = P.z * g_near;
    uint s = grid_scale();
    uvec2 hs = half_size();
    uvec2 hb = min(uvec2(p) / s, hs - 1u);
    float t = unpackHalf2x16(blocks[hb.y * hs.x + hb.x].w).x;
    float far_ = 4096.0;
    float th = clamp(t, 0.0, far_);
    // The move of the surface under the block since the last frame (a
    // character, a car; 0 where not known), and the mirror image for a
    // mirror, the surface itself as it gets rough, both moved back by it.
    uvec2 bm = block_motion[hb.y * hs.x + hb.x];
    vec4 mv = vec4(unpackHalf2x16(bm.x), unpackHalf2x16(bm.y));
    if (any(isnan(mv)) || any(isinf(mv)) || mv.w <= 0.0) {
        mv = vec4(0.0);
    }
    bool moving = dot(mv.xyz, mv.xyz) > 1e-4;
    vec3 Y = mix(X + V * th, X, clamp(pc.roughness * 2.0, 0.0, 1.0)) - mv.xyz;
    float frames = 0.0;
    vec4 hist = vec4(0.0);
    float camera_turn = 1.0 - dot(forward.xyz, prev_forward.xyz);
    float moved = distance(cam_pos.xyz, prev_pos.xyz);
    float most = mix(12.0, 3.0, max(smoothstep(0.0002, 0.004, camera_turn), smoothstep(0.05, 1.0, moved)));
    if (moving) {
        most = min(most, 3.0);
    }
    if (prev_camera.w > 0.0) {
        // Where the surface point was on the screen, and its depth then.
        vec3 r = X - mv.xyz - prev_pos.xyz;
        vec3 vs = vec3(dot(r, prev_right.xyz), dot(r, prev_up.xyz), dot(r, prev_forward.xyz));
        vec3 ry = Y - prev_pos.xyz;
        vec3 vy = vec3(dot(ry, prev_right.xyz), dot(ry, prev_up.xyz), dot(ry, prev_forward.xyz));
        if (vs.z > 0.0 && vy.z > 0.0) {
            vec2 ps = (vec2(vs.x / (vs.z * prev_camera.x), -vs.y / (vs.z * prev_camera.y)) * 0.5 + 0.5) * vec2(pc.size);
            vec2 py = (vec2(vy.x / (vy.z * prev_camera.x), -vy.y / (vy.z * prev_camera.y)) * 0.5 + 0.5) * vec2(pc.size);
            if (all(greaterThanEqual(ps, vec2(0.0))) && all(lessThan(ps, vec2(pc.size))) && all(greaterThanEqual(py, vec2(0.0))) && all(lessThan(py, vec2(pc.size)))) {
                uvec4 es = odd ? refl_a[uint(ps.y) * pc.size.x + uint(ps.x)] : refl_b[uint(ps.y) * pc.size.x + uint(ps.x)];
                uvec4 ey = odd ? refl_a[uint(py.y) * pc.size.x + uint(py.x)] : refl_b[uint(py.y) * pc.size.x + uint(py.x)];
                float zs = uintBitsToFloat(es.z);
                vec2 ty = unpackHalf2x16(ey.w);
                float ty_ = ty.x;
                bool same_surface = abs(zs - vs.z) < 0.02 * vs.z + 0.05;
                bool same_hit = abs(min(ty_, far_) - th) < 0.15 * th + 1.0;
                if (same_surface && same_hit && ty.y > 0.0) {
                    hist = vec4(unpackHalf2x16(ey.x), unpackHalf2x16(ey.y));
                    frames = ty.y;
                    if (any(isnan(hist)) || any(isinf(hist))) {
                        frames = 0.0;
                    }
                }
            }
        }
    }
    vec4 o = cur;
    if (frames > 0.0) {
        // Held inside what the neighbourhood shows now, a little widened.
        vec3 pad = 0.1 * (hi - lo) + vec3(0.002);
        vec3 y = clamp(ycocg(hist.rgb), lo - pad, hi + pad);
        vec3 rgb = vec3(y.x + y.y - y.z, y.x + y.z, y.x - y.y - y.z);
        hist = vec4(rgb, clamp(hist.a, alo - 0.02, ahi + 0.02));
        frames = min(frames + 1.0, most);
        o = mix(hist, cur, 1.0 / frames);
    } else {
        frames = 1.0;
    }
    uvec4 w = uvec4(packHalf2x16(o.rg), packHalf2x16(o.ba), floatBitsToUint(z), packHalf2x16(vec2(min(t, 60000.0), frames)));
    if (odd) { refl_b[at] = w; } else { refl_a[at] = w; }
}

#elif defined(RT) && defined(RRESOLVE)

// The reflections' history pass's result into the trace image the compose
// reads (`-DRT -DRRESOLVE`).
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(uvec2(p), pc.size))) {
        return;
    }
    uint at = uint(p.y) * pc.size.x + uint(p.x);
    uvec4 e = (frame & 1u) != 0u ? refl_b[at] : refl_a[at];
    imageStore(trace_img, p, vec4(unpackHalf2x16(e.x), unpackHalf2x16(e.y)));
}

#elif defined(RT) && defined(RBLUR)

// The soft look's blur (`-DRT -DRBLUR`, devctl `rt soft on`): a separable
// gaussian over the reflections, across (`steps` 1) then down (2, longer:
// streaks), its radius growing with the roughness and with how far the
// reflected thing is (sharper where it touches the surface, very soft far
// off), stopped only
// where the receiving surface changes (a tap off this pixel's plane, or
// turned away), never by what is reflected, so no block can show as a
// step. Across: the trace image into the free history buffer (the one the
// temporal pass read from); down: that into the trace image.
layout(binding = 4, rgba16f) uniform image2D trace_rw;

vec4 tap(ivec2 q, bool across) {
    uint at = uint(q.y) * pc.size.x + uint(q.x);
    if (across) {
        return imageLoad(trace_rw, q);
    }
    // The free buffer: the one the temporal pass read (last frame's).
    uvec4 e = (frame & 1u) != 0u ? refl_a[at] : refl_b[at];
    return vec4(unpackHalf2x16(e.x), unpackHalf2x16(e.y));
}

void main() {
    camera_from_fit();
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(uvec2(p), pc.size))) {
        return;
    }
    bool across = pc.steps <= 1u;
    uint at = uint(p.y) * pc.size.x + uint(p.x);
    vec4 own = tap(p, across);
    vec4 o = own;
    float d = depth_at(p);
    if (d > 0.0 && g_fit) {
        vec3 P = view_pos(vec2(p) + 0.5, d);
        vec3 N = surface_at(p, P).n;
        if (N != vec3(0.0)) {
            uint s = grid_scale();
            uvec2 hs = half_size();
            uvec2 hb = min(uvec2(p) / s, hs - 1u);
            float t = min(unpackHalf2x16(blocks[hb.y * hs.x + hb.x].w).x, 4096.0);
            float dist = length(P) * g_near;
            float spread = t / (t + dist + 1.0);
            float radius = clamp((2.0 + 12.0 * spread) * (0.5 + pc.roughness), 1.5, 16.0);
            // Stretched down the screen (along a floor's reflections, as a
            // glossy floor streaks them), more the further the reflected
            // thing and the more grazing the view: up to 6 to 1.
            float grazing = 1.0 - abs(dot(N, normalize(P)));
            if (!across) {
                radius = min(radius * clamp(1.5 + 6.0 * spread * grazing, 1.0, 6.0), 64.0);
            }
            ivec2 axis = across ? ivec2(1, 0) : ivec2(0, 1);
            float plane = dot(N, P);
            vec4 sum = vec4(0.0);
            float ws = 0.0;
            for (int k = -6; k <= 6; ++k) {
                vec2 off = vec2(axis) * (float(k) * radius / 6.0);
                ivec2 q = clamp(p + ivec2(round(off)), ivec2(0), ivec2(pc.size) - 1);
                float w = exp(-2.0 * float(k * k) / 36.0 * 4.0);
                if (k != 0) {
                    float dq = depth_at(q);
                    if (dq <= 0.0) {
                        continue;
                    }
                    vec3 Q = view_pos(vec2(q) + 0.5, dq);
                    float off_plane = abs(dot(N, Q) - plane) / P.z;
                    w *= 1.0 - smoothstep(0.004, 0.03, off_plane);
                }
                if (w > 0.0) {
                    vec4 c = tap(q, across);
                    if (!any(isnan(c)) && !any(isinf(c))) {
                        sum += w * c;
                        ws += w;
                    }
                }
            }
            if (ws > 1e-4) {
                o = sum / ws;
            }
        }
    }
    if (across) {
        uvec4 e = uvec4(packHalf2x16(o.rg), packHalf2x16(o.ba), 0u, 0u);
        if ((frame & 1u) != 0u) { refl_a[at] = e; } else { refl_b[at] = e; }
    } else {
        imageStore(trace_rw, p, o);
    }
}

#elif defined(RT) && defined(GIAPPLY)

// The engine's colour format, read back (the inverse of `pack` in the
// compose).
vec4 unpack(uint v) {
    uint mode = (pc.flags >> 8) & 0xfu;
    if (mode == 2u) {
        return unpackUnorm4x8(v);
    }
    if (mode == 3u) {
        return unpackUnorm4x8(v).bgra;
    }
    vec4 q = vec4(v & 1023u, (v >> 10) & 1023u, (v >> 20) & 1023u, v >> 30) / vec4(1023.0, 1023.0, 1023.0, 3.0);
    return mode == 1u ? q.bgra : q;
}

uint pack_result(vec4 c) {
    c = clamp(c, 0.0, 1.0);
    uint mode = (pc.flags >> 8) & 0xfu;
    if (mode == 2u) {
        return packUnorm4x8(c);
    }
    if (mode == 3u) {
        return packUnorm4x8(c.bgra);
    }
    uvec4 q = uvec4(round(c * vec4(1023.0, 1023.0, 1023.0, 3.0)));
    if (mode == 1u) {
        q = q.bgra;
    }
    return q.r | (q.g << 10) | (q.b << 20) | (q.a << 30);
}

// The glow and GI apply pass (`-DRT -DGIAPPLY`), on the finished
// reflections' result, every traced frame.
//
// The indirect light (flags bit 14, when it ran): the filtered indirect
// light around each pixel (a joint bilateral upsample of the blocks around
// it, then kept over frames per pixel; see below), in place of the
// engine's ambient: the pixel's base colour estimated as its colour over
// the engine's light without shadow, times the indirect light less the
// ambient the engine already gave it; never darker than half, so corners
// darken and walls tint what faces them.
//
// The glow: what the screen cannot show because it ends at white, the
// reflections' share above it (reflected Neon is kept up to 4 times white)
// and the indirect light's (a wall beside a Neon panel), as a colour above
// white in the screen's encoding, into `glow_img` (the reflections' trace
// image, which the compose has read), for the bloom to add to what it
// blooms (`post.comp` BLOOM_PREFILTER, its flag GLOW), so reflected Neon and
// its light on the walls glow as the engine's own Neon does.
void main() {
    camera_from_fit();
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(uvec2(p), pc.size))) {
        return;
    }
    // The reflections' excess: the compose blends the trace's colour over
    // the scene by its strength; what that sum has above white.
    vec4 r = imageLoad(glow_img, p);
    vec3 glow = vec3(0.0);
    if (!any(isnan(r)) && !any(isinf(r)) && r.a > 1.0 / 1024.0) {
        vec3 base = texelFetch(color_tex, p, 0).rgb;
        glow = max(base * (1.0 - clamp(r.a, 0.0, 1.0)) + r.rgb - 1.0, vec3(0.0));
    }
    imageStore(glow_img, p, vec4(glow, 1.0));
    if (!g_fit || (pc.flags & 16384u) == 0u) {
        return;
    }
    float d = depth_at(p);
    if (d <= 0.0) {
        return;
    }
    vec3 P = view_pos(vec2(p) + 0.5, d);
    vec3 N = surface_at(p, P).n;
    if (N == vec3(0.0)) {
        return;
    }
    vec3 n = normalize(world_dir(N));
    vec3 X = to_world(P);
    float dist = length(P) * g_near;
    bool odd = (frame & 1u) != 0u;
    uvec2 hs = half_size();
    float gs = float(grid_scale());
    // The pixel's colour, the guide for the upsample.
    vec3 guide = texelFetch(opaque_tex, p, 0).rgb;
    // The 4 by 4 blocks around the pixel, from the one up and left of the
    // nearest middle: a joint bilateral upsample (Kopf et al. 2007), each
    // block weighted by a smooth (bicubic B-spline) kernel over the
    // distance from the pixel to the point its value was traced from, by
    // how near that point lies to the pixel's plane and how alike their
    // normals and colours are. Every weight is smooth, so where blocks
    // disagree the light blends over a block or two instead of stepping.
    vec2 g = (vec2(p) + 0.5) / gs - 0.5;
    ivec2 b0 = ivec2(floor(g)) - 1;
    vec3 sum = vec3(0.0), lo = vec3(1e9), hi = vec3(-1e9);
    float weights = 0.0;
    vec3 fallback = vec3(0.0);
    float fallback_w = 0.0;
    float pix = dist * 2.0 * g_tan.y / float(pc.size.y);
    for (int j = 0; j < 4; ++j) {
        for (int i = 0; i < 4; ++i) {
            ivec2 b = b0 + ivec2(i, j);
            if (any(greaterThanEqual(uvec2(b), hs))) {
                continue;
            }
            uint k = uint(b.y) * hs.x + uint(b.x);
            uvec4 e0 = odd ? gi_b[2u * k] : gi_a[2u * k];
            uvec4 e1 = odd ? gi_b[2u * k + 1u] : gi_a[2u * k + 1u];
            vec2 bn = unpackHalf2x16(e0.y);
            if (bn.y <= 0.0) {
                continue;
            }
            uvec2 f = gi_fa[k];
            vec3 L = vec3(unpackHalf2x16(f.x), unpackHalf2x16(f.y).x);
            if (any(isnan(L)) || any(isinf(L)) || f == uvec2(0u)) {
                continue;
            }
            vec3 Y = uintBitsToFloat(uvec3(e0.zw, e1.x));
            vec3 m = unpackSnorm4x8(e1.y).xyz;
            // Where its point is on the screen, in blocks from the pixel.
            vec3 H = to_view_space(Y);
            vec2 at = H.z > 1e-3 ? to_pixel(H) : (vec2(b) + 0.5) * gs;
            vec2 o = abs((at - (vec2(p) + 0.5)) / gs);
            float r = length(o);
            float spatial = r < 1.0 ? (4.0 - 6.0 * r * r + 3.0 * r * r * r) / 6.0
                : r < 2.0 ? (2.0 - r) * (2.0 - r) * (2.0 - r) / 6.0 : 0.0;
            float off_plane = abs(dot(n, Y - X)) / (gs * pix + 0.002 * dist);
            float w_plane = exp(-off_plane * off_plane);
            float w_normal = pow(max(dot(m, n), 0.0), 8.0);
            vec3 cg = textureLod(opaque_tex, clamp(at, vec2(0.5), vec2(pc.size) - 0.5) / vec2(pc.size), 0.0).rgb;
            float w_colour = 0.25 + 0.75 * exp(-4.0 * length(cg - guide));
            float w = spatial * w_plane * w_normal * w_colour;
            // Something to show where every block is turned away or off
            // the plane (a thin edge): the nearest by distance alone.
            float wf = exp(-r * r) * (0.05 + w_normal);
            fallback += wf * L;
            fallback_w += wf;
            if (w > 1e-6) {
                sum += w * L;
                weights += w;
                lo = min(lo, L);
                hi = max(hi, L);
            }
        }
    }
    if (weights < 1e-4) {
        if (fallback_w < 1e-6) {
            return;
        }
        sum = fallback;
        weights = fallback_w;
        lo = hi = fallback / fallback_w;
    }
    vec3 now_gi = sum / weights;
    // Each pixel keeps the upsampled light over frames (the blocks' points
    // move over their block from frame to frame), found where the pixel's
    // point was the frame before, held within what the blocks around show
    // now: block edges average out instead of standing still.
    uint at_px = uint(p.y) * pc.size.x + uint(p.x);
    bool room = at_px < uint(gi_px_a.length()) && at_px < uint(gi_px_b.length());
    if (room) {
        vec3 rp = X - prev_pos.xyz;
        vec3 vp = vec3(dot(rp, prev_right.xyz), dot(rp, prev_up.xyz), dot(rp, prev_forward.xyz));
        float frames_px = 0.0;
        vec3 hist = vec3(0.0);
        if (prev_camera.w > 0.0 && vp.z > 0.0) {
            vec2 q = (vec2(vp.x / (vp.z * prev_camera.x), -vp.y / (vp.z * prev_camera.y)) * 0.5 + 0.5) * vec2(pc.size);
            if (all(greaterThanEqual(q, vec2(0.0))) && all(lessThan(q, vec2(pc.size)))) {
                uint pa = uint(q.y) * pc.size.x + uint(q.x);
                uvec4 e = odd ? gi_px_a[pa] : gi_px_b[pa];
                vec2 bf = unpackHalf2x16(e.y);
                float zp = uintBitsToFloat(e.z);
                if (bf.y > 0.0 && abs(zp - vp.z) < 0.02 * vp.z + 0.05) {
                    hist = vec3(unpackHalf2x16(e.x), bf.x);
                    frames_px = bf.y;
                }
            }
        }
        if (frames_px > 0.0 && !any(isnan(hist)) && !any(isinf(hist))) {
            vec3 pad = 0.15 * (hi - lo) + 0.02 * hi + vec3(0.002);
            hist = clamp(hist, lo - pad, hi + pad);
            frames_px = min(frames_px + 1.0, 16.0);
            now_gi = mix(hist, now_gi, 1.0 / frames_px);
        } else {
            frames_px = 1.0;
        }
        uvec4 o = uvec4(packHalf2x16(now_gi.rg), packHalf2x16(vec2(now_gi.b, frames_px)), floatBitsToUint(P.z * g_near), 0u);
        if (odd) { gi_px_b[at_px] = o; } else { gi_px_a[at_px] = o; }
    }
    sum = now_gi;
    weights = 1.0;
    // Brightening held (GI_MOST, a soft knee).
    vec3 indirect = gi_held(sum / weights, engine_ambient(n));
    uint packed = imageLoad(result_img, p).r;
    vec4 c = unpack(packed);
    float exposure_ = max(frame_block[20].y, 1e-3);
    vec3 lin = c.rgb * c.rgb / exposure_;
    vec3 ambient = engine_ambient(n);
    vec3 to_sun = -frame_block[16].xyz;
    vec3 light = ambient + frame_block[15].xyz * max(dot(n, to_sun), 0.0) + frame_block[17].xyz * max(-dot(n, to_sun), 0.0);
    vec3 albedo = lin / max(light, vec3(0.02));
    // Never darker than 70% (a corner darkens, a room does not go dim).
    vec3 now = max(lin + albedo * (indirect - ambient), 0.7 * lin);
    vec3 shown = sqrt(max(now * exposure_, vec3(0.0)));
    c.rgb = clamp(shown, 0.0, 1.0);
    imageStore(result_img, p, uvec4(pack_result(c), 0u, 0u, 0u));
    imageStore(glow_img, p, vec4(glow + max(min(shown, vec3(4.0)) - 1.0, vec3(0.0)), 1.0));
}

#elif defined(RT) && !defined(UPSAMPLE)


void main() {
    camera_from_fit();
    ivec2 b = ivec2(gl_GlobalInvocationID.xy);
    uvec2 hs = half_size();
    if (any(greaterThanEqual(uvec2(b), hs))) {
        return;
    }
    vec4 r = vec4(0.0);
    uint from = leader(b);
    float d = 0.0;
    // Whether the block lies on a curved mesh: its triangle's vertex normal
    // turns from the depth's flat one. Kept as the stored depth's sign, for
    // the upsample.
    bool curved = false;
    if (from != NO_PIXEL) {
        ivec2 p = ivec2(from & 0xffffu, from >> 16);
        d = depth_at(p);
        vec3 P = view_pos(vec2(p) + 0.5, d);
        vec3 N = surface_at(p, P).n;
        float wet = N == vec3(0.0) ? 0.0 : wetness(N);
        // The smooth normal (a ray from the camera) only where it is used:
        // a wet pixel, or the debug view.
        uint view_ = (pc.flags >> 6) & 3u;
        bool debug_ = view_ == 1u || view_ == 2u;
        if (view_ == 3u && N != vec3(0.0)) {
            wet = 1.0;
        }
        if (N != vec3(0.0) && (wet > 0.0 || debug_)) {
            vec3 n = surface_normal(p, P, N);
            curved = g_source > 1.5 && dot(n, N) < 0.9995;
            if (debug_) {
                r = debug_view(n);
            } else if (wet > 0.0 && (g_own_mode != 3u || view_ == 3u)) {
                // (Not on terrain: grass, sand and rock are rough.)
                r = reflection_rt(p, P, n, wet);
            }
        }
    }
    uint i = uint(b.y) * hs.x + uint(b.x);
    block_motion[i] = uvec2(packHalf2x16(g_own_motion.xy), packHalf2x16(g_own_motion.zw));
    // The history is kept per pixel (RTEMPORAL); here the hit distance
    // for its reprojection, and whether the block is on a curved mesh.
    blocks[i] = uvec4(packHalf2x16(r.rg), packHalf2x16(r.ba), from, packHalf2x16(vec2(min(g_hit_t, 60000.0), curved ? 1.0 : 0.0)));
}

#else

void main() {
#ifdef UPSAMPLE
    camera_from_fit();
#endif
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(uvec2(p), pc.size))) {
        return;
    }
    vec4 r = vec4(0.0);
    float d = depth_at(p);
    if (d > 0.0) {
        vec3 P = view_pos(vec2(p) + 0.5, d);
        vec3 N = surface_at(p, P).n;
        float wet = N == vec3(0.0) ? 0.0 : wetness(N);
#ifdef UPSAMPLE
        if (N != vec3(0.0) && ((pc.flags >> 6) & 3u) != 0u) {
            wet = 1.0;
        }
#endif
        if (wet > 0.0) {
#ifdef UPSAMPLE
            // The rays of the blocks around that left from this pixel's
            // plane, by a tent over three pixels of distance.
            uvec2 hs = half_size();
            float s_ = float(grid_scale());
            ivec2 b0 = p / int(grid_scale());
            vec4 samples[9];
            float ks[9];
            float weights = 0.0, mean = 0.0;
            for (int n = 0; n < 9; ++n) {
                ks[n] = 0.0;
                samples[n] = vec4(0.0);
                ivec2 b = b0 + ivec2(n % 3 - 1, n / 3 - 1);
                if (any(greaterThanEqual(uvec2(b), hs))) {
                    continue;
                }
                uvec4 e = blocks[uint(b.y) * hs.x + uint(b.x)];
                if (e.z == NO_PIXEL) {
                    continue;
                }
                ivec2 q = ivec2(e.z & 0xffffu, e.z >> 16);
                vec3 Q = view_pos(vec2(q) + 0.5, depth_at(q));
                float off_plane = abs(dot(N, Q - P)) / P.z;
                float k = (1.0 - smoothstep(0.004, 0.02, off_plane)) * max(1.0 - length(vec2(q - p)) / (1.5 * s_), 0.0);
                if (k > 0.0) {
                    samples[n] = vec4(unpackHalf2x16(e.x), unpackHalf2x16(e.y));
                    ks[n] = k;
                    weights += k;
                    mean += k * dot(samples[n].rgb, vec3(0.2126, 0.7152, 0.0722));
                }
            }
            // Near the camera (within 24 studs) on a curved mesh (its block's
            // triangle has vertex normals that turn from the flat one, such
            // as a head), or on a clearly curved depth (neighbours' normals
            // turning more than about 5 degrees), the pixel traces its own
            // ray instead: a 2 by 2 block is too coarse there. At most
            // FULL_RATE_MAX pixels a frame.
            if (P.z * g_near < 24.0 && g_fit && (pc.flags & 32768u) != 0u) {
                uvec4 own = blocks[uint(b0.y) * hs.x + uint(b0.x)];
                bool curved = unpackHalf2x16(own.w).y > 0.5 || dot(smoothed(p, P, N), N) < 0.996;
                if (curved && atomicAdd(full_rate, 1u) < FULL_RATE_MAX) {
                    vec3 n = surface_normal(p, P, N);
                    uint view_ = (pc.flags >> 6) & 3u;
                    // Terrain is rough (grass, sand, rock): no reflection.
                    bool rough_ = g_own_mode == 3u && view_ != 3u;
                    imageStore(trace_img, p, view_ == 1u || view_ == 2u ? debug_view(n)
                        : rough_ ? vec4(0.0) : reflection_rt(p, P, n, view_ == 3u ? 1.0 : wet));
                    return;
                }
            }
            if (weights > 1e-3) {
                // A ray that slipped through a gap the others did not (a
                // lattice, a thin pole) is held to twice its neighbours'
                // brightness, so it does not show as a flickering speck.
                float cap = 2.0 * mean / weights + 0.02;
                vec4 sum = vec4(0.0);
                for (int n = 0; n < 9; ++n) {
                    float l = dot(samples[n].rgb, vec3(0.2126, 0.7152, 0.0722));
                    vec4 v = samples[n];
                    if (l > cap) {
                        v.rgb *= cap / l;
                    }
                    sum += ks[n] * v;
                }
                r = sum / weights;
            }

#else
            r = reflection(p, P, smoothed(p, P, N), wet);
#endif
        }
    }
    imageStore(trace_img, p, r);
}

