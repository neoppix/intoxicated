// Screen-space reflections on the engine's resolved scene colour (see
// `ssr.rs`), the second and third of three dispatches: `depth.comp` has
// copied the scene depth into `depth_copy`. One invocation per pixel in
// both.
//
// The trace (this file as it is) marches the reflected ray of every wet
// pixel and writes what it found to `trace_img`: the reflected colour
// premultiplied by how strongly it shows (Fresnel, wetness and how sure the
// hit is), so a miss is 0 and a doubtful hit fades instead of cutting out.
//
// The compose (this file with COMPOSE defined) blurs that over nine taps of
// the pixel's own surface, which turns the hard edges, the stair steps and
// the grain of single rays into a soft reflection, blends it into the scene
// colour and writes the pixel, with a reflection blended in or unchanged,
// packed bit for bit in the engine's colour format into a 32-bit image of
// ours that is then copied over the engine's.
//
// Every look is a parameter in the push constant block below, set from the
// INTOXICATED_SSR_* variables and devctl `ssr set` while the game runs;
// nothing about how the reflections look is a constant here, only how the
// edges of a hit fade.
//
// Built by build.rs with the system's glslc when there is one, and
// otherwise taken from the files beside this one, the numbers glslc prints
// wrapped in `&[` and `]`:
//
//     glslc -O --target-env=vulkan1.0 -mfmt=num ssr.comp -o -
//         -> ssr.spv.rs
//     glslc -O --target-env=vulkan1.0 -mfmt=num -DCOMPOSE ssr.comp -o -
//         -> compose.spv.rs
//     glslc -O --target-env=vulkan1.0 -mfmt=num -DRT ssr.comp -o -
//         -> rt_trace.spv.rs
//     glslc -O --target-env=vulkan1.0 -mfmt=num -DRT -DUPSAMPLE ssr.comp -o -
//         -> rt_upsample.spv.rs
//
// A test compiles this file again and compares, whenever glslc is there.
//
// Depth is reversed-Z with the far plane at infinity: depth = near / z, the
// sky is 0. Positions are kept in units of the near plane (z = 1 / depth),
// which is all that is needed: the near plane cancels out of every direction
// and of every projection, and the thickness test and the ray length are
// relative. Inverse depth is affine in screen space, so along a reflected
// ray drawn on the screen it is interpolated linearly, and a ray towards
// infinity ends at its vanishing point with inverse depth 0. For the same
// reason a plane has no second difference of depth across a pixel, which
// is how an edge is told from a surface.

#version 450
#ifdef RT
#extension GL_EXT_nonuniform_qualifier : require
#endif

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D color_tex;
layout(binding = 2, r32f) uniform readonly image2D depth_copy;
#ifdef COMPOSE
layout(binding = 3, r32ui) uniform writeonly uimage2D out_img;
layout(binding = 5) uniform sampler2D trace_tex;
#else
layout(binding = 4, rgba16f) uniform writeonly image2D trace_img;
#endif

// std430, as push constants are laid out; `ssr::Params` mirrors it.
layout(push_constant) uniform Params {
    uvec2 size;
    // tan of half the horizontal and of half the vertical field of view.
    vec2 tan_half;
    // Wet surfaces are multiplied by tint.rgb (and by 1 - darken).
    vec4 tint;
    // How much of the reflection is blended in, 0 to 1.
    float intensity;
    // Bit 0: only surfaces that face up are wet. Bits 8 to 11: how the
    // engine's format packs a pixel (see `pack`).
    uint flags;
    // Steps along the ray before the binary search.
    uint steps;
    // How far behind the drawn surface a ray may be and still hit it, as a
    // fraction of that surface's distance; hits fade out over the second
    // half of it.
    float thickness;
    // 0: a reflection only as soft as the compose blur; up to 1: blurred,
    // more the further the ray went.
    float roughness;
    // 0: the same strength at every angle, like a mirror; 1: strong only at
    // grazing angles (Schlick, reflectance 0.04 head on).
    float fresnel;
    // The view-space normal's y (towards the top of the screen) at which a
    // surface counts as facing up, faded in over 0.15 either side.
    float up_threshold;
    // How far a ray goes, in multiples of the surface's distance from the
    // camera; 0 to infinity (and the sky).
    float max_distance;
    // Reflections fade out towards the screen edges over this fraction of
    // the smaller side.
    float edge_fade;
    // Wet surfaces are this much darker, 0 to 1.
    float darken;
    // 0: the reflection has the colours of what it reflects; 1: their
    // brightness in the hue of the surface it lies on (water stays blue).
    float keep_colour;
} pc;

const int REFINE_STEPS = 6;
const float UP_SOFTNESS = 0.15;
// A second difference of depth, relative to the depth, above which a pixel
// is on an edge rather than on a surface: hits fade out from LO to HI.
const float EDGE_LO = 0.01;
const float EDGE_HI = 0.05;
// Surfaces seen this close to edge on (the cosine of the view angle) fade
// out: near the horizon one pixel spans a long stretch of the surface and
// its normal, from depth, is no longer to be trusted. Meant for the streaks
// along a sea's horizon, which is INFERRED: Timebomb Duels has no sea.
const float GRAZING_LO = 0.02;
const float GRAZING_HI = 0.08;

float depth_at(ivec2 p) {
    return imageLoad(depth_copy, clamp(p, ivec2(0), ivec2(pc.size) - 1)).r;
}

// View space: x right, y up, z away from the camera.
#ifdef RT
// The camera as `rt/build.comp`'s FIT measured it this frame (set at the
// start of main): tan of the half fields of view, the near plane, the
// world's up in view space; the fov knob and view-space y when it could not.
vec2 g_tan;
float g_near;
vec3 g_up;
bool g_fit;
#define TAN_HALF g_tan
#else
#define TAN_HALF pc.tan_half
#endif

vec3 view_pos(vec2 pixel, float d) {
    vec2 ndc = pixel / vec2(pc.size) * 2.0 - 1.0;
    return vec3(ndc.x * TAN_HALF.x, -ndc.y * TAN_HALF.y, 1.0) / d;
}

// What depth says about one pixel: its normal (zero when a whole axis is
// sky) and how far it is from lying on a plane with its four neighbours.
struct Surface {
    vec3 n;
    float edge;
};

// The normal from the depth of the four neighbours, each axis from the side
// whose depth is closer to this pixel's, so an edge does not bend it; the
// edge measure from the second difference of depth along each axis.
Surface surface_at(ivec2 p, vec3 P) {
    vec2 c = vec2(p) + 0.5;
    float dc = 1.0 / P.z;
    float dl = depth_at(p + ivec2(-1, 0));
    float dr = depth_at(p + ivec2(1, 0));
    float du = depth_at(p + ivec2(0, -1));
    float dd = depth_at(p + ivec2(0, 1));
    float edge = max(abs(dl + dr - 2.0 * dc), abs(du + dd - 2.0 * dc)) / dc;
    if ((dl <= 0.0 && dr <= 0.0) || (du <= 0.0 && dd <= 0.0)) {
        return Surface(vec3(0.0), edge);
    }
    vec3 dx, dy;
    if (dl <= 0.0 || (dr > 0.0 && abs(1.0 / dr - P.z) < abs(1.0 / dl - P.z))) {
        dx = view_pos(c + vec2(1.0, 0.0), dr) - P;
    } else {
        dx = P - view_pos(c - vec2(1.0, 0.0), dl);
    }
    if (du <= 0.0 || (dd > 0.0 && abs(1.0 / dd - P.z) < abs(1.0 / du - P.z))) {
        dy = view_pos(c + vec2(0.0, 1.0), dd) - P;
    } else {
        dy = P - view_pos(c - vec2(0.0, 1.0), du);
    }
    vec3 n = cross(dx, dy);
    float l = length(n);
    if (l <= 0.0) {
        return Surface(vec3(0.0), edge);
    }
    n /= l;
    // Towards the camera.
    return Surface(dot(n, P) > 0.0 ? -n : n, edge);
}

// The normal for the reflection: the depth's, evened out over a ring of
// eight neighbours three pixels away whose surface lies on this one's and
// turns less than 35 degrees from it, so a round surface built of flat
// triangles reflects smoothly while an edge between two faces stays sharp.
vec3 smoothed(ivec2 p, vec3 P, vec3 N) {
    const ivec2 ring[8] = ivec2[8](ivec2(3, 0), ivec2(2, 2), ivec2(0, 3), ivec2(-2, 2),
                                   ivec2(-3, 0), ivec2(-2, -2), ivec2(0, -3), ivec2(2, -2));
    vec3 sum = N;
    for (int i = 0; i < 8; ++i) {
        ivec2 q = p + ring[i];
        float dq = depth_at(q);
        if (dq <= 0.0) {
            continue;
        }
        vec3 Q = view_pos(vec2(q) + 0.5, dq);
        vec3 n = surface_at(q, Q).n;
        if (dot(n, N) > 0.82 && abs(dot(N, Q - P)) < 0.03 * P.z) {
            sum += n;
        }
    }
    return normalize(sum);
}

// How wet the surface is: 1 everywhere, or by how much it faces up.
float wetness(vec3 N) {
    if ((pc.flags & 1u) == 0u) {
        return 1.0;
    }
#ifdef RT
    float up = dot(N, g_up);
#else
    float up = N.y;
#endif
    return smoothstep(pc.up_threshold - UP_SOFTNESS, pc.up_threshold + UP_SOFTNESS, up);
}

#ifdef COMPOSE

// The engine's colour format, bit for bit, as a 32-bit word; a pixel read
// and written back unchanged keeps every bit.
uint pack(vec4 c) {
    c = clamp(c, 0.0, 1.0);
    uint mode = (pc.flags >> 8) & 0xfu;
    if (mode == 2u) {
        return packUnorm4x8(c);          // R8G8B8A8_UNORM
    }
    if (mode == 3u) {
        return packUnorm4x8(c.bgra);     // B8G8R8A8_UNORM
    }
    uvec4 q = uvec4(round(c * vec4(1023.0, 1023.0, 1023.0, 3.0)));
    if (mode == 1u) {
        q = q.bgra;                       // A2R10G10B10_UNORM_PACK32
    }
    return q.r | (q.g << 10) | (q.b << 20) | (q.a << 30); // A2B10G10R10
}

float luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// The trace around pixel `p` (view position P, normal N), over a 3 by 3
// tent of taps spaced 1 to 2.5 pixels apart with roughness, each between
// four texels. A tap counts only as far as its depth lies on this pixel's
// plane, so nothing of a neighbouring object is blurred in. The sum of the
// premultiplied colours and of the strengths, both over the weights.
vec4 gathered(ivec2 p, vec3 P, vec3 N) {
    vec2 inv = 1.0 / vec2(pc.size);
    vec2 c = vec2(p) + 0.5;
    float spacing = 1.0 + 1.5 * pc.roughness;
    float plane = dot(N, P);
    vec4 sum = vec4(0.0);
    float weights = 0.0;
    for (int j = -1; j <= 1; ++j) {
        for (int i = -1; i <= 1; ++i) {
            vec2 at = c + spacing * vec2(i, j);
            float k = (i == 0 ? 2.0 : 1.0) * (j == 0 ? 2.0 : 1.0);
            if (i != 0 || j != 0) {
                // Where this pixel's plane is along the tap's view ray, and
                // where the drawn surface is.
                vec3 ray = view_pos(at, 1.0);
                float along = dot(N, ray);
                float d = depth_at(ivec2(at));
                if (d <= 0.0 || along >= 0.0) {
                    continue;
                }
                float z = 1.0 / d;
                float expected = plane / along;
                k *= 1.0 - smoothstep(0.01, 0.03, abs(z - expected) / expected);
            }
            sum += k * textureLod(trace_tex, at * inv, 0.0);
            weights += k;
        }
    }
    return sum / max(weights, 1e-6);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(uvec2(p), pc.size))) {
        return;
    }
    vec4 base = texelFetch(color_tex, p, 0);
    float d = depth_at(p);
    if (d > 0.0) {
        vec3 P = view_pos(vec2(p) + 0.5, d);
        vec3 N = surface_at(p, P).n;
        float wet = N == vec3(0.0) ? 0.0 : wetness(N);
        // Traced (flags bit 1): the trace has measured the real camera and
        // weighed in the wetness by the world's up; this pass has neither,
        // so any surface may show the trace, and is wet by how strongly it
        // reflects.
        bool traced = (pc.flags & 2u) != 0u;
        vec4 r = vec4(0.0);
        if (traced && N != vec3(0.0)) {
            r = gathered(p, P, N);
            wet = clamp(r.a / max(pc.intensity, 1e-3), 0.0, 1.0);
            // A debug view of the trace's (flags bits 6 and 7) shows as it is.
            if (((pc.flags >> 6) & 3u) != 0u && r.a > 0.5) {
                imageStore(out_img, p, uvec4(pack(vec4(r.rgb / r.a, base.a)), 0u, 0u, 0u));
                return;
            }
        }
        if (wet > 0.0) {
            vec3 own = base.rgb;
            base.rgb *= mix(vec3(1.0), pc.tint.rgb * (1.0 - pc.darken), wet);
            if (!traced) {
                r = gathered(p, P, N);
            }
            if (r.a > 1.0 / 1024.0) {
                vec3 c = r.rgb / r.a;
                vec3 hue = own / max(luma(own), 0.02);
                c = mix(c, luma(c) * hue, pc.keep_colour);
                base.rgb = mix(base.rgb, c, clamp(r.a, 0.0, 1.0));
            }
        }
    }
    imageStore(out_img, p, uvec4(pack(base), 0u, 0u, 0u));
}

#else

// Where a view-space point, or a direction (its point at infinity), lands.
vec2 to_pixel(vec3 v) {
    vec2 ndc = vec2(v.x / (v.z * TAN_HALF.x), -v.y / (v.z * TAN_HALF.y));
    return (ndc * 0.5 + 0.5) * vec2(pc.size);
}

// Which of the four pixels of its 2 by 2 block `p` is, numbered so that
// neighbours differ most: the march's start offset (an eighth, three, five
// or seven eighths of a step) and the angle of the blur taps. The compose's
// 3 by 3 blur always covers all four, so the pattern averages out instead of
// showing as grain, as a different offset for every pixel did.
int cell(ivec2 p) {
    return (p.x & 1) * 2 + ((p.x ^ p.y) & 1);
}

// The scene colour around `at`: one tap, or four on a disc that grows with
// roughness and with how far the ray went, turned by the pixel's cell.
vec3 reflected_color(vec2 at, float pixels, int cell) {
    vec2 inv = 1.0 / vec2(pc.size);
    if (pc.roughness <= 0.0) {
        return textureLod(color_tex, at * inv, 0.0).rgb;
    }
    float radius = min(pc.roughness * (1.0 + 0.06 * pixels), 32.0);
    vec3 c = vec3(0.0);
    for (int i = 0; i < 4; ++i) {
        float a = 0.3926991 * float(cell) + 1.5707963 * float(i);
        float r = radius * (i % 2 == 0 ? 0.5 : 1.0);
        c += textureLod(color_tex, (at + r * vec2(cos(a), sin(a))) * inv, 0.0).rgb;
    }
    return 0.25 * c;
}

// The reflection at pixel `p` (view position P, normal N): its colour
// premultiplied by how much of it to blend in, and that amount.
vec4 reflection(ivec2 p, vec3 P, vec3 N, float wet) {
    vec3 V = normalize(P);
    float cos_v = clamp(dot(-V, N), 0.0, 1.0);
    float schlick = 0.04 + 0.96 * pow(1.0 - cos_v, 5.0);
    float w = pc.intensity * mix(1.0, schlick, pc.fresnel) * wet * smoothstep(GRAZING_LO, GRAZING_HI, cos_v);
    if (w < 1.0 / 1024.0) {
        return vec4(0.0);
    }
    vec3 R = reflect(V, N);
    vec2 s0 = vec2(p) + 0.5;

    // The ray on the screen: to its vanishing point (inverse depth 0) when
    // it goes on for ever, else to where it ends: max_distance, or most of
    // the way to the camera plane for a ray that comes back towards it.
    bool endless = R.z > 1e-4 && pc.max_distance <= 0.0;
    vec2 s1;
    float k0 = 1.0 / P.z, k1;
    if (endless) {
        s1 = to_pixel(R);
        k1 = 0.0;
    } else {
        float len = pc.max_distance > 0.0 ? pc.max_distance * length(P) : 1e4 * P.z;
        if (R.z < -1e-4) {
            len = min(len, 0.9 * P.z / -R.z);
        }
        vec3 E = P + R * len;
        s1 = to_pixel(E);
        k1 = 1.0 / E.z;
    }
    vec2 delta = s1 - s0;
    // Clipped to the screen.
    vec2 lo = vec2(0.5), hi = vec2(pc.size) - 0.5;
    float t_max = 1.0;
    if (delta.x > 0.0) t_max = min(t_max, (hi.x - s0.x) / delta.x);
    if (delta.x < 0.0) t_max = min(t_max, (lo.x - s0.x) / delta.x);
    if (delta.y > 0.0) t_max = min(t_max, (hi.y - s0.y) / delta.y);
    if (delta.y < 0.0) t_max = min(t_max, (lo.y - s0.y) / delta.y);
    if (t_max <= 0.0 || length(delta) * t_max < 3.0) {
        return vec4(0.0);
    }

    // Steps that start two pixels out, so the surface does not hit itself,
    // and grow with the square of their number, so the part of the ray near
    // the surface (contact reflections, the most visible) is sampled finely
    // and the far part coarsely; then a binary search of the step that went
    // behind the drawn depth, the same for every pixel. A crossing more than
    // `thickness` behind it passed behind something, and the march goes on,
    // as it does past the back of a surface. A hit counts in part: less the
    // further behind the surface it is and the closer to an edge of it.
    int k = cell(p);
    float t_start = 2.0 / length(delta);
    float span = t_max - t_start;
    float t_prev = t_start;
    float t_hit = -1.0;
    float sure = 0.0;
    float offset = (float(k) + 0.5) * 0.25;
    for (uint i = 0u; i < pc.steps; ++i) {
        float u = (float(i) + offset) / float(pc.steps);
        float t = t_start + span * u * u;
        float k_ray = mix(k0, k1, t);
        if (depth_at(ivec2(s0 + delta * t)) > k_ray) {
            float a = t_prev, b = t;
            for (int j = 0; j < REFINE_STEPS; ++j) {
                float m = 0.5 * (a + b);
                if (depth_at(ivec2(s0 + delta * m)) > mix(k0, k1, m)) {
                    b = m;
                } else {
                    a = m;
                }
            }
            float kr = mix(k0, k1, b);
            ivec2 q = ivec2(s0 + delta * b);
            float ks = depth_at(q);
            float behind = ks / kr - 1.0;
            if (kr > 0.0 && behind < pc.thickness) {
                // A ray can only meet the front of a surface: one it reaches
                // from behind (water far below a ray that climbs over it, on
                // the screen) is not a hit.
                Surface s = surface_at(q, view_pos(vec2(q) + 0.5, ks));
                if (dot(s.n, R) <= 0.0) {
                    t_hit = b;
                    sure = (1.0 - smoothstep(0.5 * pc.thickness, pc.thickness, behind))
                        * (1.0 - smoothstep(EDGE_LO, EDGE_HI, s.edge));
                    break;
                }
            }
        }
        t_prev = t;
    }

    vec2 at;
    if (t_hit >= 0.0) {
        at = s0 + delta * t_hit;
        // A ray that ends somewhere fades out over the last 40% of it.
        if (!endless) {
            sure *= 1.0 - smoothstep(0.6, 1.0, t_hit);
        }
    } else if (endless && t_max >= 1.0 && depth_at(ivec2(s1)) <= 0.0) {
        // Nothing in the way and the vanishing point is on the screen, in
        // the sky: the reflection is the sky there.
        at = s1;
        sure = 1.0;
    } else {
        return vec4(0.0);
    }

    vec2 margin = min(at, vec2(pc.size) - at) / max(pc.edge_fade * float(min(pc.size.x, pc.size.y)), 1e-3);
    float edge = smoothstep(0.0, 1.0, clamp(min(margin.x, margin.y), 0.0, 1.0));
    float facing = smoothstep(-0.25, 0.05, R.z);
    w = clamp(w * sure * edge * facing, 0.0, 1.0);
    vec3 c = reflected_color(at, length(at - s0), k);
    return vec4(c * w, w);
}

#ifdef RT

// The ray-traced variant (`-DRT`, `rt/trace.rs`): the same surfaces, the
// same strength and the same output as the march above, but the reflected
// ray is traced against the scene's captured triangles (`rt/build.comp`)
// instead of the depth buffer, so it finds what is off screen or hidden
// too: the front of the character seen from behind, the far side of a
// pillar, what the ray meets coming back towards the camera.
//
// Two dispatches. The trace (`-DRT`): one ray per 2 by 2 block of pixels,
// from the block's first pixel that is not sky, into `blocks`. The
// upsample (`-DRT -DUPSAMPLE`): every pixel takes the rays of the 3 by 3
// blocks around it that left from its own surface (their starting point on
// its plane), weighted by how near they are, into `trace_img`, which the
// compose then reads as it reads the march's.
//
// The colour of a hit: the scene colour where the hit is what the screen
// shows there; otherwise (off screen, or behind what the screen shows) the
// colour the hit triangle's vertex shader passed on, the engine's base
// colour of the part without its textures, times the exposure: how much
// brighter the screen is than the bare colours of hits it shows, measured
// over recent frames (see `rt/build.comp`).
//
// The surface is found in the depth buffer and its normal in view space,
// with the projection FIT measured (see `rt/build.comp`); the ray is traced
// in world space, against this frame's triangles and the cached static ones
// that are out of view, so the walls behind the camera are still there when
// it looks down. Each block's result is kept for the next frame and blended
// in again while its pixel stays at the same depth, which steadies it.
//
// The screen colour is taken from a copy of the scene made after its first
// pass (the opaque world), before anything transparent, the interface drawn
// in the world or a billboard is drawn over it (flags bit 2; `ssr.rs`),
// which write no depth and so would pass the depth test. Without such a copy
// this frame, every hit takes its captured colour.

layout(binding = 6) uniform sampler2D opaque_tex;
layout(std430, set = 1, binding = 2) readonly buffer Sorted { uvec2 sorted[]; };
layout(std430, set = 1, binding = 3) readonly buffer Nodes { vec4 nodes[]; };
layout(std430, set = 1, binding = 6) buffer Globals {
    uint leaves;
    uint fit_samples;
    uint fit_ok;
    uint cached;
    vec4 camera;
    vec4 world_up;
    uint lit_screen;
    uint lit_colour;
    float exposure;
    uint frame;
    vec4 cam_pos;
    vec4 right;
    vec4 up;
    vec4 forward;
    uint gen;
    uint dropped;
    uint full;
    uint inserted;
    vec4 last_cam;
    uint cut;
    uint fit_failures;
    uint sky_r;
    uint sky_g;
    uint sky_b;
    uint sky_n;
    vec4 sky;
    uint full_rate;
};
// The environment: what the screen showed in each direction where it showed
// sky, kept over frames, octahedral around world up, `ENV_SIZE` squared:
// (red and green, blue and weight as halves, the cache's generation it
// belongs to, 0). A teleport (a new generation) forgets it.
layout(std430, set = 1, binding = 12) buffer Env { uvec4 env[]; };
const uint ENV_SIZE = 256u;

vec2 env_coord(vec3 d) {
    d /= abs(d.x) + abs(d.y) + abs(d.z);
    vec2 e = d.y >= 0.0 ? d.xz : (1.0 - abs(d.zx)) * vec2(d.x >= 0.0 ? 1.0 : -1.0, d.z >= 0.0 ? 1.0 : -1.0);
    return clamp((e * 0.5 + 0.5) * float(ENV_SIZE), vec2(0.0), vec2(float(ENV_SIZE) - 1.0));
}

uint env_texel(vec3 d) {
    uvec2 t = uvec2(env_coord(d));
    return t.y * ENV_SIZE + t.x;
}

// The sky in world direction `d`, as the screen showed it there: a 5 by 5
// Gaussian over the map around it (wider with roughness), counting only
// directions seen as sky, its strength how much of that footprint was seen,
// so the edge of what was seen fades out instead of showing the map's
// texels; nothing (alpha 0) where none of it was: a direction the screen
// never showed sky in may well have a ceiling the game has not drawn.
vec4 environment(vec3 d) {
    // Flags bit 5: the environment is off.
    if ((pc.flags & 32u) != 0u) {
        return vec4(0.0);
    }
    vec2 c = env_coord(d);
    float step_ = 1.0 + 3.0 * pc.roughness;
    vec3 sum = vec3(0.0);
    float seen = 0.0, total = 0.0;
    for (int j = -2; j <= 2; ++j) {
        for (int i = -2; i <= 2; ++i) {
            float k = exp(-0.5 * float(i * i + j * j));
            total += k;
            ivec2 t = ivec2(clamp(c + step_ * vec2(i, j), vec2(0.0), vec2(float(ENV_SIZE) - 1.0)));
            uvec4 e = env[uint(t.y) * ENV_SIZE + uint(t.x)];
            vec2 bw = unpackHalf2x16(e.y);
            if (e.z == gen && bw.y >= 1.0) {
                float w = k * min(bw.y / 4.0, 1.0);
                sum += w * vec3(unpackHalf2x16(e.x), bw.x);
                seen += w;
            }
        }
    }
    if (seen <= 0.0) {
        return vec4(0.0);
    }
    return vec4(sum / seen, smoothstep(0.0, 0.6, seen / total));
}

// Six vec4 a triangle (see `rt/build.comp`).
layout(std430, set = 1, binding = 8) readonly buffer Tris { vec4 tris[]; };
// This frame's base colour textures, and from a texture's serial to its
// place among them: 1024 entries (serial, place + 1), by serial.
layout(set = 2, binding = 0) uniform sampler2D textures[256];
// The engine's per-frame uniform block, as its lit shaders read it (std140;
// see FINDINGS): in vec4s, 15 the sun's colour, 16 the direction its light
// travels, 17 the colour of the light from the other side, 20 (y) the
// exposure, 32 and 33 the ambient, 34 to 45 the ambient by direction (+x,
// -x, +y, -y, +z, -z twice). Flags bit 8 when it is bound.
layout(set = 2, binding = 1, std140) uniform Frame { vec4 frame_block[61]; };
layout(std430, set = 1, binding = 11) readonly buffer TexMap { uvec2 tex_map[]; };
const uint TRI_VEC4 = 6u;
// Per block: the premultiplied colour and strength as four halves, the
// pixel the ray left from (x | y << 16, or ~0 for none).
layout(std430, set = 1, binding = 7) buffer Blocks { uvec4 blocks[]; };

const int STACK = 48;
const uint NO_PIXEL = 0xffffffffu;

void camera_from_fit() {
    g_fit = fit_ok != 0u;
    g_tan = g_fit ? camera.xy : pc.tan_half;
    g_near = camera.z;
    g_up = g_fit ? world_up.xyz : vec3(0.0, 1.0, 0.0);
}

uvec2 half_size() {
    return (pc.size + 1u) / 2u;
}

// View space (near-plane units) to world space (studs), and back.
vec3 world_dir(vec3 d) {
    return d.x * right.xyz + d.y * up.xyz + d.z * forward.xyz;
}

vec3 to_world(vec3 P) {
    return cam_pos.xyz + world_dir(P) * g_near;
}

vec3 to_view_space(vec3 W) {
    vec3 r = W - cam_pos.xyz;
    return vec3(dot(r, right.xyz), dot(r, up.xyz), dot(r, forward.xyz)) / g_near;
}

vec3 tri_world(uint v) {
    return tris[TRI_VEC4 * (v / 3u) + v % 3u].xyz;
}

// The scene colour of the opaque world around `at`, as `reflected_color`
// takes it from the finished scene.
vec3 opaque_color(vec2 at, float pixels, int cell) {
    vec2 inv = 1.0 / vec2(pc.size);
    if (pc.roughness <= 0.0) {
        return textureLod(opaque_tex, at * inv, 0.0).rgb;
    }
    float radius = min(pc.roughness * (1.0 + 0.06 * pixels), 32.0);
    vec3 c = vec3(0.0);
    for (int i = 0; i < 4; ++i) {
        float a = 0.3926991 * float(cell) + 1.5707963 * float(i);
        float r = radius * (i % 2 == 0 ? 0.5 : 1.0);
        c += textureLod(opaque_tex, (at + r * vec2(cos(a), sin(a))) * inv, 0.0).rgb;
    }
    return 0.25 * c;
}

// Moller-Trumbore, both faces: t (or -1) and the barycentrics of B and C.
float hit_triangle(vec3 O, vec3 D, uint tri, float t_min, out vec2 uv) {
    vec3 A = tri_world(3u * tri), B = tri_world(3u * tri + 1u), C = tri_world(3u * tri + 2u);
    vec3 e1 = B - A, e2 = C - A;
    vec3 q = cross(D, e2);
    float det = dot(e1, q);
    uv = vec2(0.0);
    if (abs(det) < 1e-20) {
        return -1.0;
    }
    float inv = 1.0 / det;
    vec3 s = O - A;
    float u = dot(s, q) * inv;
    if (u < 0.0 || u > 1.0) {
        return -1.0;
    }
    vec3 r = cross(s, e1);
    float v = dot(D, r) * inv;
    if (v < 0.0 || u + v > 1.0) {
        return -1.0;
    }
    uv = vec2(u, v);
    float t = dot(e2, r) * inv;
    return t > t_min ? t : -1.0;
}

// Entry distance into a box, or a value above `best` for a miss.
float hit_box(vec3 O, vec3 inv_d, vec3 lo, vec3 hi, float best) {
    vec3 a = (lo - O) * inv_d, b = (hi - O) * inv_d;
    vec3 near = min(a, b), far = max(a, b);
    float t0 = max(max(near.x, near.y), max(near.z, 0.0));
    float t1 = min(min(far.x, far.y), far.z);
    return t0 <= t1 && t0 < best ? t0 : 3.4e38;
}

// The nearest hit along O + t D for t in (t_min, t_max): t, the triangle
// and the barycentrics there, or t = -1.
float trace_ray(vec3 O, vec3 D, float t_min, float t_max, out uint tri_hit, out vec2 uv_hit) {
    tri_hit = 0u;
    uv_hit = vec2(0.0);
    uint m = leaves;
    float best = t_max;
    bool found = false;
    vec2 uv;
    if (m == 0u) {
        return -1.0;
    }
    if (m == 1u) {
        tri_hit = sorted[0].y;
        float t = hit_triangle(O, D, tri_hit, t_min, uv_hit);
        return t > 0.0 && t < best ? t : -1.0;
    }
    vec3 inv_d = 1.0 / mix(D, vec3(1e-30), equal(D, vec3(0.0)));
    int stack[STACK];
    int sp = 0;
    int node = 0;
    for (int guard = 0; guard < 4096; ++guard) {
        vec4 l0 = nodes[4 * node], l1 = nodes[4 * node + 1];
        vec4 r0 = nodes[4 * node + 2], r1 = nodes[4 * node + 3];
        int left = floatBitsToInt(l0.w), right = floatBitsToInt(r0.w);
        float tl = hit_box(O, inv_d, l0.xyz, l1.xyz, best);
        float tr = hit_box(O, inv_d, r0.xyz, r1.xyz, best);
        int next_node = -1;
        // Leaves are tested at once; nodes are visited nearer first.
        if (tl < best && left < 0) {
            uint tri = sorted[~left].y;
            float t = hit_triangle(O, D, tri, t_min, uv);
            if (t > 0.0 && t < best) {
                best = t;
                tri_hit = tri;
                uv_hit = uv;
                found = true;
            }
            tl = 3.4e38;
        }
        if (tr < best && right < 0) {
            uint tri = sorted[~right].y;
            float t = hit_triangle(O, D, tri, t_min, uv);
            if (t > 0.0 && t < best) {
                best = t;
                tri_hit = tri;
                uv_hit = uv;
                found = true;
            }
            tr = 3.4e38;
        }
        bool go_l = tl < best, go_r = tr < best;
        if (go_l && go_r) {
            int far_node = tl <= tr ? right : left;
            next_node = tl <= tr ? left : right;
            if (sp < STACK) {
                stack[sp++] = far_node;
            }
        } else if (go_l) {
            next_node = left;
        } else if (go_r) {
            next_node = right;
        }
        if (next_node < 0) {
            if (sp == 0) {
                break;
            }
            next_node = stack[--sp];
        }
        node = next_node;
    }
    return found ? best : -1.0;
}

// The place of texture `serial` among this frame's, or -1.
int texture_place(uint serial) {
    for (uint i = 0u; i < 4u; ++i) {
        uvec2 e = tex_map[(serial + i) & 1023u];
        if (e.x == serial) {
            return int(e.y) - 1;
        }
        if (e.x == 0u) {
            break;
        }
    }
    return -1;
}

// The hit triangle's own colour at the hit, as the engine's fragment shader
// makes its base colour: the colour its vertex shader passed on,
// interpolated, times its texture where it has one this frame (all three
// channels, or a grey detail texture's one twice over). The engine's
// fragment shaders take it as gamma-encoded (they square it, light in
// linear and take the square root at the end), so as it is, it is the
// part's colour under a light of 1. `t` is the ray's length, in studs, for
// the texture's level of detail.
vec3 hit_colour(uint tri, vec2 uv, float t) {
    uint at = TRI_VEC4 * tri;
    vec3 ca = unpackUnorm4x8(floatBitsToUint(tris[at].w)).rgb;
    vec3 cb = unpackUnorm4x8(floatBitsToUint(tris[at + 1u].w)).rgb;
    vec3 cc = unpackUnorm4x8(floatBitsToUint(tris[at + 2u].w)).rgb;
    vec3 bary = vec3(1.0 - uv.x - uv.y, uv.x, uv.y);
    vec3 c = ca * bary.x + cb * bary.y + cc * bary.z;
    vec4 t01 = tris[at + 3u], t2 = tris[at + 4u];
    uint code = floatBitsToUint(t2.z);
    uint mode = code >> 30;
    if (mode != 0u) {
        int place = texture_place(code & 0x3fffffffu);
        vec2 st = t01.xy * bary.x + t01.zw * bary.y + t2.xy * bary.z;
        if (place >= 0 && !any(isnan(st)) && !any(isinf(st))) {
            float lod = clamp(log2(max(t, 1.0)) - 1.0, 0.0, 8.0);
            vec4 tex = textureLod(textures[nonuniformEXT(place)], st, lod);
            c *= mode == 1u ? tex.rgb : vec3(2.0 * tex.x);
        }
    }
    return any(isnan(c)) ? vec3(0.5) : clamp(c, 0.0, 1.0);
}

const float NORMAL_REACH = 48.0;
// Pixels a frame that may trace their own ray (see the upsample).
const uint FULL_RATE_MAX = 65536u;

// The pixel's own triangle's normal, from the normals the engine's vertex
// shader gave its corners, at the point a ray from the camera meets it:
// smooth where the engine shades smoothly. N (the depth's) where the ray
// meets no triangle at the depth's distance, the triangle carries no
// normals, or they turn more than 60 degrees from N.
vec3 rt_normal(vec3 P, vec3 N) {
    float dist = length(P) * g_near;
    // Further away a triangle covers a few pixels and the evened-out normal
    // is as good, for no ray.
    if (dist > NORMAL_REACH) {
        return N;
    }
    vec3 D = normalize(world_dir(P));
    uint tri;
    vec2 uv;
    float t = trace_ray(cam_pos.xyz, D, 0.5 * g_near, dist * 1.03, tri, uv);
    if (t < 0.0 || abs(t - dist) > 0.015 * dist) {
        return N;
    }
    uvec4 packed = floatBitsToUint(tris[TRI_VEC4 * tri + 5u]);
    if (packed.w == 0u) {
        return N;
    }
    vec3 n = unpackSnorm4x8(packed.x).xyz * (1.0 - uv.x - uv.y) + unpackSnorm4x8(packed.y).xyz * uv.x
        + unpackSnorm4x8(packed.z).xyz * uv.y;
    if (dot(n, n) < 1e-6) {
        return N;
    }
    n = normalize(vec3(dot(n, right.xyz), dot(n, up.xyz), dot(n, forward.xyz)));
    n = dot(n, P) > 0.0 ? -n : n;
    return dot(n, N) > 0.5 ? n : N;
}

// The hit triangle's normal in the world at the hit, facing the ray's
// start: its vertex normals interpolated where it has them, else its own.
vec3 hit_normal(uint tri, vec2 uv, vec3 dir) {
    uvec4 packed = floatBitsToUint(tris[TRI_VEC4 * tri + 5u]);
    vec3 n;
    if (packed.w != 0u) {
        n = unpackSnorm4x8(packed.x).xyz * (1.0 - uv.x - uv.y) + unpackSnorm4x8(packed.y).xyz * uv.x
            + unpackSnorm4x8(packed.z).xyz * uv.y;
    } else {
        vec3 A = tri_world(3u * tri), B = tri_world(3u * tri + 1u), C = tri_world(3u * tri + 2u);
        n = cross(B - A, C - A);
    }
    n = dot(n, n) > 1e-12 ? normalize(n) : -dir;
    return dot(n, dir) > 0.0 ? -n : n;
}

vec4 reflection_rt(ivec2 p, vec3 P, vec3 N, float wet) {
    vec3 V = normalize(P);
    float cos_v = clamp(dot(-V, N), 0.0, 1.0);
    float schlick = 0.04 + 0.96 * pow(1.0 - cos_v, 5.0);
    float w = pc.intensity * mix(1.0, schlick, pc.fresnel) * wet * smoothstep(GRAZING_LO, GRAZING_HI, cos_v);
    if (w < 1.0 / 1024.0 || !g_fit) {
        return vec4(0.0);
    }
    vec3 R = reflect(V, N);
    bool opaque = (pc.flags & 4u) != 0u;
    // Off the surface a little, so the ray does not find the triangle the
    // pixel lies on; the depth it came from is only so precise. In world
    // space, studs.
    vec3 O = to_world(P + N * (0.002 * P.z));
    vec3 Rw = normalize(world_dir(R));
    float scale = g_near;
    float t_max = pc.max_distance > 0.0 ? pc.max_distance * length(P) * scale : 3.0e38;
    uint tri;
    vec2 uv;
    float t = trace_ray(O, Rw, 0.002 * P.z * scale, t_max, tri, uv);
    int k = cell(p);
    if (t < 0.0) {
        // Nothing in the way: the sky, where its vanishing point is on the
        // screen and the screen shows sky there.
        // Nothing in the way: the sky in that direction, where the screen
        // shows it now (the ray's vanishing point on the screen, through an
        // opening), else as the screen showed it before.
        if (opaque && R.z > 1e-4) {
            vec2 s1 = to_pixel(R);
            if (all(greaterThanEqual(s1, vec2(0.5))) && all(lessThan(s1, vec2(pc.size) - 0.5)) && depth_at(ivec2(s1)) <= 0.0) {
                return vec4(opaque_color(s1, length(s1 - vec2(p)), k) * w, w);
            }
        }
        vec4 env = environment(Rw);
        return vec4(env.rgb * w * env.a, w * env.a);
    }
    vec3 H = to_view_space(O + Rw * t);
    vec3 own = hit_colour(tri, uv, t);
    // The screen's colour of the hit, where the screen shows it, and how
    // sure that is: fading out over the last 4% of the screen towards its
    // edges and as the depth there moves away from the hit's, so the two
    // colours meet without a seam.
    vec3 screen = vec3(0.0);
    float on_screen = 0.0;
    if (opaque && H.z > 1e-3) {
        vec2 at = to_pixel(H);
        if (all(greaterThanEqual(at, vec2(0.5))) && all(lessThan(at, vec2(pc.size) - 0.5))) {
            float ds = depth_at(ivec2(at));
            float zs = ds > 0.0 ? 1.0 / ds : 3.0e38;
            float gap = abs(H.z - zs) / H.z;
            vec2 margin = min(at, vec2(pc.size) - at) / (0.04 * float(min(pc.size.x, pc.size.y)));
            on_screen = (1.0 - smoothstep(0.01, 0.03, gap)) * smoothstep(0.0, 1.0, clamp(min(margin.x, margin.y), 0.0, 1.0));
            if (on_screen > 0.0) {
                screen = opaque_color(at, length(at - vec2(p)), k);
            }
        }
    }
    if (on_screen > 0.99) {
        // A sample of what the engine's light makes of the bare colour.
        if ((((p.x >> 1) ^ (p.y >> 1)) & 7) == 0) {
            const vec3 L = vec3(0.2126, 0.7152, 0.0722);
            atomicAdd(lit_screen, uint(dot(clamp(screen, 0.0, 1.0), L) * 256.0));
            atomicAdd(lit_colour, uint(dot(own, L) * 256.0));
        }
    }
    if ((pc.flags & 768u) == 768u) {
        // Lit (flags bit 9, with the engine's light bound, bit 8): the hit's
        // colour lit as the engine's shaders light it, in linear (the
        // colour squared), with the sun where a ray towards it is free, and
        // back through the engine's exposure and square root.
        vec3 Hw = O + Rw * t;
        vec3 n = hit_normal(tri, uv, Rw);
        vec3 to_sun = -frame_block[16].xyz;
        float sun = max(dot(n, to_sun), 0.0);
        if (sun > 0.0) {
            uint st;
            vec2 su;
            if (trace_ray(Hw + n * 0.05, normalize(to_sun), 0.01, 2048.0, st, su) > 0.0) {
                sun = 0.0;
            }
        }
        vec3 pos = n * n * vec3(greaterThanEqual(n, vec3(0.0)));
        vec3 neg = n * n - pos;
        vec3 ambient = frame_block[32].xyz + frame_block[33].xyz;
        for (int i = 0; i < 3; ++i) {
            ambient += (frame_block[40 + 2 * i].xyz + frame_block[34 + 2 * i].xyz) * pos[i]
                + (frame_block[41 + 2 * i].xyz + frame_block[35 + 2 * i].xyz) * neg[i];
        }
        vec3 light = ambient + frame_block[15].xyz * sun + frame_block[17].xyz * max(-dot(n, to_sun), 0.0);
        own = sqrt(clamp(own * own * light * frame_block[20].y, 0.0, 1.0));
    } else {
        own *= exposure > 0.0 ? exposure : 1.0;
    }
    // Flags bit 3: the screen's colour wherever it shows the hit (the first
    // way, kept to compare); bit 4: a quarter of it; neither: the hit's own
    // colour only, so a reflection shows the side of a thing it faces.
    float screen_share = (pc.flags & 8u) != 0u ? 1.0 : (pc.flags & 16u) != 0u ? 0.25 : 0.0;
    vec3 c = mix(own, screen, screen_share * on_screen);
    float sure = 1.0;
    // A ray that ends somewhere fades out over the last 40% of it.
    if (pc.max_distance > 0.0) {
        sure *= 1.0 - smoothstep(0.6, 1.0, t / t_max);
    }
    w = clamp(w * sure, 0.0, 1.0);
    return vec4(c * w, w);
}

// Which normal a pixel's ray left with: 0 the depth's, 1 the depth's evened
// out over its neighbours, 2 its triangle's vertex normals. Set by
// `surface_normal`.
float g_source;

// The normal a reflecting pixel's ray leaves with: its triangle's vertex
// normals where found, else the depth's evened out (see `smoothed`).
vec3 surface_normal(ivec2 p, vec3 P, vec3 N) {
    vec3 s = smoothed(p, P, N);
    vec3 n = rt_normal(P, s);
    g_source = n != s ? 2.0 : (dot(s, N) < 0.9999 ? 1.0 : 0.0);
    return n;
}

// Flags bits 6 and 7: a debug view in place of the reflection: 1 the normal
// (x, y, z as red, green, blue), 2 where it came from (red the depth's,
// yellow evened out, green the vertex normals).
vec4 debug_view(vec3 n) {
    uint view = (pc.flags >> 6) & 3u;
    if (view == 1u) {
        return vec4(n * 0.5 + 0.5, 1.0);
    }
    return vec4(g_source > 1.5 ? vec3(0.0, 1.0, 0.0) : g_source > 0.5 ? vec3(1.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0), 1.0);
}

// The pixel of block `b` its ray leaves from: the first of (0, 0), (1, 1),
// (1, 0), (0, 1) in it that is on the screen and not sky.
uint leader(ivec2 b) {
    const ivec2 order[4] = ivec2[4](ivec2(0, 0), ivec2(1, 1), ivec2(1, 0), ivec2(0, 1));
    for (int i = 0; i < 4; ++i) {
        ivec2 q = 2 * b + order[i];
        if (all(lessThan(uvec2(q), pc.size)) && depth_at(q) > 0.0) {
            return uint(q.x) | (uint(q.y) << 16);
        }
    }
    return NO_PIXEL;
}

#endif

#if defined(RT) && defined(ENVMAP)

// The environment pass (`-DRT -DENVMAP`): a quarter of the pixels each
// frame, in turn; where the opaque copy shows sky, its colour into the
// environment at that world direction, blended over what was there.
void main() {
    camera_from_fit();
    if (!g_fit || (pc.flags & 4u) == 0u || (pc.flags & 32u) != 0u) {
        return;
    }
    ivec2 p = 2 * ivec2(gl_GlobalInvocationID.xy) + ivec2(frame & 1u, (frame >> 1) & 1u);
    if (any(greaterThanEqual(uvec2(p), pc.size)) || depth_at(p) > 0.0) {
        return;
    }
    vec3 c = texelFetch(opaque_tex, p, 0).rgb;
    vec3 d = normalize(world_dir(view_pos(vec2(p) + 0.5, 1.0)));
    uint t = env_texel(d);
    uvec4 e = env[t];
    vec2 bw = unpackHalf2x16(e.y);
    float w = e.z == gen ? bw.y : 0.0;
    vec3 now = w > 0.0 ? mix(vec3(unpackHalf2x16(e.x), bw.x), c, 0.1) : c;
    env[t] = uvec4(packHalf2x16(now.rg), packHalf2x16(vec2(now.b, min(w + 1.0, 1000.0))), gen, 0u);
    if (((p.x ^ p.y) & 15) == 0) {
        atomicAdd(sky_r, uint(clamp(c.r, 0.0, 1.0) * 256.0));
        atomicAdd(sky_g, uint(clamp(c.g, 0.0, 1.0) * 256.0));
        atomicAdd(sky_b, uint(clamp(c.b, 0.0, 1.0) * 256.0));
        atomicAdd(sky_n, 1u);
    }
}

#elif defined(RT) && !defined(UPSAMPLE)

// How much of a block's last result is kept when its pixel is where it was.
const float HISTORY = 0.6;

void main() {
    camera_from_fit();
    ivec2 b = ivec2(gl_GlobalInvocationID.xy);
    uvec2 hs = half_size();
    if (any(greaterThanEqual(uvec2(b), hs))) {
        return;
    }
    vec4 r = vec4(0.0);
    uint from = leader(b);
    float d = 0.0;
    // Whether the block lies on a curved mesh: its triangle's vertex normal
    // turns from the depth's flat one. Kept as the stored depth's sign, for
    // the upsample.
    bool curved = false;
    if (from != NO_PIXEL) {
        ivec2 p = ivec2(from & 0xffffu, from >> 16);
        d = depth_at(p);
        vec3 P = view_pos(vec2(p) + 0.5, d);
        vec3 N = surface_at(p, P).n;
        float wet = N == vec3(0.0) ? 0.0 : wetness(N);
        if (N != vec3(0.0)) {
            vec3 n = surface_normal(p, P, N);
            curved = g_source > 1.5 && dot(n, N) < 0.9995;
            if (((pc.flags >> 6) & 3u) != 0u) {
                r = debug_view(n);
            } else if (wet > 0.0) {
                r = reflection_rt(p, P, n, wet);
            }
        }
    }
    uint i = uint(b.y) * hs.x + uint(b.x);
    uvec4 last = blocks[i];
    float last_d = abs(uintBitsToFloat(last.w));
    // The last frame's result is kept only to steady noise: where the pixel
    // is where it was, not on a curved mesh, and what it reflects has not
    // changed (a moving head reflected in a still shoulder, or anything
    // that moved, would lag behind and jump).
    if (from != NO_PIXEL && !curved && last.z == from && abs(last_d - d) <= 0.001 * d) {
        vec4 h = vec4(unpackHalf2x16(last.x), unpackHalf2x16(last.y));
        vec4 diff = abs(h - r);
        if (!any(isnan(h)) && !any(isinf(h)) && max(max(diff.r, diff.g), max(diff.b, diff.a)) < 0.08) {
            r = mix(r, h, HISTORY);
        }
    }
    blocks[i] = uvec4(packHalf2x16(r.rg), packHalf2x16(r.ba), from, floatBitsToUint(curved ? -d : d));
}

#else

void main() {
#ifdef UPSAMPLE
    camera_from_fit();
#endif
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(uvec2(p), pc.size))) {
        return;
    }
    vec4 r = vec4(0.0);
    float d = depth_at(p);
    if (d > 0.0) {
        vec3 P = view_pos(vec2(p) + 0.5, d);
        vec3 N = surface_at(p, P).n;
        float wet = N == vec3(0.0) ? 0.0 : wetness(N);
#ifdef UPSAMPLE
        if (N != vec3(0.0) && ((pc.flags >> 6) & 3u) != 0u) {
            wet = 1.0;
        }
#endif
        if (wet > 0.0) {
#ifdef UPSAMPLE
            // The rays of the blocks around that left from this pixel's
            // plane, by a tent over three pixels of distance.
            uvec2 hs = half_size();
            ivec2 b0 = p / 2;
            vec4 samples[9];
            float ks[9];
            float weights = 0.0, mean = 0.0;
            for (int n = 0; n < 9; ++n) {
                ks[n] = 0.0;
                samples[n] = vec4(0.0);
                ivec2 b = b0 + ivec2(n % 3 - 1, n / 3 - 1);
                if (any(greaterThanEqual(uvec2(b), hs))) {
                    continue;
                }
                uvec4 e = blocks[uint(b.y) * hs.x + uint(b.x)];
                if (e.z == NO_PIXEL) {
                    continue;
                }
                ivec2 q = ivec2(e.z & 0xffffu, e.z >> 16);
                vec3 Q = view_pos(vec2(q) + 0.5, depth_at(q));
                float off_plane = abs(dot(N, Q - P)) / P.z;
                float k = (1.0 - smoothstep(0.004, 0.02, off_plane)) * max(1.0 - length(vec2(q - p)) / 3.0, 0.0);
                if (k > 0.0) {
                    samples[n] = vec4(unpackHalf2x16(e.x), unpackHalf2x16(e.y));
                    ks[n] = k;
                    weights += k;
                    mean += k * dot(samples[n].rgb, vec3(0.2126, 0.7152, 0.0722));
                }
            }
            // Near the camera (within 24 studs) on a curved mesh (its block's
            // triangle has vertex normals that turn from the flat one, such
            // as a head), or on a clearly curved depth (neighbours' normals
            // turning more than about 5 degrees), the pixel traces its own
            // ray instead: a 2 by 2 block is too coarse there. At most
            // FULL_RATE_MAX pixels a frame.
            if (P.z * g_near < 24.0 && g_fit) {
                uvec4 own = blocks[uint(b0.y) * hs.x + uint(b0.x)];
                bool curved = uintBitsToFloat(own.w) < 0.0 || dot(smoothed(p, P, N), N) < 0.996;
                if (curved && atomicAdd(full_rate, 1u) < FULL_RATE_MAX) {
                    vec3 n = surface_normal(p, P, N);
                    imageStore(trace_img, p, ((pc.flags >> 6) & 3u) != 0u ? debug_view(n) : reflection_rt(p, P, n, wet));
                    return;
                }
            }
            if (weights > 1e-3) {
                // A ray that slipped through a gap the others did not (a
                // lattice, a thin pole) is held to twice its neighbours'
                // brightness, so it does not show as a flickering speck.
                float cap = 2.0 * mean / weights + 0.02;
                vec4 sum = vec4(0.0);
                for (int n = 0; n < 9; ++n) {
                    float l = dot(samples[n].rgb, vec3(0.2126, 0.7152, 0.0722));
                    vec4 v = samples[n];
                    if (l > cap) {
                        v.rgb *= cap / l;
                    }
                    sum += ks[n] * v;
                }
                r = sum / weights;
            }

#else
            r = reflection(p, P, smoothed(p, P, N), wet);
#endif
        }
    }
    imageStore(trace_img, p, r);
}

