// The acceleration structure of the ray-traced reflections (see `trace.rs`),
// built on the GPU every frame from the triangles transform feedback
// captured (`capture.rs`): a bounding volume hierarchy over them, sorted
// along a Morton curve (a linear BVH). The driver offers no hardware
// acceleration structures on this GPU, so this is the software stand-in.
// One source, six stages:
//
//     -DFIT           the camera's real projection, from the capture
//     -DPREP          a key per triangle: the Morton code of its centre,
//                     or ~0 for one that is not real geometry
//     -DSORT_LOCAL    bitonic sort, the steps that stay within 1024 keys
//     -DSORT_GLOBAL   bitonic sort, one step across blocks
//     -DBUILD         the hierarchy from the sorted keys (Karras 2012)
//     -DBOUNDS        each node's two child boxes, from the leaves up
//
// Built by build.rs with the system's glslc, else taken from the committed
// files beside this one:
//
//     glslc -O --target-env=vulkan1.0 -mfmt=num -D<STAGE> build.comp -o -
//         -> build_<stage>.spv.rs
//
// Positions are clip-space as captured. They are turned into view space (x
// right, y up, z away from the camera, in units of the near plane), the
// space `ssr/ssr.comp` with RT turns the depth buffer into: with reversed-Z
// and the far plane at infinity, clip z is the near plane and clip w the
// distance, so (x tan_x, -y tan_y, w) / near. tan_x, tan_y and the near
// plane are not guessed (the reflections' fov knob) but measured every
// frame by FIT: each captured vertex also carries the vector from it to the
// camera in the world, in studs and with true angles, and clip x, y and w
// are linear in it (clip = M (vertex - camera) for the rows x, y and w), so
// M is a least-squares fit over a few thousand vertices; its rows are the
// camera's right, up and forward axes scaled by 1 / tan_x, 1 / tan_y and 1.
// The fit also gives which way is up in the world, in view space. FIT also
// turns the trace's last sums into the exposure (see Globals).

#version 450

#ifdef SORT_LOCAL
layout(local_size_x = 512) in;
#elif defined(FIT)
layout(local_size_x = 128) in;
#else
layout(local_size_x = 256) in;
#endif

// Per captured vertex: the clip-space position, the colour, the vector to
// the camera (xyz).
layout(std430, binding = 0) readonly buffer Xfb { vec4 xfb[]; };
layout(std430, binding = 1) readonly buffer Counter { uint counter_bytes; };
layout(std430, binding = 2) buffer Sorted { uvec2 sorted[]; };
layout(std430, binding = 3) coherent buffer Nodes { vec4 nodes[]; };
layout(std430, binding = 4) buffer Parents { int parents[]; };
layout(std430, binding = 5) buffer Flags { uint flags[]; };
layout(std430, binding = 6) buffer Globals {
    // Triangles that are leaves (real geometry), and those captured.
    uint leaves;
    uint captured;
    // FIT: 1 when it found the projection, and the vertices it used.
    uint fit_ok;
    uint fit_samples;
    // tan_x, tan_y, the near plane, |forward| (1 for a true projection).
    vec4 camera;
    // The world's up in view space.
    vec4 world_up;
    // The trace's sums, over a sample of its hits that the screen shows, of
    // the brightness of the screen there and of the hit triangle's own
    // colour (both times 256), and from them, frame by frame, how much
    // brighter the screen is than the bare colour: the light the engine
    // gives an off-screen hit, on average. Kept from frame to frame.
    uint lit_screen;
    uint lit_colour;
    float exposure;
    uint unused;
};

// std430; `trace::BuildParams` mirrors it.
layout(push_constant) uniform Params {
    // Keys sorted: a power of two at least the triangles used.
    uint n;
    // Triangles our capture buffer holds.
    uint cap;
    // The bitonic stage and step.
    uint k;
    uint j;
    vec2 tan_half;
} pc;

vec3 to_view(vec4 c) {
    if (fit_ok != 0u) {
        return vec3(c.x * camera.x, -c.y * camera.y, c.w) / camera.z;
    }
    return vec3(c.x * pc.tan_half.x, -c.y * pc.tan_half.y, c.w) / c.z;
}

vec4 position(uint v) {
    return xfb[3u * v];
}

bool usable(vec4 c) {
    return c.z > 0.0 && c.w > 0.0 && !any(isnan(c)) && !any(isinf(c));
}

#ifdef FIT

const uint FIT_THREADS = 128u;
const uint FIT_SAMPLES = 4096u;

// Per thread: the normal matrix (6), the three right-hand sides (9), the
// sum of clip z and the count.
shared float red[17][FIT_THREADS];

void main() {
    uint t = gl_LocalInvocationID.x;
    uint vertices = 3u * min(counter_bytes / 144u, pc.cap);
    uint step_ = max(1u, vertices / FIT_SAMPLES);
    float a[17];
    for (int i = 0; i < 17; ++i) {
        a[i] = 0.0;
    }
    for (uint k = t; k < FIT_SAMPLES && k * step_ < vertices; k += FIT_THREADS) {
        uint v = k * step_;
        vec4 c = xfb[3u * v];
        vec3 p = -xfb[3u * v + 2u].xyz;
        float l = length(p);
        if (!usable(c) || !(l > 1e-3) || isinf(l)) {
            continue;
        }
        // Each vertex scaled to unit distance, so near and far weigh alike.
        vec3 u = p / l;
        vec4 q = c / l;
        a[0] += u.x * u.x; a[1] += u.x * u.y; a[2] += u.x * u.z;
        a[3] += u.y * u.y; a[4] += u.y * u.z; a[5] += u.z * u.z;
        a[6] += u.x * q.x; a[7] += u.y * q.x; a[8] += u.z * q.x;
        a[9] += u.x * q.y; a[10] += u.y * q.y; a[11] += u.z * q.y;
        a[12] += u.x * q.w; a[13] += u.y * q.w; a[14] += u.z * q.w;
        a[15] += c.z;
        a[16] += 1.0;
    }
    for (int i = 0; i < 17; ++i) {
        red[i][t] = a[i];
    }
    barrier();
    for (uint s = FIT_THREADS / 2u; s > 0u; s >>= 1) {
        if (t < s) {
            for (int i = 0; i < 17; ++i) {
                red[i][t] += red[i][t + s];
            }
        }
        barrier();
    }
    if (t != 0u) {
        return;
    }
    if (lit_colour > 256u * 64u) {
        float ratio = clamp(float(lit_screen) / float(lit_colour), 0.1, 2.0);
        exposure = exposure > 0.0 ? mix(exposure, ratio, 0.1) : ratio;
    }
    lit_screen = 0u;
    lit_colour = 0u;
    float n = red[16][0];
    fit_samples = uint(n);
    fit_ok = 0u;
    if (n < 64.0) {
        return;
    }
    mat3 A = mat3(red[0][0], red[1][0], red[2][0],
                  red[1][0], red[3][0], red[4][0],
                  red[2][0], red[4][0], red[5][0]);
    if (abs(determinant(A)) < 1e-6 * n * n * n) {
        return;
    }
    mat3 inv = inverse(A);
    vec3 mx = inv * vec3(red[6][0], red[7][0], red[8][0]);
    vec3 my = inv * vec3(red[9][0], red[10][0], red[11][0]);
    vec3 mw = inv * vec3(red[12][0], red[13][0], red[14][0]);
    float lw = length(mw);
    vec2 tan_xy = vec2(lw / length(mx), lw / length(my));
    float near = red[15][0] / n;
    if (any(isnan(vec4(tan_xy, near, lw))) || any(lessThan(tan_xy, vec2(0.02))) || any(greaterThan(tan_xy, vec2(50.0)))
        || !(near > 0.0) || abs(lw - 1.0) > 0.05) {
        return;
    }
    // The camera's axes in the world: right, up (clip y is flipped), forward.
    vec3 right = mx / length(mx), up = -my / length(my), forward = mw / lw;
    camera = vec4(tan_xy, near, lw);
    world_up = vec4(normalize(vec3(right.y, up.y, forward.y)), 0.0);
    fit_ok = 1u;
}

#endif

#ifdef PREP

uint spread(uint v) {
    v = (v | (v << 16)) & 0x030000FFu;
    v = (v | (v << 8)) & 0x0300F00Fu;
    v = (v | (v << 4)) & 0x030C30C3u;
    v = (v | (v << 2)) & 0x09249249u;
    return v;
}

// A logarithmic warp around the camera before quantising: fine near it,
// coarse far away, so the character and what is near it are sorted finely
// whatever else the scene holds.
uint cell(float x) {
    float f = sign(x) * log2(1.0 + abs(x));
    return uint(clamp((f + 24.0) / 48.0 * 1024.0, 0.0, 1023.0));
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) {
        return;
    }
    uint total = min(counter_bytes / 144u, min(pc.cap, pc.n));
    uint key = 0xffffffffu;
    if (i < total) {
        vec4 a = position(3u * i), b = position(3u * i + 1u), c = position(3u * i + 2u);
        if (usable(a) && usable(b) && usable(c)) {
            vec3 A = to_view(a), B = to_view(b), C = to_view(c);
            vec3 n = cross(B - A, C - A);
            if (dot(n, n) > 0.0 && !any(isinf(n))) {
                vec3 m = (A + B + C) / 3.0;
                key = (spread(cell(m.x)) << 2) | (spread(cell(m.y)) << 1) | spread(cell(m.z));
                atomicAdd(leaves, 1u);
            }
        }
    }
    sorted[i] = uvec2(key, i);
    if (i == 0u) {
        captured = total;
    }
}

#endif

#if defined(SORT_LOCAL) || defined(SORT_GLOBAL)

bool after(uvec2 a, uvec2 b) {
    return a.x > b.x || (a.x == b.x && a.y > b.y);
}

#endif

#ifdef SORT_LOCAL

shared uvec2 block[1024];

void step_(uint base, uint k, uint j) {
    uint t = gl_LocalInvocationID.x;
    uint i = 2u * j * (t / j) + (t % j);
    uint l = i + j;
    bool up = ((base + i) & k) == 0u;
    uvec2 a = block[i], b = block[l];
    if (after(a, b) == up) {
        block[i] = b;
        block[l] = a;
    }
    memoryBarrierShared();
    barrier();
}

void main() {
    uint base = gl_WorkGroupID.x * 1024u;
    uint t = gl_LocalInvocationID.x;
    block[t] = sorted[base + t];
    block[t + 512u] = sorted[base + t + 512u];
    memoryBarrierShared();
    barrier();
    if (pc.k == 0u) {
        for (uint k = 2u; k <= 1024u; k <<= 1) {
            for (uint j = k >> 1; j > 0u; j >>= 1) {
                step_(base, k, j);
            }
        }
    } else {
        for (uint j = 512u; j > 0u; j >>= 1) {
            step_(base, pc.k, j);
        }
    }
    sorted[base + t] = block[t];
    sorted[base + t + 512u] = block[t + 512u];
}

#endif

#ifdef SORT_GLOBAL

void main() {
    uint t = gl_GlobalInvocationID.x;
    if (t >= pc.n / 2u) {
        return;
    }
    uint i = 2u * pc.j * (t / pc.j) + (t % pc.j);
    uint l = i + pc.j;
    bool up = (i & pc.k) == 0u;
    uvec2 a = sorted[i], b = sorted[l];
    if (after(a, b) == up) {
        sorted[i] = b;
        sorted[l] = a;
    }
}

#endif

#ifdef BUILD

int m;

// The length of the common prefix of keys i and j, the index breaking ties;
// -1 outside the leaves.
int delta(int i, int j) {
    if (j < 0 || j >= m) {
        return -1;
    }
    uint a = sorted[i].x, b = sorted[j].x;
    if (a == b) {
        return 32 + (31 - findMSB(uint(i ^ j)));
    }
    return 31 - findMSB(a ^ b);
}

void main() {
    m = int(leaves);
    int i = int(gl_GlobalInvocationID.x);
    if (i >= m - 1) {
        return;
    }
    int d = delta(i, i + 1) - delta(i, i - 1) >= 0 ? 1 : -1;
    int dmin = delta(i, i - d);
    int lmax = 2;
    while (delta(i, i + lmax * d) > dmin) {
        lmax <<= 1;
    }
    int l = 0;
    for (int t = lmax >> 1; t >= 1; t >>= 1) {
        if (delta(i, i + (l + t) * d) > dmin) {
            l += t;
        }
    }
    int j = i + l * d;
    int dnode = delta(i, j);
    int s = 0;
    int t = l;
    do {
        t = (t + 1) >> 1;
        if (delta(i, i + (s + t) * d) > dnode) {
            s += t;
        }
    } while (t > 1);
    int gamma = i + s * d + min(d, 0);
    // A leaf is ~its index, a node its index.
    int left = min(i, j) == gamma ? ~gamma : gamma;
    int right = max(i, j) == gamma + 1 ? ~(gamma + 1) : gamma + 1;
    nodes[4 * i].w = intBitsToFloat(left);
    nodes[4 * i + 2].w = intBitsToFloat(right);
    if (left < 0) {
        parents[int(pc.n) + ~left] = i;
    } else {
        parents[left] = i;
    }
    if (right < 0) {
        parents[int(pc.n) + ~right] = i;
    } else {
        parents[right] = i;
    }
    if (i == 0) {
        parents[0] = -1;
    }
}

#endif

#ifdef BOUNDS

void main() {
    int m = int(leaves);
    int leaf = int(gl_GlobalInvocationID.x);
    if (leaf >= m || m < 2) {
        return;
    }
    uint tri = sorted[leaf].y;
    vec3 A = to_view(position(3u * tri)), B = to_view(position(3u * tri + 1u)), C = to_view(position(3u * tri + 2u));
    vec3 lo = min(A, min(B, C)), hi = max(A, max(B, C));
    int child = ~leaf;
    int p = parents[int(pc.n) + leaf];
    for (int guard = 0; guard < 128 && p >= 0; ++guard) {
        bool is_left = floatBitsToInt(nodes[4 * p].w) == child;
        int at = 4 * p + (is_left ? 0 : 2);
        nodes[at].xyz = lo;
        nodes[at + 1].xyz = hi;
        memoryBarrierBuffer();
        if (atomicAdd(flags[p], 1u) == 0u) {
            return;
        }
        memoryBarrierBuffer();
        lo = min(nodes[4 * p].xyz, nodes[4 * p + 2].xyz);
        hi = max(nodes[4 * p + 1].xyz, nodes[4 * p + 3].xyz);
        child = p;
        p = parents[p];
    }
}

#endif
