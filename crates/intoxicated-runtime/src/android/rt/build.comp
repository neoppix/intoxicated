// The acceleration structure of the ray-traced reflections (see `trace.rs`),
// built on the GPU every frame, in world space, from the triangles transform
// feedback captured this frame (`capture.rs`) and from a cache of the static
// triangles of earlier frames: a bounding volume hierarchy over them,
// sorted along a Morton curve (a linear BVH). The driver offers no hardware
// acceleration structures on this GPU, so this is the software stand-in.
// One source, eight stages, run in this order:
//
//     -DFIT           the camera, from this frame's capture
//     -DINSERT        this frame's triangles into the list to trace, and
//                     the static ones into the cache
//     -DGATHER        the cache's other triangles into the list, and
//                     those the view shows but the frame did not draw out
//                     of the cache
//     -DPREP          a key per listed triangle: the Morton code of its
//                     centre, or ~0 for one that is not real geometry
//     -DSORT_LOCAL    bitonic sort, the steps that stay within 1024 keys
//     -DSORT_GLOBAL   bitonic sort, one step across blocks
//     -DBUILD         the hierarchy from the sorted keys (Karras 2012)
//     -DBOUNDS        each node's two child boxes, from the leaves up
//
// Built by build.rs with the system's glslc, else taken from the committed
// files beside this one:
//
//     glslc -O --target-env=vulkan1.0 -mfmt=num -D<STAGE> build.comp -o -
//         -> build_<stage>.spv.rs
//
// Each captured vertex carries its clip-space position, its colour, the
// vector from it to the camera and its position in the world (with w 1 for
// a static part: one whose vertex shader places it by its own matrices
// alone, not by bones). FIT measures the camera: its position (a vertex's
// world position plus its camera vector, averaged) and its projection,
// since clip x, y and w are linear in the camera vector (clip = M (vertex -
// camera) for the rows x, y and w): M from a least-squares fit over a few
// thousand vertices; its rows are the camera's right, up and forward axes
// scaled by 1 / tan_x, 1 / tan_y and 1. A jump of the camera (a teleport, a
// new place) empties the cache.
//
// The cache is a hash table of static triangles keyed by their exact world
// positions: a part that does not move is drawn with the same bits every
// frame. A cached triangle is listed while the frame did not draw it, and
// dropped when the view shows where it was and the frame did not draw it
// (it moved or is gone), when it was not seen for a long while, or to make
// room, the least recently seen first.

#version 450

#ifdef SORT_LOCAL
layout(local_size_x = 512) in;
#elif defined(FIT)
layout(local_size_x = 128) in;
#else
layout(local_size_x = 256) in;
#endif

// GATHER runs with the reflections' set as set 0 (for their copy of the
// depth) and ours as set 1; every other stage with ours alone.
#ifdef GATHER
#define BUFSET 1
layout(set = 0, binding = 2, r32f) uniform readonly image2D depth_copy;
#else
#define BUFSET 0
#endif

// Per captured vertex: the clip-space position, the colour, the vector to
// the camera (xyz), the world position (xyz; w 1 when static, plus 2 when
// the normal is captured), the texture coordinates (xy) and the normal in
// the world (xyz).
layout(std430, set = BUFSET, binding = 0) readonly buffer Xfb { vec4 xfb[]; };
layout(std430, set = BUFSET, binding = 2) buffer Sorted { uvec2 sorted[]; };
layout(std430, set = BUFSET, binding = 3) coherent buffer Nodes { vec4 nodes[]; };
layout(std430, set = BUFSET, binding = 4) buffer Parents { int parents[]; };
layout(std430, set = BUFSET, binding = 5) buffer Flags { uint flags[]; };
// `trace::GLOBALS_*` names the offsets; the first 16 bytes and `dropped`,
// `full` and `inserted` are cleared every frame, the rest is kept.
layout(std430, set = BUFSET, binding = 6) buffer Globals {
    // Listed triangles that are leaves (real geometry); FIT's vertices and
    // whether it found the camera; cached triangles listed this frame.
    uint leaves;
    uint fit_samples;
    uint fit_ok;
    uint cached;
    // tan_x, tan_y, the near plane, |forward| (1 for a true projection).
    vec4 camera;
    // The world's up in view space.
    vec4 world_up;
    // The trace's sums for the exposure (see ssr.comp), the exposure, and
    // the frame number.
    uint lit_screen;
    uint lit_colour;
    float exposure;
    uint frame;
    // The camera's position and axes in the world.
    vec4 cam_pos;
    vec4 right;
    vec4 up;
    vec4 forward;
    // The cache's generation (its low 8 bits tag live entries), entries
    // dropped this frame because the view showed them gone, triangles
    // that found no room, triangles new to the cache this frame, and the
    // camera's last position (w 1 once set).
    uint gen;
    uint dropped;
    uint full;
    uint inserted;
    vec4 last_cam;
    // Listed triangles the sort had no room for this frame, and frames FIT
    // could not measure the camera in, since the start.
    uint cut;
    uint fit_failures;
    // The sky the screen showed this frame (sums of r, g, b times 256 and a
    // count, from the environment pass of ssr.comp), and on average (FIT).
    uint sky_r;
    uint sky_g;
    uint sky_b;
    uint sky_n;
    vec4 sky;
    // Pixels that traced their own ray this frame (ssr.comp's upsample).
    uint full_rate;
    // The camera the frame before: position, axes, (tan_x, tan_y, near, 1
    // when there was one), for the indirect light's reprojection.
    vec4 prev_pos;
    vec4 prev_right;
    vec4 prev_up;
    vec4 prev_forward;
    vec4 prev_camera;
};
// Triangles to trace, six vec4 each: three vertices (world xyz, the colour
// packed in w), the texture coordinates of A and B, then those of C, the
// texture code (see `capture::MODE_*`) and the source (the low bits of the
// vertex shader's hash, for dumps), then the three vertex normals packed
// (snorm 8-bit xyz) and 1 when they are real.
layout(std430, set = BUFSET, binding = 8) buffer Tris { vec4 tris[]; };
// The cache: `SLOT_WORDS` words a slot, at the `S_*` offsets.
layout(std430, set = BUFSET, binding = 9) buffer Slots { uint slots[]; };
// This frame's draws: first triangle, texture code, source, 1 when the
// pipeline blends; by first triangle.
layout(std430, set = BUFSET, binding = 10) readonly buffer Draws { uvec4 draws[]; };

// std430; `trace::BuildParams` mirrors it.
layout(push_constant) uniform Params {
    // Keys sorted: a power of two at least the triangles listed.
    uint n;
    // Triangles listed at most (the list's size).
    uint cap;
    // The bitonic stage and step.
    uint k;
    uint j;
    // This frame's captured triangles, and bit 0: the capture is whole (no
    // triangle was left out for want of room).
    uint current;
    uint flags_;
    // Slots in the cache, a power of two.
    uint slot_count;
    // The screen, width | height << 16 (GATHER).
    uint size;
    // Entries in `draws`.
    uint draw_count;
    // How far cached triangles are traced, in studs (float bits).
    uint reach_bits;
    uint pad1;
    uint pad2;
} pc;

const float JUMP = 64.0;
const uint MIN_AGE = 240u;
// Unseen for this long (about two minutes at 240 fps) and this far from the
// camera, a cached triangle is dropped; nearer ones are kept.
const uint MAX_AGE = 240u * 120u;
const float FAR = 512.0;
// Frames in a row the view must show a cached triangle's place empty before
// it is dropped, so one frame the engine skips does not drop it.
const uint MISSES = 8u;
const uint PROBES = 16u;
const uint VERTEX_VEC4 = 6u;
const uint TRI_VEC4 = 6u;
const uint SLOT_WORDS = 32u;
const uint S_TAG = 0u;
const uint S_KEY = 1u;
const uint S_SEEN = 2u;
const uint S_MISSES = 3u;
const uint S_CODE = 4u;
const uint S_SOURCE = 5u;
const uint S_BORN = 6u;
const uint S_POS = 8u;
const uint S_COL = 17u;
const uint S_UV = 20u;
const uint S_NRM = 26u;
// Frames in a row it was drawn at the same place, and whether that once
// reached `STABLE` (only such triangles are traced from the cache: a thing
// that moves, such as what a player wears, never is); frames in a row it
// was in view, hidden, and not drawn.
const uint S_STREAK = 7u;
const uint S_PROMOTED = 29u;
const uint S_HIDDEN = 30u;
// The light it was seen to give off (`ssr.comp`'s GI pass).
const uint S_EMIT = 31u;
const uint STABLE = 60u;
const uint HIDDEN_FRAMES = 240u;
// Cached triangles further than `pc.reach_bits` from the camera are not
// traced, and dropped beyond twice it.

bool usable(vec4 c) {
    return c.z > 0.0 && c.w > 0.0 && !any(isnan(c)) && !any(isinf(c));
}

uint pack_colour(vec4 c) {
    return packUnorm4x8(clamp(c, 0.0, 1.0));
}

#ifdef FIT

const uint FIT_THREADS = 128u;
const uint FIT_SAMPLES = 4096u;

// Per thread: the normal matrix (6), the three right-hand sides (9), the
// sum of clip z, the count and the camera's position (3).
shared float red[20][FIT_THREADS];

void main() {
    uint t = gl_LocalInvocationID.x;
    uint vertices = 3u * pc.current;
    uint step_ = max(1u, vertices / FIT_SAMPLES);
    float a[20];
    for (int i = 0; i < 20; ++i) {
        a[i] = 0.0;
    }
    for (uint k = t; k < FIT_SAMPLES && k * step_ < vertices; k += FIT_THREADS) {
        uint v = k * step_;
        vec4 c = xfb[VERTEX_VEC4 * v];
        vec3 V = xfb[VERTEX_VEC4 * v + 2u].xyz;
        vec3 W = xfb[VERTEX_VEC4 * v + 3u].xyz;
        vec3 p = -V;
        float l = length(p);
        if (!usable(c) || !(l > 1e-3) || isinf(l) || any(isnan(W)) || any(isinf(W))) {
            continue;
        }
        // Each vertex scaled to unit distance, so near and far weigh alike.
        vec3 u = p / l;
        vec4 q = c / l;
        a[0] += u.x * u.x; a[1] += u.x * u.y; a[2] += u.x * u.z;
        a[3] += u.y * u.y; a[4] += u.y * u.z; a[5] += u.z * u.z;
        a[6] += u.x * q.x; a[7] += u.y * q.x; a[8] += u.z * q.x;
        a[9] += u.x * q.y; a[10] += u.y * q.y; a[11] += u.z * q.y;
        a[12] += u.x * q.w; a[13] += u.y * q.w; a[14] += u.z * q.w;
        a[15] += c.z;
        a[16] += 1.0;
        vec3 cam = W + V;
        a[17] += cam.x; a[18] += cam.y; a[19] += cam.z;
    }
    for (int i = 0; i < 20; ++i) {
        red[i][t] = a[i];
    }
    barrier();
    for (uint s = FIT_THREADS / 2u; s > 0u; s >>= 1) {
        if (t < s) {
            for (int i = 0; i < 20; ++i) {
                red[i][t] += red[i][t + s];
            }
        }
        barrier();
    }
    if (t != 0u) {
        return;
    }
    frame += 1u;
    prev_pos = cam_pos;
    prev_right = right;
    prev_up = up;
    prev_forward = forward;
    prev_camera = vec4(camera.xyz, last_cam.w > 0.0 ? 1.0 : 0.0);
    if ((gen & 0xffu) == 0u) {
        gen += 1u;
    }
    // The exposure follows only what enough hits measured, and slowly, so
    // a frame with few hits on screen does not move it.
    if (lit_colour > 256u * 512u) {
        float ratio = clamp(float(lit_screen) / float(lit_colour), 0.1, 2.0);
        exposure = exposure > 0.0 ? mix(exposure, ratio, 0.02) : ratio;
    }
    lit_screen = 0u;
    lit_colour = 0u;
    if (sky_n > 64u) {
        vec3 now = vec3(sky_r, sky_g, sky_b) / (256.0 * float(sky_n));
        sky = vec4(sky.w > 0.0 ? mix(sky.rgb, now, 0.05) : now, 1.0);
    }
    sky_r = 0u;
    sky_g = 0u;
    sky_b = 0u;
    sky_n = 0u;
    float n = red[16][0];
    fit_samples = uint(n);
    fit_ok = 0u;
    // Counted as failed until it succeeds below.
    fit_failures += 1u;
    if (n < 64.0) {
        return;
    }
    mat3 A = mat3(red[0][0], red[1][0], red[2][0],
                  red[1][0], red[3][0], red[4][0],
                  red[2][0], red[4][0], red[5][0]);
    if (abs(determinant(A)) < 1e-6 * n * n * n) {
        return;
    }
    mat3 inv = inverse(A);
    vec3 mx = inv * vec3(red[6][0], red[7][0], red[8][0]);
    vec3 my = inv * vec3(red[9][0], red[10][0], red[11][0]);
    vec3 mw = inv * vec3(red[12][0], red[13][0], red[14][0]);
    float lw = length(mw);
    vec2 tan_xy = vec2(lw / length(mx), lw / length(my));
    float near = red[15][0] / n;
    vec3 cam = vec3(red[17][0], red[18][0], red[19][0]) / n;
    if (any(isnan(vec4(tan_xy, near, lw))) || any(lessThan(tan_xy, vec2(0.02))) || any(greaterThan(tan_xy, vec2(50.0)))
        || !(near > 0.0) || abs(lw - 1.0) > 0.05 || any(isnan(cam)) || any(isinf(cam))) {
        return;
    }
    // The camera's axes in the world: right, up (clip y is flipped), forward.
    vec3 r = mx / length(mx), u = -my / length(my), f = mw / lw;
    camera = vec4(tan_xy, near, lw);
    world_up = vec4(normalize(vec3(r.y, u.y, f.y)), 0.0);
    cam_pos = vec4(cam, 1.0);
    right = vec4(r, 0.0);
    up = vec4(u, 0.0);
    forward = vec4(f, 0.0);
    if (last_cam.w > 0.0 && distance(last_cam.xyz, cam) > JUMP) {
        gen += 1u;
        if ((gen & 0xffu) == 0u) {
            gen += 1u;
        }
    }
    last_cam = vec4(cam, 1.0);
    fit_ok = 1u;
    fit_failures -= 1u;
}

#endif

#ifdef INSERT

uint mix_bits(uint h, uint v) {
    h ^= v * 0xcc9e2d51u;
    h = (h << 13) | (h >> 19);
    return h * 5u + 0xe6546b64u;
}

// The draw triangle `i` came from: the last entry starting at or before it.
uvec4 draw_of(uint i) {
    if (pc.draw_count == 0u || draws[0].x > i) {
        return uvec4(0u);
    }
    uint lo = 0u, hi = pc.draw_count - 1u;
    while (lo < hi) {
        uint mid = (lo + hi + 1u) / 2u;
        if (draws[mid].x <= i) {
            lo = mid;
        } else {
            hi = mid - 1u;
        }
    }
    return draws[lo];
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.current || i >= pc.cap) {
        return;
    }
    vec4 W[3];
    uint col[3];
    vec2 uv[3];
    uint nrm[3];
    bool fixed_ = true, normals = true;
    for (uint k = 0u; k < 3u; ++k) {
        uint v = VERTEX_VEC4 * (3u * i + k);
        W[k] = xfb[v + 3u];
        col[k] = pack_colour(xfb[v + 1u]);
        uv[k] = xfb[v + 4u].xy;
        vec3 n = xfb[v + 5u].xyz;
        normals = normals && W[k].w >= 1.5 && dot(n, n) > 1e-8 && !any(isnan(n));
        nrm[k] = normals ? packSnorm4x8(vec4(normalize(n), 0.0)) : 0u;
        fixed_ = fixed_ && mod(W[k].w, 2.0) > 0.5 && usable(xfb[v]);
        tris[TRI_VEC4 * i + k] = vec4(W[k].xyz, uintBitsToFloat(col[k]));
    }
    uvec4 d = draw_of(i);
    // A blending draw's triangle counts only where its colour says it is
    // opaque: the engine's nearly invisible parts (zone markers, barriers)
    // are drawn so too. One that is not is folded to a point, which the
    // hierarchy leaves out, and kept out of the cache.
    float alpha = min(xfb[VERTEX_VEC4 * 3u * i + 1u].a, min(xfb[VERTEX_VEC4 * (3u * i + 1u) + 1u].a, xfb[VERTEX_VEC4 * (3u * i + 2u) + 1u].a));
    if (d.w != 0u && !(alpha >= 0.95)) {
        for (uint k = 0u; k < 3u; ++k) {
            tris[TRI_VEC4 * i + k] = vec4(W[0].xyz, uintBitsToFloat(col[k]));
        }
        fixed_ = false;
    }
    tris[TRI_VEC4 * i + 3u] = vec4(uv[0], uv[1]);
    tris[TRI_VEC4 * i + 4u] = vec4(uv[2], uintBitsToFloat(d.y), uintBitsToFloat(d.z));
    tris[TRI_VEC4 * i + 5u] = uintBitsToFloat(uvec4(nrm[0], nrm[1], nrm[2], normals ? 1u : 0u));
    if (!fixed_ || fit_ok == 0u) {
        return;
    }
    // Two hashes of the nine coordinates, to a sixteenth of a stud: a part
    // that sways by a hair (a breath of an animation) stays one entry.
    uint h1 = 0x9747b28cu, h2 = 0x85ebca6bu;
    for (uint k = 0u; k < 3u; ++k) {
        uvec3 b = uvec3(ivec3(round(W[k].xyz * 16.0)));
        h1 = mix_bits(mix_bits(mix_bits(h1, b.x), b.y), b.z);
        h2 = mix_bits(mix_bits(mix_bits(h2, b.z), b.x), b.y);
    }
    h1 ^= h1 >> 16;
    h1 *= 0x85ebca6bu;
    h1 ^= h1 >> 13;
    uint tag = ((gen & 0xffu) << 24) | max(h1 & 0xffffffu, 1u);
    uint mask = pc.slot_count - 1u;
    // The whole probe window is searched for the triangle first: a slot
    // before it may have been freed since it was put in, and taking that
    // one would cache it twice.
    uint free_at = 0xffffffffu, old_at = 0xffffffffu, old_seen = 0xffffffffu;
    for (uint p = 0u; p < PROBES; ++p) {
        uint base = ((h2 + p) & mask) * SLOT_WORDS;
        uint t = slots[base + S_TAG];
        if (t == tag && slots[base + S_KEY] == h2) {
            uint streak = slots[base + S_SEEN] + 1u == frame ? min(slots[base + S_STREAK] + 1u, 65535u) : 1u;
            slots[base + S_STREAK] = streak;
            if (streak >= STABLE) {
                slots[base + S_PROMOTED] = 1u;
            }
            slots[base + S_SEEN] = frame;
            slots[base + S_MISSES] = 0u;
            slots[base + S_HIDDEN] = 0u;
            slots[base + S_CODE] = d.y;
            // Its slot, beside the normals flag, for the light it gives off.
            tris[TRI_VEC4 * i + 5u].w = uintBitsToFloat((normals ? 1u : 0u) | ((base / SLOT_WORDS + 1u) << 1));
            for (uint k = 0u; k < 3u; ++k) {
                slots[base + S_COL + k] = col[k];
                slots[base + S_NRM + k] = nrm[k];
                uvec3 b = floatBitsToUint(W[k].xyz);
                slots[base + S_POS + 3u * k] = b.x;
                slots[base + S_POS + 3u * k + 1u] = b.y;
                slots[base + S_POS + 3u * k + 2u] = b.z;
            }
            return;
        }
        if (t == 0u || (t >> 24) != (gen & 0xffu)) {
            free_at = min(free_at, p);
        } else {
            uint seen = slots[base + S_SEEN];
            if (frame - seen > MIN_AGE && seen < old_seen) {
                old_seen = seen;
                old_at = p;
            }
        }
    }
    // A free slot, else the least recently seen of those probed.
    uint best = 0xffffffffu;
    for (uint p = 0u; p < PROBES && best == 0xffffffffu; ++p) {
        if (p != free_at && p != old_at) {
            continue;
        }
        uint base = ((h2 + p) & mask) * SLOT_WORDS;
        uint t = slots[base + S_TAG];
        bool takeable = t == 0u || (t >> 24) != (gen & 0xffu) || frame - slots[base + S_SEEN] > MIN_AGE;
        if (takeable && atomicCompSwap(slots[base + S_TAG], t, tag) == t) {
            best = base;
        }
    }
    if (best == 0xffffffffu) {
        atomicAdd(full, 1u);
        return;
    }
    atomicAdd(inserted, 1u);
    slots[best + S_KEY] = h2;
    slots[best + S_SEEN] = frame;
    slots[best + S_MISSES] = 0u;
    slots[best + S_CODE] = d.y;
    slots[best + S_SOURCE] = d.z;
    slots[best + S_BORN] = frame;
    slots[best + S_STREAK] = 1u;
    slots[best + S_PROMOTED] = 0u;
    slots[best + S_HIDDEN] = 0u;
    slots[best + S_EMIT] = 0u;
    tris[TRI_VEC4 * i + 5u].w = uintBitsToFloat((normals ? 1u : 0u) | ((best / SLOT_WORDS + 1u) << 1));
    for (uint k = 0u; k < 3u; ++k) {
        uvec3 b = floatBitsToUint(W[k].xyz);
        slots[best + S_POS + 3u * k] = b.x;
        slots[best + S_POS + 3u * k + 1u] = b.y;
        slots[best + S_POS + 3u * k + 2u] = b.z;
        slots[best + S_COL + k] = col[k];
        slots[best + S_NRM + k] = nrm[k];
        uvec2 u = floatBitsToUint(uv[k]);
        slots[best + S_UV + 2u * k] = u.x;
        slots[best + S_UV + 2u * k + 1u] = u.y;
    }
}

#endif

#ifdef GATHER

vec3 view_of(vec3 w) {
    vec3 r = w - cam_pos.xyz;
    return vec3(dot(r, right.xyz), dot(r, up.xyz), dot(r, forward.xyz));
}

// Whether a view-space point lies inside the frustum, a little in from its
// edges, past the near plane.
bool inside(vec3 v) {
    return v.z > 2.0 * camera.z && abs(v.x) < 0.97 * v.z * camera.x && abs(v.y) < 0.97 * v.z * camera.y;
}

// Whether the screen shows the place of the triangle whose centre is `v`:
// nothing drawn in front of it there (the depth there is sky or behind it).
// Hidden behind something, it is kept.
bool place_shown(vec3 v) {
    uvec2 size = uvec2(pc.size & 0xffffu, pc.size >> 16);
    vec2 ndc = vec2(v.x / (v.z * camera.x), -v.y / (v.z * camera.y));
    ivec2 p = ivec2((ndc * 0.5 + 0.5) * vec2(size));
    if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, ivec2(size)))) {
        return false;
    }
    float d = imageLoad(depth_copy, p).r;
    // Depth is near / distance; the triangle's distance in near units.
    float z = v.z / camera.z;
    return d <= 0.0 || 1.0 / d > z * 1.02;
}

void main() {
    uint s = gl_GlobalInvocationID.x;
    if (s >= pc.slot_count || fit_ok == 0u) {
        return;
    }
    uint base = s * SLOT_WORDS;
    uint t = slots[base + S_TAG];
    if (t == 0u || (t >> 24) != (gen & 0xffu)) {
        return;
    }
    uint seen = slots[base + S_SEEN];
    if (seen == frame) {
        return;
    }
    vec3 W[3];
    for (uint k = 0u; k < 3u; ++k) {
        W[k] = uintBitsToFloat(uvec3(slots[base + S_POS + 3u * k], slots[base + S_POS + 3u * k + 1u], slots[base + S_POS + 3u * k + 2u]));
    }
    vec3 a = view_of(W[0]), b = view_of(W[1]), c = view_of(W[2]);
    float distance_ = length((a + b + c) / 3.0);
    float reach = uintBitsToFloat(pc.reach_bits);
    if (distance_ > 2.0 * reach || (frame - seen > MAX_AGE && distance_ > FAR)) {
        slots[base + S_TAG] = 0u;
        return;
    }
    // Gone: in view while the frame (captured whole) did not draw it, for
    // several frames in a row where its place shows empty, for a second
    // where something is drawn in front of it.
    if (inside(a) && inside(b) && inside(c) && (pc.flags_ & 1u) != 0u) {
        bool empty = place_shown((a + b + c) / 3.0);
        uint at = empty ? S_MISSES : S_HIDDEN;
        uint n = slots[base + at] + 1u;
        slots[base + at] = n;
        if (n >= (empty ? MISSES : HIDDEN_FRAMES)) {
            slots[base + S_TAG] = 0u;
            atomicAdd(dropped, 1u);
            return;
        }
    } else {
        slots[base + S_MISSES] = 0u;
        slots[base + S_HIDDEN] = 0u;
    }
    if (slots[base + S_PROMOTED] == 0u || distance_ > reach) {
        return;
    }
    uint k = atomicAdd(cached, 1u);
    uint at = pc.current + k;
    if (at >= pc.cap) {
        return;
    }
    for (uint q = 0u; q < 3u; ++q) {
        tris[TRI_VEC4 * at + q] = vec4(W[q], uintBitsToFloat(slots[base + S_COL + q]));
    }
    vec2 u0 = uintBitsToFloat(uvec2(slots[base + S_UV], slots[base + S_UV + 1u]));
    vec2 u1 = uintBitsToFloat(uvec2(slots[base + S_UV + 2u], slots[base + S_UV + 3u]));
    vec2 u2 = uintBitsToFloat(uvec2(slots[base + S_UV + 4u], slots[base + S_UV + 5u]));
    tris[TRI_VEC4 * at + 3u] = vec4(u0, u1);
    tris[TRI_VEC4 * at + 4u] = vec4(u2, uintBitsToFloat(slots[base + S_CODE]), uintBitsToFloat(slots[base + S_SOURCE]));
    uint nA = slots[base + S_NRM], nB = slots[base + S_NRM + 1u], nC = slots[base + S_NRM + 2u];
    tris[TRI_VEC4 * at + 5u] = uintBitsToFloat(uvec4(nA, nB, nC, ((nA | nB | nC) != 0u ? 1u : 0u) | ((base / SLOT_WORDS + 1u) << 1)));
}

#endif

#ifdef PREP

uint spread(uint v) {
    v = (v | (v << 16)) & 0x030000FFu;
    v = (v | (v << 8)) & 0x0300F00Fu;
    v = (v | (v << 4)) & 0x030C30C3u;
    v = (v | (v << 2)) & 0x09249249u;
    return v;
}

// A logarithmic warp around the camera before quantising: fine near it,
// coarse far away, so the character and what is near it are sorted finely
// whatever else the scene holds.
uint cell(float x) {
    float f = sign(x) * log2(1.0 + abs(x));
    return uint(clamp((f + 24.0) / 48.0 * 1024.0, 0.0, 1023.0));
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) {
        return;
    }
    uint listed = min(pc.current + cached, pc.cap);
    uint total = min(listed, pc.n);
    if (i == 0u) {
        cut = listed - total;
    }
    uint key = 0xffffffffu;
    if (i < total && fit_ok != 0u) {
        vec3 A = tris[TRI_VEC4 * i].xyz, B = tris[TRI_VEC4 * i + 1u].xyz, C = tris[TRI_VEC4 * i + 2u].xyz;
        vec3 n = cross(B - A, C - A);
        if (dot(n, n) > 0.0 && !any(isinf(n)) && !any(isnan(n))) {
            vec3 m = (A + B + C) / 3.0 - cam_pos.xyz;
            key = (spread(cell(m.x)) << 2) | (spread(cell(m.y)) << 1) | spread(cell(m.z));
            atomicAdd(leaves, 1u);
        }
    }
    sorted[i] = uvec2(key, i);
}

#endif

#if defined(SORT_LOCAL) || defined(SORT_GLOBAL)

bool after(uvec2 a, uvec2 b) {
    return a.x > b.x || (a.x == b.x && a.y > b.y);
}

#endif

#ifdef SORT_LOCAL

shared uvec2 block[1024];

void step_(uint base, uint k, uint j) {
    uint t = gl_LocalInvocationID.x;
    uint i = 2u * j * (t / j) + (t % j);
    uint l = i + j;
    bool up = ((base + i) & k) == 0u;
    uvec2 a = block[i], b = block[l];
    if (after(a, b) == up) {
        block[i] = b;
        block[l] = a;
    }
    memoryBarrierShared();
    barrier();
}

void main() {
    uint base = gl_WorkGroupID.x * 1024u;
    uint t = gl_LocalInvocationID.x;
    block[t] = sorted[base + t];
    block[t + 512u] = sorted[base + t + 512u];
    memoryBarrierShared();
    barrier();
    if (pc.k == 0u) {
        for (uint k = 2u; k <= 1024u; k <<= 1) {
            for (uint j = k >> 1; j > 0u; j >>= 1) {
                step_(base, k, j);
            }
        }
    } else {
        for (uint j = 512u; j > 0u; j >>= 1) {
            step_(base, pc.k, j);
        }
    }
    sorted[base + t] = block[t];
    sorted[base + t + 512u] = block[t + 512u];
}

#endif

#ifdef SORT_GLOBAL

void main() {
    uint t = gl_GlobalInvocationID.x;
    if (t >= pc.n / 2u) {
        return;
    }
    uint i = 2u * pc.j * (t / pc.j) + (t % pc.j);
    uint l = i + pc.j;
    bool up = (i & pc.k) == 0u;
    uvec2 a = sorted[i], b = sorted[l];
    if (after(a, b) == up) {
        sorted[i] = b;
        sorted[l] = a;
    }
}

#endif

#ifdef BUILD

int m;

// The length of the common prefix of keys i and j, the index breaking ties;
// -1 outside the leaves.
int delta(int i, int j) {
    if (j < 0 || j >= m) {
        return -1;
    }
    uint a = sorted[i].x, b = sorted[j].x;
    if (a == b) {
        return 32 + (31 - findMSB(uint(i ^ j)));
    }
    return 31 - findMSB(a ^ b);
}

void main() {
    m = int(leaves);
    int i = int(gl_GlobalInvocationID.x);
    if (i >= m - 1) {
        return;
    }
    int d = delta(i, i + 1) - delta(i, i - 1) >= 0 ? 1 : -1;
    int dmin = delta(i, i - d);
    int lmax = 2;
    while (delta(i, i + lmax * d) > dmin) {
        lmax <<= 1;
    }
    int l = 0;
    for (int t = lmax >> 1; t >= 1; t >>= 1) {
        if (delta(i, i + (l + t) * d) > dmin) {
            l += t;
        }
    }
    int j = i + l * d;
    int dnode = delta(i, j);
    int s = 0;
    int t = l;
    do {
        t = (t + 1) >> 1;
        if (delta(i, i + (s + t) * d) > dnode) {
            s += t;
        }
    } while (t > 1);
    int gamma = i + s * d + min(d, 0);
    // A leaf is ~its index, a node its index.
    int left = min(i, j) == gamma ? ~gamma : gamma;
    int right = max(i, j) == gamma + 1 ? ~(gamma + 1) : gamma + 1;
    nodes[4 * i].w = intBitsToFloat(left);
    nodes[4 * i + 2].w = intBitsToFloat(right);
    if (left < 0) {
        parents[int(pc.n) + ~left] = i;
    } else {
        parents[left] = i;
    }
    if (right < 0) {
        parents[int(pc.n) + ~right] = i;
    } else {
        parents[right] = i;
    }
    if (i == 0) {
        parents[0] = -1;
    }
}

#endif

#ifdef BOUNDS

void main() {
    int m = int(leaves);
    int leaf = int(gl_GlobalInvocationID.x);
    if (leaf >= m || m < 2) {
        return;
    }
    uint tri = sorted[leaf].y;
    vec3 A = tris[TRI_VEC4 * tri].xyz, B = tris[TRI_VEC4 * tri + 1u].xyz, C = tris[TRI_VEC4 * tri + 2u].xyz;
    vec3 lo = min(A, min(B, C)), hi = max(A, max(B, C));
    int child = ~leaf;
    int p = parents[int(pc.n) + leaf];
    for (int guard = 0; guard < 128 && p >= 0; ++guard) {
        bool is_left = floatBitsToInt(nodes[4 * p].w) == child;
        int at = 4 * p + (is_left ? 0 : 2);
        nodes[at].xyz = lo;
        nodes[at + 1].xyz = hi;
        memoryBarrierBuffer();
        if (atomicAdd(flags[p], 1u) == 0u) {
            return;
        }
        memoryBarrierBuffer();
        lo = min(nodes[4 * p].xyz, nodes[4 * p + 2].xyz);
        hi = max(nodes[4 * p + 1].xyz, nodes[4 * p + 3].xyz);
        child = p;
        p = parents[p];
    }
}

#endif
